":"elife","name":"eLife","url":"https://elifesciences.org/rss/recent.xml","cats":["bio"]},{"id":"plosbio","name":"PLOS Biology","url":"https://journals.plos.org/plosbiology/feed/atom","cats":["bio"]},{"id":"who","name":"WHO news","url":"https://www.who.int/rss-feeds/news-english.xml","cats":["health"],"rec":true},{"id":"stat","name":"STAT News","url":"https://www.statnews.com/feed/","cats":["health"]},{"id":"quakes","name":"USGS big quakes","url":"https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_week.atom","cats":["alerts"],"rec":true},{"id":"quakes45","name":"USGS M4.5+ today","url":"https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.atom","cats":["alerts"]},{"id":"gdacs","name":"GDACS disasters","url":"https://www.gdacs.org/xml/rss.xml","cats":["alerts"],"rec":true},{"id":"reliefweb","name":"ReliefWeb","url":"https://reliefweb.int/updates/rss.xml","cats":["alerts"]},{"id":"lpn","name":"LowPingNews","url":"https://github.com/ATinyGreenCell/LowPingNews/releases.atom","cats":["app"],"ttl":86400,"rec":true,"ok":"2026-10","raw":6.2,"val":true,"kb":6.2,"gz":false}]}'


def catalog_builtin():
    """What is known with no network at all: the index shipped in the code."""
    try:
        idx = catalog_validate(json.loads(CATALOG_SEED))
        known = {e["id"] for e in idx["feeds"]}
        idx["feeds"] += [e for e in (catalog_entry(d) for d in DEFAULTS)
                         if e and e["id"] not in known]
        idx["updated"] = "built-in"
        return idx
    except (ValueError, TypeError):
        return {"feeds": [catalog_entry(d) for d in DEFAULTS if catalog_entry(d)],
                "cats": {}, "updated": "built-in"}


def catalog_load():
    """The fetched index if there is one; the built-in one otherwise.

    A fetched index is authoritative: a feed it no longer lists (pruned after
    failing its checks) must not keep being offered from the built-in copy.
    Only the defaults are merged into it, so what ships subscribed stays
    visible and can be unticked."""
    got = jread(CATC, {})
    try:
        idx = catalog_validate(got)
    except ValueError:
        return catalog_builtin()
    known = {e["id"] for e in idx["feeds"]}
    idx["feeds"] += [e for e in (catalog_entry(d) for d in DEFAULTS)
                     if e and e["id"] not in known]
    idx["fetched"] = got.get("t")
    return idx


class ConfigError(Exception):
    pass


def subs_load():
    """sources.json for editing. Unlike sources(), which falls back to the
    defaults so the reader always works, this refuses a damaged file: writing
    the defaults over it would silently throw the user's feeds away."""
    if not os.path.exists(CFG):
        return [dict(d) for d in DEFAULTS]
    try:
        with open(CFG, encoding="utf-8") as fh:
            s = json.load(fh)
    except Exception as e:
        raise ConfigError("%s is unreadable (%s) - fix or move it; nothing changed"
                          % (CFG, str(e)[:40]))
    if not isinstance(s, list):
        raise ConfigError("%s is not a list of feeds - nothing changed" % CFG)
    return s


def subs_save(s):
    """Atomic, with the previous version kept as sources.json.bak."""
    os.makedirs(CFD, exist_ok=True)
    if os.path.exists(CFG):
        try:
            import shutil
            shutil.copyfile(CFG, CFG + ".bak")
        except OSError:
            pass
    jwrite(CFG, s)


def sub_find(s, fid=None, url=None):
    for i, x in enumerate(s):
        if not isinstance(x, dict):
            continue
        if fid and norm_id(x.get("id")) == fid:
            return i
        if url and same_url(x.get("url"), url):
            return i
    return -1


def subscribe(entry, cat=None):
    """Add a feed, or add a category to a feed already there. -> message."""
    s = subs_load()
    cat = norm_cat(cat) if cat else None
    i = sub_find(s, url=entry["url"])
    if i < 0:
        j = sub_find(s, fid=entry["id"])
        if j >= 0:                         # same id, different address
            return ("%s is already a feed here with a different address; "
                    "`catalog upgrade` takes the catalog's" % entry["id"])
        new = {k: v for k, v in entry.items()
               if k in ("id", "name", "url", "kind", "ttl", "timeout")}
        new["cats"] = [cat] if cat else list(entry["cats"])
        s.append(new)
        subs_save(s)
        return "added %s to %s" % (new["name"], ", ".join(new["cats"]))
    x = s[i]
    cats = [norm_cat(c) for c in (x.get("cats") or []) if norm_cat(c)]
    want = [cat] if cat else entry["cats"]
    add = [c for c in want if c not in cats]
    if not add:
        return "%s is already in %s" % (x.get("name") or x.get("id"), ", ".join(want))
    x["cats"] = cats + add
    subs_save(s)
    return "added %s to %s" % (x.get("name") or x.get("id"), ", ".join(add))


def unsubscribe(fid, cat=None):
    """Take a feed out of one category, or out entirely. The last feed cannot
    go: an empty list would silently bring the defaults back."""
    s = subs_load()
    i = sub_find(s, fid=norm_id(fid))
    if i < 0:
        return "no feed %r" % fid
    x = s[i]
    cats = [norm_cat(c) for c in (x.get("cats") or []) if norm_cat(c)]
    if cat and norm_cat(cat) in cats and len(cats) > 1:
        x["cats"] = [c for c in cats if c != norm_cat(cat)]
        subs_save(s)
        return "removed %s from %s" % (x.get("name") or fid, norm_cat(cat))
    if len([y for y in s if isinstance(y, dict)]) <= 1:
        return "that is the only feed left - add another first"
    del s[i]
    subs_save(s)
    return "removed %s" % (x.get("name") or fid)


FEEDSIG = re.compile(r"<(rss|feed|rdf:RDF)[\s>]", re.I)
ALTLINK = re.compile(r"<link\b[^>]*>", re.I)


def feed_links(txt):
    """hrefs a page advertises as its feeds, in page order. Any <link> is not
    enough: every page has stylesheets, and "alternate icon" is a favicon."""
    import html as _h
    out = []
    for tag in ALTLINK.findall(txt):
        low = tag.lower()
        rel = re.search(r"""rel\s*=\s*["']?([^"'>]+)""", low)
        if not rel or "alternate" not in rel.group(1).split():
            continue
        if "rss+xml" not in low and "atom+xml" not in low:
            continue
        href = re.search(r"""href\s*=\s*["']([^"']+)["']""", tag, re.I)
        if href:
            out.append(_h.unescape(href.group(1)))
    return out


def feed_url(raw):
    """-> (url, None) or (None, why). What a person types: "lwn.net/headlines",
    "https://x.org/feed", or something that cannot be a feed address at all."""
    import urllib.parse
    u = (raw or "").strip()
    if not u:
        return None, "no address given"
    m = re.match(r"(?i)([a-z][a-z0-9+.-]*):", u)
    if m and not re.match(r"(?i)https?://", u):
        if "." in m.group(1) or u[m.end():m.end() + 1].isdigit():
            pass                               # "example.org:8080/feed": no scheme
        else:
            return None, "only http and https feeds (not %s:)" % m.group(1).lower()
    if not re.match(r"(?i)https?://", u):
        u = "https://" + u
    try:
        p = urllib.parse.urlsplit(u)
        host, user, pw = p.hostname, p.username, p.password
    except ValueError:
        return None, "not a valid address"
    if not host:
        return None, "no host in that address"
    if user or pw:
        # sources.json is plain text: a password in a feed address would sit
        # there in the clear, and be shown in every listing
        return None, "addresses with a user name or password are not stored"
    if len(u) > 600:
        return None, "address too long"
    return u, None


def feed_link_title(txt, href):
    """The title= a page gave the <link> advertising href, or ""."""
    import html as _h
    for tag in ALTLINK.findall(txt):
        h_ = re.search(r"""href\s*=\s*["']([^"']+)["']""", tag, re.I)
        if h_ and _h.unescape(h_.group(1)) == href:
            t_ = re.search(r"""title\s*=\s*["']([^"']*)["']""", tag, re.I)
            return clean(_h.unescape(t_.group(1)), 40) if t_ else ""
    return ""


def probe_feed(url, discover=True):
    """Is this a feed? Learned from its first few KB, asked for by Range so a
    server that honours it sends no more. A web page is searched for the feed
    it advertises, so a site's address works as well as the feed's."""
    import urllib.error, urllib.parse
    r = {"url": url, "ok": False, "why": "", "raw": None, "gz": None, "val": None,
         "title": "", "ms": None, "final": url}
    u = safe_url(url)
    if not u:
        r["why"] = "not an http(s) address"
        return r
    t0 = time.time()
    try:
        body, h, _w, part = get(u, 15, extra={"Range": "bytes=0-8191"},
                                cap=PROBECAP, soft=True)
    except urllib.error.HTTPError as e:
        r["why"] = "HTTP %s" % e.code
        return r
    except OfflineError:
        r["why"] = "offline"
        return r
    except Exception as e:
        r["why"] = (str(e) or type(e).__name__)[:40]
        return r
    r["ms"] = int((time.time() - t0) * 1000)
    r["final"] = LAST_URL[0] or u
    if u.lower().startswith("https://") and r["final"].lower().startswith("http://"):
        r["why"] = "redirects to plain http"
        return r
    txt = body.decode("utf-8", "replace")
    m = re.match(r"bytes \d+-\d+/(\d+)", h.get("Content-Range") or "")
    if m:
        r["raw"] = round(int(m.group(1)) / 1024.0, 1)
    elif not part:
        r["raw"] = round(len(body) / 1024.0, 1)
    r["gz"] = "gzip" in (h.get("Content-Encoding") or "").lower() or None
    r["val"] = bool(h.get("ETag") or h.get("Last-Modified"))
    if FEEDSIG.search(txt[:4096]):
        # the feed's own title precedes its first item; a <title> after that is
        # an article's, and naming the feed after a headline is wrong
        head_ = re.split(r"<(?:item|entry)[\s>]", txt, maxsplit=1, flags=re.I)[0]
        t_ = re.search(r"<title[^>]*>(.*?)</title>", head_, re.S | re.I)
        if t_:
            import html as _h
            tt = re.sub(r"<!\[CDATA\[(.*?)\]\]>", r"\1", t_.group(1), flags=re.S)
            r["title"] = clean(_h.unescape(tt), 40)
        r["ok"] = True
        return r
    if discover and re.search(r"<html|<!doctype html", txt[:2048], re.I):
        if not re.search(r"</head>", txt, re.I) and not feed_links(txt):
            # big sites put tens of KB of scripts in <head>; the feed link is in
            # there somewhere. Read on, but only until the head ends.
            try:
                more, _h2, _w2, _p2 = get(r["final"], 15, extra={"Range": "bytes=0-98303"},
                                          cap=96 * 1024, soft=True,
                                          until=lambda b: b"</head>" in b or b"</HEAD>" in b)
                txt = more.decode("utf-8", "replace")
            except Exception:
                pass
        for href in feed_links(txt)[:2]:           # first is the main feed; one spare
            nxt = urllib.parse.urljoin(r["final"], href)
            found = probe_feed(nxt, discover=False)
            if found["ok"]:
                found["page"] = u
                if not found.get("title"):         # the page named it: use that
                    found["title"] = feed_link_title(txt, href)
                return found
        r["why"] = "a web page with no feed advertised"
        return r
    r["why"] = "not a feed" if txt.strip() else "empty response"
    return r


def new_feed_id(s, url, title=""):
    import urllib.parse
    host = (urllib.parse.urlsplit(url).hostname or "feed").lower()
    host = re.sub(r"^(www|feeds?|rss)\.", "", host)
    # a name you would type: "Weird Little Blog" -> weird-little-blog; the
    # host only when there is no title, and never a bare IP address
    slug = re.sub(r"[^a-z0-9]+", "-", (title or "").lower()).strip("-")[:16].strip("-")
    if not slug and not re.match(r"^[\d.]+$|^\[", host):
        slug = host.split(".")[0]
    base = norm_id(slug or "feed")[:16] or "feed"
    used = {norm_id(x.get("id")) for x in s if isinstance(x, dict)}
    cand, n = base, 2
    while cand in used:
        cand = "%s%d" % (base, n)
        n += 1
    return cand


def add_custom(url, name=None, cat=None, probe=None):
    """Subscribe to any feed by address (or a site that advertises one)."""
    p = probe or probe_feed(url)
    if not p["ok"]:
        return False, "not added: %s" % (p["why"] or "not a feed")
    s = subs_load()
    feed_url = p["final"]
    entry = {"id": new_feed_id(s, feed_url, name or p["title"]),
             "name": clean(name or p["title"] or "", 32),
             "url": feed_url, "cats": [norm_cat(cat) or "top"], "kind": "rss"}
    entry["name"] = entry["name"] or entry["id"]
    return True, subscribe(entry, entry["cats"][0])


def catalog_update():
    """apt update: fetch the index if it changed. -> (state, message)."""
    import urllib.error
    old = jread(CATC, {})
    extra = {}
    if old.get("et"):
        extra["If-None-Match"] = old["et"]
    elif old.get("lm"):
        extra["If-Modified-Since"] = old["lm"]
    try:
        raw, h, _w, part = get(CATALOG_URL, 20, extra=extra, cap=CATCAP)
    except urllib.error.HTTPError as e:
        if e.code == 304 and old:
            old["t"] = int(time.time())
            jwrite(CATC, old)
            return "same", "feed index unchanged since %s" % (old.get("updated") or "?")
        if e.code == 404:
            return "missing", "no feed index published at %s yet" % CATALOG_URL
        return "error", "feed index: HTTP %s - kept the one you had" % e.code
    except OfflineError:
        return "error", "offline - kept the index you had"
    except Exception as e:
        return "error", "feed index: %s - kept the one you had" % (str(e)[:40] or "failed")
    if part:
        return "error", "feed index arrived truncated - kept the one you had"
    try:
        idx = catalog_validate(json.loads(raw.decode("utf-8")))
    except (ValueError, UnicodeDecodeError) as e:
        return "error", "feed index rejected (%s) - kept the one you had" % str(e)[:40]
    before = {e_["id"]: e_ for e_ in (catalog_validate(old)["feeds"] if old.get("feeds") else [])}
    rec = dict(idx, t=int(time.time()))
    if h.get("ETag"):
        rec["et"] = h["ETag"]
    if h.get("Last-Modified"):
        rec["lm"] = h["Last-Modified"]
    jwrite(CATC, rec)
    new_ids = [e_["id"] for e_ in idx["feeds"] if e_["id"] not in before]
    gone = [i for i in before if i not in {e_["id"] for e_ in idx["feeds"]}]
    msg = "feed index %s: %d feeds" % (idx["updated"] or "?", len(idx["feeds"]))
    if before:
        msg += ", %d new, %d gone" % (len(new_ids), len(gone))
    moved = catalog_moved(idx)
    if moved:
        msg += "; %d of yours moved (catalog upgrade)" % len(moved)
    return "new", msg


def catalog_moved(idx=None):
    """Subscribed feeds whose catalog entry now has a different address."""
    idx = idx or catalog_load()
    by_id = {e["id"]: e for e in idx["feeds"]}
    try:
        s = subs_load()
    except ConfigError:
        return []
    out = []
    for x in s:
        if not isinstance(x, dict):
            continue
        e = by_id.get(norm_id(x.get("id")))
        if e and not same_url(e["url"], x.get("url")):
            out.append((x, e))
    return out


def catalog_check(entries, out=print, budget=None):
    """Probe each feed, in order, so feeds on one host share a TLS session.
    -> {id: result}. Stops before a probe it cannot afford."""
    res = {}
    for e in entries:
        if budget is not None and NETSTAT["est"] + predict(8192, e["url"]) > budget:
            out("  stopped: budget of %s reached" % kbs(budget))
            break
        if e.get("kind", "rss") != "rss":
            p = {"ok": None, "why": "API feed, checked by reading it", "raw": None,
                 "val": None, "gz": None, "ms": None, "title": ""}
        else:
            p = probe_feed(e["url"], discover=False)
        res[e["id"]] = p
        out(p, e)
    return res


def catalog_dump(obj):
    """The index as a file: one feed per line, so a diff shows what changed."""
    head = {k: obj[k] for k in obj if k != "feeds"}
    lines = ['{' + ", ".join("%s: %s" % (json.dumps(k), json.dumps(v, ensure_ascii=False))
                             for k, v in head.items()) + ',', ' "feeds": [']
    fs = obj.get("feeds") or []
    for n, f_ in enumerate(fs):
        lines.append("  " + json.dumps(f_, ensure_ascii=False) + ("," if n < len(fs) - 1 else ""))
    lines.append(" ]}")
    return "\n".join(lines) + "\n"


def utf_out():
    """Can stdout carry non-ASCII? LANG=C and some pipes cannot."""
    enc = (getattr(sys.stdout, "encoding", None) or "ascii").lower()
    return "utf" in enc


def clip(t, cols):
    """Cut a line to `cols` visible characters. Colour codes take no room and
    are kept whole, so a clipped line never leaves the terminal coloured."""
    out, n, i, opened = [], 0, 0, False
    while i < len(t):
        if t[i] == "\033":
            m = re.match(r"\033\[[0-9;]*m", t[i:])
            if m:
                out.append(m.group(0))
                opened = m.group(0) != "\033[0m"
                i += len(m.group(0))
                continue
        if n >= cols - 1:
            break
        out.append(t[i])
        n += 1
        i += 1
    s_ = "".join(out)
    return s_ + ("\033[0m" if opened and not s_.endswith("\033[0m") else "")


def cmd_catalog(argv):
    """lowpingnews catalog [update|list|add|remove|upgrade|check] ..."""
    try:
        return _cmd_catalog(argv)
    except ConfigError as e:
        # a damaged sources.json is reported, never overwritten, never a traceback
        sys.exit("news: %s" % e)


def _cmd_catalog(argv):
    import urllib.parse
    on = sys.stdout.isatty() and not os.environ.get("NO_COLOR") and "--no-color" not in argv
    P = pal(on)
    D = P["d"]
    asc = not utf_out() or "--ascii" in argv
    STAR, DOT = ("*", "-") if asc else ("\u2605", "\u00b7")
    nsa = argparse_ns({"ascii": asc})
    if "--offline" in argv:
        OFFLINE[0] = True
    plain = "--plain" in argv
    opts, pos, it = {}, [], iter([x for x in argv if x not in ("--no-color", "--offline",
                                                               "--ascii", "--plain")])
    for x in it:
        if x in ("--to", "--from", "--name", "--write", "--budget"):
            opts[x[2:]] = next(it, "")
        elif x in ("--yes", "-y"):
            opts["yes"] = True
        elif x.startswith("--"):
            sys.exit("news: unknown option %s (see: lowpingnews catalog help)" % x)
        else:
            pos.append(x)
    VERBS = ("update", "list", "add", "remove", "upgrade", "check", "export", "help",
             "-h", "--help")
    verb = pos[0] if pos else "list"
    args = pos[1:]
    if verb not in VERBS:                   # `catalog alerts` lists a category
        verb, args = "list", pos
    if verb == "export":                   # the shipped index, as catalog.json
        seed = json.loads(CATALOG_SEED)
        sys.stdout.write(catalog_dump(seed))
        return
    if verb == "list" and not plain:
        # at a terminal, the list is something you edit: tick boxes, not text
        na = argparse_ns({"ascii": asc, "color": on})
        jump = norm_cat(args[0]) if args else None
        if cmd_feeds_tui(na, jump=jump):
            return
    idx = catalog_load()
    by_id = {e["id"]: e for e in idx["feeds"]}

    def subs():
        try:
            return subs_load()
        except ConfigError as e:
            sys.exit("news: %s" % e)

    def mine():
        out = {}
        for x in subs():
            if isinstance(x, dict):
                out[norm_id(x.get("id"))] = x
        return out

    def size_of(e):
        if e.get("kb") is not None:
            return "~%sK" % ("%g" % e["kb"])
        if e.get("raw") is not None:
            return "<%sK" % ("%g" % e["raw"])
        return "  ?"

    def mark(e, room=999):
        """Status note cut to the room left on the line, then coloured."""
        if room < 6:
            return ""
        if e.get("fail"):
            return P["red"](("failed: " + e["fail"])[:room])
        if not e.get("ok"):
            return D("unverified"[:room])
        return ""

    if verb in ("help", "-h", "--help"):
        print(__doc_catalog__)
        return
    if verb == "update":
        state_, msg = catalog_update()
        col = {"new": P["grn"], "same": D}.get(state_, P["yel"])
        print("  " + col(msg) + D("  %s %s" % (bul_(nsa), spent())))
        return
    if verb == "list":
        cats = list(idx["cats"]) or []
        have = mine()
        for e in idx["feeds"]:
            for c in e["cats"]:
                if c not in cats:
                    cats.append(c)
        for x in have.values():
            for c in x.get("cats") or []:
                c = norm_cat(c)
                if c and c not in cats:
                    cats.append(c)
        want = [norm_cat(a_) for a_ in args] or cats
        missing = [w_ for w_ in want if w_ not in cats]
        if args and (missing or not any(w_ for w_ in want)):
            sys.exit("news: no category %r. try: %s" % (
                (missing or args)[0], ", ".join(cats)))
        src = idx.get("updated") or "?"
        cols = cols_()
        pr = lambda t="": print(clip(t, cols))
        pr(P["hdr"]("FEEDS") + D("  %d available%s" % (
            len(idx["feeds"]), "" if src == "built-in" else ", index " + src)))
        note_ = catalog_age_note(idx)          # own line: a narrow screen keeps it
        pr((P["yel"] if "update" in note_ or "unknown" in note_ else D)("  " + note_))
        for c in cats:
            if c not in want:
                continue
            label = idx["cats"].get(c, "your category" if c not in
                                   {z for e in idx["feeds"] for z in e["cats"]} else c)
            pr("\n" + P["cyn"]("%s" % c) + D("  %s" % label))
            shown = set()
            rows = [e for e in idx["feeds"] if c in e["cats"]]
            rows.sort(key=lambda e: (not starred(e), e.get("kb") or e.get("raw") or 999))
            for x in have.values():                   # custom feeds in this category
                if c in [norm_cat(z) for z in x.get("cats") or []] and \
                        not any(same_url(x.get("url"), e["url"]) for e in rows):
                    rows.append({"id": norm_id(x.get("id")), "name": x.get("name") or "?",
                                 "url": x.get("url") or "", "cats": [c], "custom": True})
            for e in rows:
                if e["id"] in shown:
                    continue
                shown.add(e["id"])
                x = have.get(e["id"])
                on_ = bool(x) and c in [norm_cat(z) for z in x.get("cats") or []]
                if not on_:
                    on_ = any(same_url(y.get("url"), e["url"]) and
                              c in [norm_cat(z) for z in y.get("cats") or []] for y in have.values())
                host = (urllib.parse.urlsplit(e["url"]).hostname or "").replace("www.", "")
                box = P["grn"]("[x]") if on_ else "[ ]"
                star = P["yel"](STAR) if starred(e) else " "
                if cols >= 72:
                    pr("  %s %-9s %-17s %6s %s %-22s %s" % (
                        box, e["id"][:9], e["name"][:17], size_of(e), star, host[:22],
                        mark(e, cols - 67)))
                else:
                    # two lines on a phone: where a feed points is never the part cut
                    pr("  %s %-*s %6s %s" % (box, max(8, cols - 16), e["name"][:max(8, cols - 16)],
                                                size_of(e), star))
                    tail = ("%s  %s" % (e["id"], host))[:max(10, cols - 8)]
                    m_ = mark(e, cols - 9 - len(tail))
                    pr(D("      " + tail) + (("  " + m_) if m_ else ""))
        pr()
        wrapout("tick boxes: run `lowpingnews catalog` in a terminal, or press f in "
                "the reader. add: catalog add ID [--to CATEGORY]  remove: catalog "
                "remove ID  newest list: catalog update  " + STAR +
                " checked light and reliable", P, cols)
        return
    if verb == "add":
        if not args:
            sys.exit("news: catalog add ID-or-URL [--to CATEGORY] [--name NAME]")
        to = opts.get("to")
        if to is not None and not norm_cat(to):
            sys.exit("news: %r cannot be a category name" % to)
        failed = 0
        for a_ in args:
            e = by_id.get(norm_id(a_))
            if e and not re.search(r"[:/.]", a_):
                before = json.dumps(subs(), sort_keys=True)
                print("  " + subscribe(e, to))
                failed += json.dumps(subs(), sort_keys=True) == before
                continue
            if re.search(r"[:/.]", a_):        # an address, not a catalog id
                url, why = feed_url(a_)
                if why:
                    print("  " + P["red"]("not added: " + why))
                    failed += 1
                    continue
                print(D("  looking at %s ..." % url))
                p = probe_feed(url)
                ok, msg = add_custom(url, opts.get("name"), to, probe=p)
                where = (" (found via %s)" % p["page"]) if p.get("page") else ""
                print("  " + (P["grn"] if ok else P["red"])(msg) + D(where))
                print(D("  " + ("checked for %s" % spent() if NETSTAT["est"]
                                else "nothing was fetched")))
                failed += not ok
                continue
            print("  " + P["red"]("no catalog feed %r - `lowpingnews catalog` lists them" % a_))
            failed += 1
        if failed:
            sys.exit(1)                        # scripts can tell it did not happen
        return
    if verb == "remove":
        if not args:
            sys.exit("news: catalog remove ID [--from CATEGORY]")
        failed = 0
        for a_ in args:
            before = json.dumps(subs(), sort_keys=True)
            print("  " + unsubscribe(a_, opts.get("from")))
            failed += json.dumps(subs(), sort_keys=True) == before
        if failed:
            sys.exit(1)
        return
    if verb == "upgrade":
        moved = catalog_moved(idx)
        if not moved:
            print("  nothing to upgrade")
            return
        s = subs()
        for x, e in moved:
            i = sub_find(s, fid=norm_id(x.get("id")))
            if i >= 0:
                print("  %s: %s -> %s" % (x.get("id"), x.get("url"), e["url"]))
                s[i]["url"] = e["url"]
        subs_save(s)
        return
    if verb == "check":
        scope = args[0].lower() if args else "subscribed"
        have = mine()
        if scope == "all":
            todo = list(idx["feeds"])
        elif scope == "subscribed":
            todo = [by_id.get(i) or {"id": i, "name": x.get("name") or i, "url": x.get("url"),
                                     "kind": x.get("kind") or "rss", "cats": x.get("cats") or []}
                    for i, x in have.items()]
        else:
            c = norm_cat(scope)
            todo = [e for e in idx["feeds"] if c in e["cats"]] + [
                {"id": i, "name": x.get("name") or i, "url": x.get("url"), "kind": "rss",
                 "cats": [c]} for i, x in have.items()
                if c in [norm_cat(z) for z in x.get("cats") or []] and i not in by_id]
            if not todo:
                sys.exit("news: nothing in %r to check" % scope)
        todo = [e for e in todo if e and e.get("url")]
        est = sum(predict(8192, e["url"]) for e in todo if e.get("kind", "rss") == "rss")
        budget = None
        if opts.get("budget"):
            try:
                budget = max(1, int(opts["budget"])) * 1024
            except ValueError:
                sys.exit("news: --budget takes kilobytes")
        print(P["hdr"]("CHECK") + D("  %d feed%s, up to ~%s"
                                    % (len(todo), "" if len(todo) == 1 else "s", kbs(est))))
        if est > 200 * 1024 and not opts.get("yes") and budget is None:
            sys.exit("news: that is a lot of data - add --yes to go ahead, "
                     "or --budget KB to cap it")
        stats = {"ok": 0, "bad": 0, "skip": 0}

        def show(p, e):
            if p["ok"] is None:
                stats["skip"] += 1
                print("  %s %-9s %s" % (D("--"), e["id"][:9], D(p["why"])))
                return
            if p["ok"]:
                stats["ok"] += 1
                bits = ["%dms" % p["ms"] if p["ms"] is not None else "",
                        ("%sK" % ("%g" % p["raw"])) if p["raw"] is not None else "size ?",
                        "cheap refresh" if p["val"] else "no validators",
                        ("moved" if not same_url(p["final"], e["url"]) else "")]
                print("  %s %-9s %s" % (P["grn"]("ok"), e["id"][:9],
                                        D("  ".join(b for b in bits if b))))
            else:
                stats["bad"] += 1
                print("  %s %-9s %s" % (P["red"]("!!"), e["id"][:9], P["red"](p["why"])))
        res = catalog_check(todo, out=lambda *x: show(*x) if len(x) == 2 else print(x[0]),
                            budget=budget)
        print(D("  %d ok, %d failed, %d skipped %s %s" % (
            stats["ok"], stats["bad"], stats["skip"],
            bul_(nsa), spent())))
        path = opts.get("write")
        if path:
            path = os.path.expanduser(path)
            try:
                with open(path, encoding="utf-8") as fh:
                    obj = json.load(fh)
                catalog_validate(obj)
            except Exception as e:
                sys.exit("news: %s is not a feed index (%s)" % (path, str(e)[:40]))
            month = time.strftime("%Y-%m")
            n = 0
            for f_ in obj["feeds"]:
                p = res.get(norm_id(f_.get("id")))
                if not p or p["ok"] is None:
                    continue
                n += 1
                if p["ok"]:
                    f_["ok"] = month
                    f_.pop("fail", None)
                    if p["raw"] is not None:
                        f_["raw"] = p["raw"]
                    f_["val"] = bool(p["val"])
                else:
                    f_["fail"] = p["why"][:40]
                    f_.pop("ok", None)
            if n:
                obj["updated"] = time.strftime("%Y-%m-%d")   # new measurements are news
            tmp = path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(catalog_dump(obj))
            os.replace(tmp, path)
            print(D("  wrote %d result%s into %s" % (n, "" if n == 1 else "s", path)))
        return
    sys.exit("news: unknown catalog command %r (see: lowpingnews catalog help)" % verb)


__doc_catalog__ = """\
lowpingnews catalog                     list feeds you can subscribe to
lowpingnews catalog CATEGORY            just one category
lowpingnews catalog update              fetch the latest feed index (~10 KB)
lowpingnews catalog add ID [--to CAT]   subscribe; --to puts it in any category,
                                        new ones included
lowpingnews catalog add URL [--name N]  any feed, or a site that advertises one
lowpingnews catalog remove ID [--from CAT]
lowpingnews catalog upgrade             take new addresses for feeds that moved
lowpingnews catalog check [subscribed|all|CAT] [--budget KB] [--write FILE]
                                        probe feeds: reachable, really a feed,
                                        size, whether refreshes can be cheap

In the reader, press f to do all of this from a menu."""


BOOLF = {"--full": "full", "--plain": "plain", "--tui": "tui", "-f": "fresh", "--fresh": "fresh", "--offline": "offline",
         "--stream": "stream", "-g": "gps", "--gps": "gps", "--ip": "iploc",
         "-C": "celsius", "--celsius": "celsius",
         "--light": "light", "--cost": "cost", "-t": "titles", "--titles": "titles",
         "-u": "unread", "--unread": "unread", "--ascii": "ascii",
         "--check": "check", "-l": "list", "--list": "list",
         "--mark-all": "mark_all"}
VALF = {"--marine": ("marine", str), "-p": ("place", str), "--place": ("place", str),
        "-c": ("coords", str), "--coords": ("coords", str),
        "--label": ("label", str), "-n": ("n", int), "-s": ("only", str), "--only": ("only", str),
        "-o": ("open", int), "--open": ("open", int), "-r": ("read", int),
        "--read": ("read", int), "-S": ("star", int), "--star": ("star", int),
        "-q": ("query", str), "--query": ("query", str),
        "-d": ("download", str), "--download": ("download", str),
        "--budget": ("budget", int)}
DEFAULTS_NS = {"full": False, "marine": None, "n_by_count": False, "count": None, "plain": False, "tui": False, "place": None, "iploc": False, "gps": False, "stream": False, "coords": None, "label": None, "celsius": False,
               "offline": False, "light": False, "cost": False,
               "cat": None, "check": False, "fresh": False, "n": 5, "only": None,
               "titles": False, "open": None, "read": None, "star": None,
               "unread": False, "query": None, "download": None, "budget": None,
               "mark_all": False, "update": None, "list": False, "ascii": False,
               "color": True}


def fastparse(argv):
    """argparse costs ~7.6ms of a ~34ms run. Handle the common shapes without it
    and defer to argparse for anything unfamiliar, so behaviour cannot diverge."""
    ns = dict(DEFAULTS_NS)
    i, n = 0, len(argv)
    while i < n:
        t = argv[i]
        if t in BOOLF:
            ns[BOOLF[t]] = True
        elif t == "--no-color":
            ns["color"] = False
        elif t in VALF:
            if i + 1 >= n:
                return None
            key, cast = VALF[t]
            try:
                ns[key] = cast(argv[i + 1])
            except ValueError:
                return None
            i += 1
        elif t in ("--version", "-V"):
            sys.stdout.write("lowpingnews %s\n" % VERSION)
            raise SystemExit(0)
        elif t.startswith("-") and t != "-":
            return None                   # --help, --update, typos
        elif t.isdigit() and ns.get("count") is None:
            ns["count"] = int(t)          # `top 13`: how many articles, in all
        elif ns["cat"] is None:
            ns["cat"] = t
        else:
            return None                   # two positionals: let argparse complain
        i += 1
    return argparse_ns(count_ok(ns))


COUNTMAX = 500


def count_ok(ns):
    """A bare number is how many articles to show, newest first across every
    feed. It also lifts the per-feed cap, or asking for 30 from five feeds of
    five would silently stop at 25."""
    c = ns.get("count") if isinstance(ns, dict) else getattr(ns, "count", None)
    if c is None:
        return ns
    if not 1 <= c <= COUNTMAX:
        sys.exit("news: show between 1 and %d articles, not %d" % (COUNTMAX, c))
    get_n = ns.get("n") if isinstance(ns, dict) else getattr(ns, "n", 5)
    if get_n in (None, 5):                 # -n left at its default: let the count lead
        if isinstance(ns, dict):
            ns["n"], ns["n_by_count"] = c, True
        else:
            ns.n, ns.n_by_count = c, True
    return ns


class argparse_ns(object):
    def __init__(self, d):
        self.__dict__.update(d)

    def __getattr__(self, k):             # tolerate keys the caller did not set
        if k in DEFAULTS_NS:
            return DEFAULTS_NS[k]
        raise AttributeError(k)


def main():
    try:
        import signal
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except Exception:
        pass
    try:
        dns_install()                      # a failed lookup may use the last good address
    except Exception:
        pass
    if sys.argv[1:2] and sys.argv[1] in ("catalog", "feeds"):
        return cmd_catalog(sys.argv[2:])
    a = fastparse(sys.argv[1:])
    if a is not None:
        return run(a)
    import argparse
    p = argparse.ArgumentParser(prog="lowpingnews",
                                description="ultra-light headlines and weather")
    p.add_argument("count_", nargs="?", metavar="COUNT", default=None,
                   help="how many articles in all, newest first (top 13)")
    p.add_argument("cat", nargs="?", metavar="CATEGORY",
                   help="top, world, science, tech, bio, all, signal, weather")
    p.add_argument("--check", action="store_true", help="test every feed URL")
    p.add_argument("-g", "--gps", action="store_true",
                   help="take a fresh device location fix")
    p.add_argument("--ip", dest="iploc", action="store_true",
                   help="locate by IP address (city-level, tells a third party)")
    p.add_argument("--tui", action="store_true",
                   help="interactive reader (the default in a terminal)")
    p.add_argument("--plain", action="store_true",
                   help="classic list output instead of the interactive reader")
    p.add_argument("-p", "--place", metavar="NAME",
                   help="locate by town or city name")
    p.add_argument("-c", "--coords", metavar="LAT,LON", help="pin weather location")
    p.add_argument("--label", help="name for the pinned location")
    p.add_argument("--full", action="store_true", help="radio: whole alert text")
    p.add_argument("--marine", metavar="ZONE",
                   help="radio: add the marine forecast for a zone like ANZ335 (off to stop)")
    p.add_argument("-C", "--celsius", action="store_true", help="weather in celsius")
    p.add_argument("--stream", action="store_true",
                   help="print each feed as it lands instead of waiting")
    p.add_argument("--offline", action="store_true", help="cache only, open no sockets")
    p.add_argument("--light", action="store_true",
                   help="skip feeds that last cost over 30KB")
    p.add_argument("--cost", action="store_true",
                   help="estimate a refresh from known sizes, fetch nothing")
    p.add_argument("-f", "--fresh", action="store_true", help="bypass 15m cache")
    p.add_argument("-n", type=int, default=5, metavar="N", help="items per source")
    p.add_argument("-s", "--only", metavar="IDS", help="only these source ids")
    p.add_argument("-t", "--titles", action="store_true", help="no summaries")
    p.add_argument("-o", "--open", type=int, metavar="N", help="open item N in browser")
    p.add_argument("-r", "--read", type=int, metavar="N", help="read item N as text")
    p.add_argument("-d", "--download", metavar="LIST",
                   help="save article bodies offline: 1,3,5 or all")
    p.add_argument("--budget", type=int, metavar="KB",
                   help="ceiling for one -d run (default %d)" % (DLBUDGET // 1024))
    p.add_argument("-S", "--star", type=int, metavar="N", help="save/unsave item N")
    p.add_argument("-u", "--unread", action="store_true", help="hide items already read")
    p.add_argument("-q", "--query", metavar="TERM", help="search cached headlines")
    p.add_argument("--mark-all", action="store_true", help="mark everything read")
    p.add_argument("--update", nargs="?", const="", metavar="URL",
                   help="replace this script with the latest from URL")
    p.add_argument("--version", action="version",
                   version="lowpingnews " + VERSION)
    p.add_argument("-l", "--list", action="store_true", help="list sources")
    p.add_argument("--ascii", action="store_true")
    p.add_argument("--no-color", dest="color", action="store_false")
    a = p.parse_args()
    # argparse fills positionals left to right; sort them by what they are
    vals = [v for v in (a.count_, a.cat) if v is not None]
    a.count, a.cat = None, None
    for v in vals:
        if v.isdigit() and a.count is None:
            a.count = int(v)
        elif a.cat is None:
            a.cat = v
        else:
            p.error("give one category and one count at most")
    del a.count_
    count_ok(a)
    return run(a)


def open_url(u):
    """Hand a link to the platform. False means nothing could open it."""
    u = safe_url(u)
    if not u:
        return False
    import shutil, subprocess
    if shutil.which("termux-open-url"):
        subprocess.run(["termux-open-url", u], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
        return True
    try:
        import webbrowser
        return bool(webbrowser.open(u))
    except Exception:
        return False


class PingMeter(object):
    """Round-trip time to the nearest point of presence, measured as a TCP
    handshake (the same reasoning as probe(): ICMP is dropped by carriers
    independently of real traffic, and ping is absent on most Termux installs).

    The references are anycast addresses: the network itself routes each one
    to its closest site, so "nearest to where you are" needs no location
    lookup. All three are tried once and the fastest is kept, then sampled
    every `every` seconds. Connecting to an IP literal skips DNS, so this is
    link latency, not resolver latency. A handshake costs roughly 300 bytes.
    """
    REFS = (("1.1.1.1", 443, "cf"), ("8.8.8.8", 443, "g"), ("9.9.9.9", 443, "q9"))

    def __init__(self, every=300, refs=None):
        import threading
        self.every = max(5, int(every))
        self.refs = refs or self._env_refs() or self.REFS
        self.samples = []                      # ms, or None for a failed attempt
        self.stamps = []                       # when each sample was taken
        self.ref = None
        self.lock = threading.Lock()
        self.stop = threading.Event()
        self.t = threading.Thread(target=self._run, daemon=True)
        self.active_until = float("inf")       # the TUI moves this on each key
        self.tried = {}                        # reference -> best ms seen

    @staticmethod
    def _env_refs():
        # LPN_PING_REFS=host:port,host:port  (tests, or a preferred reference)
        v = os.environ.get("LPN_PING_REFS", "").strip()
        out = []
        for part in v.split(","):
            h, _, p = part.strip().rpartition(":")
            if h and p.isdigit():
                out.append((h, int(p), h.split(".")[0][:3]))
        return tuple(out)

    def start(self):
        self.t.start()
        return self

    def _rtt(self, host, port):
        import socket, struct
        t0 = time.time()
        try:
            c = socket.create_connection((host, port), timeout=3)
        except Exception:
            return None
        ms = (time.time() - t0) * 1000.0
        try:
            # abortive close: one RST instead of the FIN/ACK exchange. Measured
            # 796 B per probe on the wire instead of 928 B.
            c.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
        except Exception:
            pass
        try:
            c.close()
        except Exception:
            pass
        return ms

    def _pick(self):
        """Try every reference once; keep the fastest. None if all fail."""
        best = None
        for h, p, tag in self.refs:
            if self.stop.is_set():
                return None
            ms = self._rtt(h, p)
            if ms is not None and (best is None or ms < best[0]):
                best = (ms, h, p, tag)
        return best

    def _add(self, ms):
        with self.lock:
            self.samples.append(ms)
            self.stamps.append(time.time())
            del self.samples[:-16]
            del self.stamps[:-16]

    def _run(self):
        # a loop, not recursion: offline for hours must not exhaust the stack
        while not self.stop.is_set():
            try:
                self._cycle()
            except Exception:
                self._add(None)                # never let the sampler die quietly
            if self.stop.wait(self.every):
                return

    def _cycle(self):
        """One probe per cycle, never a burst. Until every reference has been
        tried once, each cycle tries the next one, so choosing the nearest
        costs one probe per cycle instead of three at once."""
        if time.time() > self.active_until:
            return                             # nobody is looking: spend nothing
        untried = [r for r in self.refs if (r[0], r[1]) not in self.tried]
        target = untried[0] if untried else None
        if target is None:
            if self.ref is None:               # everything failed last round
                self.tried.clear()
                target = self.refs[0]
            else:
                target = next((r for r in self.refs if r[:2] == self.ref[:2]), self.refs[0])
        k = (target[0], target[1])             # host AND port: one host, many services
        ms = self._rtt(target[0], target[1])
        if ms is None:
            self.tried[k] = None
        else:
            prev = self.tried.get(k)
            self.tried[k] = ms if prev is None else min(prev, ms)
        live = [(v, r) for r in self.refs for kk, v in self.tried.items()
                if kk == (r[0], r[1]) and v is not None]
        with self.lock:
            self.ref = min(live)[1] if live else None
        self._add(ms)

    def reading(self):
        """-> (latest ms or None, recent samples, reference tag, state).

        A sample older than a few cycles is history, not the current link: if
        the sampler has stalled or died, say "stale" rather than show it."""
        with self.lock:
            smp = list(self.samples)
            ref = self.ref
            last_t = self.stamps[-1] if self.stamps else None
        if not smp:
            return None, [], None, "measuring"
        if time.time() > self.active_until and (last_t is None or
                                               age_of(last_t) > self.every):
            return None, smp, ref and ref[2], "paused"
        if last_t is None or age_of(last_t) > max(3 * self.every, 90):
            return None, smp, ref and ref[2], "stale"
        last = smp[-1]
        if last is None:
            return None, smp, ref and ref[2], "no route"
        return last, smp, ref and ref[2], "ok"

    def close(self):
        self.stop.set()


def ping_label(ms):
    """Plain-language band, matching what the signal view calls good."""
    if ms is None:
        return "down"
    if ms < 60:
        return "good"
    if ms < 150:
        return "fair"
    if ms < 400:
        return "slow"
    return "poor"


def tui_available():
    """curses is POSIX-only; on Windows it needs a third-party package."""
    try:
        import curses                     # noqa: F401
        return True, ""
    except Exception as e:
        if os.name == "nt":
            return False, ("the interactive view needs curses, which is not "
                           "bundled on Windows.\n  pip install windows-curses")
        return False, ("the interactive view needs curses, which this Python lacks (%s).\n"
                       "  Use --plain for the printed list." % str(e)[:50])


TUIRETRY = 120                 # after a background refresh FAILS, wait this long



def _envint(name, default):
    try:
        return max(1, int(os.environ.get(name, default)))
    except (TypeError, ValueError):
        return default


# data younger than this is never called stale, whatever a feed's ttl says, so a
# silly ttl in sources.json cannot make the reader hammer a server
TUIMINAGE = _envint("LPN_TUI_MINAGE", 60)
# network work (background refresh, ping samples) only this long after a key:
# an idle reader shows its data's age and spends nothing
TUIACTIVE = _envint("LPN_TUI_ACTIVE", 300)


def _tui_rows(a, fresh):
    """-> (rows, meta). Same fetch path as the list view: gather() fills a bag
    of 5-tuples, then cache backfills anything the deadline missed.

    meta says how current the rows are, so the screen never has to guess:
      t        fetch time of the OLDEST source shown (epoch), None if unknown
      unknown  a source's cache carries an unusable timestamp
      ttl      shortest refresh interval among this category's sources
      failed   sources that could not be refreshed this time
      cat      the category these rows belong to
    """
    want = sources(a)                      # already filtered by a.cat
    meta = {"t": None, "unknown": False, "failed": [],
            "ttl": min([x.get("ttl") or TTL for x in want] or [TTL]),
            "cat": (a.cat or "top").lower()}
    if not want:
        return [], meta
    bag = gather(want, fresh)
    oldest = None
    out = []
    for x in want:
        got = bag.get(x["id"])
        c_ = jread("%s/%s.json" % (CD, x["id"]), {})
        if got is None or got[2] in (-1, -2):
            meta["failed"].append(x["name"])
            if not c_.get("items"):
                continue
            got = (c_["items"], 0, 1, 0, 0)
        elif got[2] != 0:                  # served from cache after a failure
            meta["failed"].append(x["name"])
        if not got[0]:
            continue
        a_ = age_of(c_.get("t"))
        if a_ == float("inf"):
            meta["unknown"] = True
        else:
            oldest = a_ if oldest is None else max(oldest, a_)
        for it in got[0]:
            out.append((it, x))
    if oldest is not None:
        meta["t"] = time.time() - oldest
    out.sort(key=lambda r: -when_sort(r[0]))
    seen, rows = set(), []
    for it, x in out:
        k = key(it["ti"])
        if k in seen:
            continue
        seen.add(k)
        rows.append((it, x))
    return rows[:ALLCAP], meta


def tui_freshness(meta):
    """-> (text, colour, stale?) for the banner. Colour: 2 green, 3 yellow."""
    if OFFLINE[0]:
        base = "offline"
        if meta.get("t"):
            base += ", cache " + ago(int(age_of(meta["t"])))
        return base, 3, True
    if meta.get("unknown"):
        return "age unknown", 3, True
    t = meta.get("t")
    if t is None:
        return "no data", 3, True
    a_ = age_of(t)
    stale = a_ >= max(meta.get("ttl") or TTL, TUIMINAGE)
    if stale:
        # never "stale just now": under a minute, say so in minutes
        txt = "stale " + (ago(int(a_)) if a_ >= 60 else "<1m")
    else:
        txt = ago(int(a_))
    return txt, (3 if stale else 2), stale


def all_cats(a):
    """Every category in use, in a stable order. sources() filters by a.cat,
    so ask it for everything."""
    was, a.cat = a.cat, "all"
    try:
        every = sources(a)
    finally:
        a.cat = was
    return sorted({str(c).lower() for x in every for c in x.get("cats", [])}) or ["top"]


def feeds_screen(scr, put, C, a, jump=None):
    """The feed manager: categories as sections, feeds as tick boxes. A tick
    means "this feed appears in this category". -> True if anything changed."""
    import curses
    import urllib.parse
    state_ = {"sel": 0, "top": 0, "msg": "", "changed": False}

    def build():
        idx = catalog_load()
        try:
            subs = [x for x in subs_load() if isinstance(x, dict)]
        except ConfigError as e:
            state_["msg"] = str(e)[:80]
            subs = []
        order = list(idx["cats"])
        for e in idx["feeds"]:
            for c in e["cats"]:
                if c not in order:
                    order.append(c)
        for x in subs:
            for c in x.get("cats") or []:
                c = norm_cat(c)
                if c and c not in order:
                    order.append(c)
        rows = []
        for c in order:
            label = idx["cats"].get(c) or ("your category" if not any(
                c in e["cats"] for e in idx["feeds"]) else "")
            rows.append(("hdr", c, label if label != c else ""))
            cand = [e for e in idx["feeds"] if c in e["cats"]]
            cand.sort(key=lambda e: (not starred(e), e.get("kb") or e.get("raw") or 999))
            for x in subs:                      # yours in this category, not in the index
                xc = [norm_cat(z) for z in x.get("cats") or []]
                if c in xc and not any(same_url(x.get("url"), e["url"]) for e in cand):
                    cand.append({"id": norm_id(x.get("id")), "name": x.get("name") or "?",
                                 "url": x.get("url") or "", "cats": xc, "kind": "rss",
                                 "custom": True})
            for e in cand:
                on = any(same_url(x.get("url"), e["url"]) and
                         c in [norm_cat(z) for z in x.get("cats") or []] for x in subs)
                rows.append(("feed", c, e, on))
        return rows, idx

    def prompt(label, initial=""):
        """One line of input. Enter accepts, Esc cancels. Works with a phone
        keyboard: printable characters, backspace, paste."""
        h, w = scr.getmaxyx()
        buf = list(initial)
        scr.timeout(-1)
        try:
            curses.curs_set(1)
        except Exception:
            pass
        try:
            while True:
                text = "".join(buf)
                room = max(4, w - len(label) - 3)
                shown = text[-room:]
                put(h - 1, 0, (" " + label + shown).ljust(w - 1), w - 1, C(3, True))
                try:
                    scr.move(h - 1, min(w - 2, len(label) + 1 + len(shown)))
                except curses.error:
                    pass
                scr.refresh()
                try:
                    ch = scr.get_wch()
                except curses.error:
                    continue
                except KeyboardInterrupt:
                    return None
                if ch in ("\n", "\r", curses.KEY_ENTER, 10, 13):
                    # whatever else was pasted with this line must not become
                    # the next prompt's text, or worse, menu commands
                    try:
                        curses.flushinp()
                    except Exception:
                        pass
                    return text.strip()
                if ch in ("\x1b", 27):
                    try:
                        curses.flushinp()
                    except Exception:
                        pass
                    return None
                if ch in (curses.KEY_BACKSPACE, "\x7f", "\b", 127, 8):
                    if buf:
                        buf.pop()
                    continue
                if isinstance(ch, str) and ch.isprintable() and len(buf) < 400:
                    buf.append(ch)
        finally:
            try:
                curses.curs_set(0)
            except Exception:
                pass

    def say(m):
        state_["msg"] = str(m)[:120]

    rows, idx = build()
    # start on the first feed - of the asked-for category, if there was one
    start = 0
    if jump:
        start = next((i for i, r in enumerate(rows) if r[0] == "hdr" and r[1] == jump), 0)
    state_["sel"] = next((i for i, r in enumerate(rows) if i >= start and r[0] == "feed"),
                         next((i for i, r in enumerate(rows) if r[0] == "feed"), 0))
    state_["top"] = start
    # Taps: on a touchscreen, tapping the row is the natural way to tick it.
    # Mouse reporting stops the terminal's own text selection, so it is on only
    # while this screen is open, and LPN_NO_MOUSE=1 keeps it off entirely.
    mouse = False
    if not os.environ.get("LPN_NO_MOUSE"):
        try:
            want = (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED |
                    getattr(curses, "BUTTON4_PRESSED", 0) |
                    getattr(curses, "BUTTON5_PRESSED", 0))
            got, _old = curses.mousemask(want)
            mouse = bool(got)
            curses.mouseinterval(0)            # a press is a press: no click merging
        except Exception:
            mouse = False
    while True:
        scr.erase()
        h, w = scr.getmaxyx()
        n_on = len({r[2]["url"] for r in rows if r[0] == "feed" and r[3]})
        head = " FEEDS  %d subscribed, %d in the index (%s) " % (
            n_on, len(idx["feeds"]), catalog_age_note(idx))
        put(0, 0, head.ljust(w - 1), w - 1, C(6, True))
        body_h = max(1, h - 2)
        sel = max(0, min(state_["sel"], len(rows) - 1))
        if sel < state_["top"]:
            state_["top"] = sel
        if sel >= state_["top"] + body_h:
            state_["top"] = sel - body_h + 1
        for n in range(body_h):
            i = state_["top"] + n
            if i >= len(rows):
                break
            r = rows[i]
            if r[0] == "hdr":
                put(n + 1, 0, (" %s  %s" % (r[1], r[2])).ljust(w - 1), w - 1, C(6, True))
                continue
            e, on = r[2], r[3]
            host = (urllib.parse.urlsplit(e["url"]).hostname or "").replace("www.", "")
            size = ("~%gK" % e["kb"]) if e.get("kb") is not None else (
                "<%gK" % e["raw"]) if e.get("raw") is not None else "?"
            flag = ("\u2605" if utf_out() else "*") if starred(e) else ("!" if e.get("fail") else " ")
            line = " %s %s %-*s %5s %s" % ("[x]" if on else "[ ]", flag, max(6, w - 32),
                                           e["name"][:max(6, w - 32)], size, host[:14])
            at = curses.A_REVERSE if i == sel else (C(2) if on else C(0))
            put(n + 1, 0, line.ljust(w - 1), w - 1, at)
        # fitted like the reader's: cut off at phone width, "q back" - the
        # way out - used to be the part that disappeared
        hint = state_["msg"] or fit_keys(
            ["tap or space: tick" if mouse else "space: tick", "a add URL", "t to category",
             "d delete", "u update list", "q back"],
            ["u update list", "t to category", "d delete", "a add URL"], w - 1)
        put(h - 1, 0, hint.ljust(w - 1), w - 1, C(4))
        scr.refresh()
        scr.timeout(-1)
        try:
            c = getkey(scr)
        except KeyboardInterrupt:
            break
        state_["msg"] = ""
        page = max(1, body_h - 1)
        if c == curses.KEY_MOUSE:
            try:
                _mid, _mx, my, _mz, bst = curses.getmouse()
            except curses.error:
                continue
            if bst & getattr(curses, "BUTTON4_PRESSED", 0):        # wheel / swipe up
                state_["sel"] = max(0, sel - 3)
                continue
            if bst & getattr(curses, "BUTTON5_PRESSED", 0):        # wheel / swipe down
                state_["sel"] = min(len(rows) - 1, sel + 3)
                continue
            if not bst & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED):
                continue                       # releases and drags: nothing to do
            i = state_["top"] + my - 1
            if not (1 <= my <= body_h and 0 <= i < len(rows)):
                continue                       # header or hint line
            if rows[i][0] != "feed":
                # a category heading: go to its first feed, so the cursor stays
                # visible instead of resting on a line that is never highlighted
                nxt = next((j for j in range(i, len(rows)) if rows[j][0] == "feed"), sel)
                state_["sel"] = nxt
                continue
            state_["sel"] = sel = i
            c = ord(" ")                       # a tap on a feed ticks it
        if c in (ord("q"), ord("b"), 27):
            break
        if c in (ord("j"), curses.KEY_DOWN):
            state_["sel"] = min(len(rows) - 1, sel + 1)
        elif c in (ord("k"), curses.KEY_UP):
            state_["sel"] = max(0, sel - 1)
        elif c in (curses.KEY_NPAGE,):
            state_["sel"] = min(len(rows) - 1, sel + page)
        elif c in (curses.KEY_PPAGE,):
            state_["sel"] = max(0, sel - page)
        elif c in (ord(" "), ord("\n"), 10, 13, curses.KEY_ENTER) and rows and rows[sel][0] == "feed":
            _k, cat, e, on = rows[sel]
            try:
                if on:
                    sub_ = [x for x in subs_load() if isinstance(x, dict)
                            and same_url(x.get("url"), e["url"])]
                    say(unsubscribe(sub_[0]["id"], cat) if sub_ else "not subscribed")
                else:
                    say(subscribe(e, cat))
                state_["changed"] = True
            except ConfigError as err:
                say(err)
            rows, idx = build()
        elif c == ord("t") and rows and rows[sel][0] == "feed":
            e = rows[sel][2]
            name = prompt("add %s to category: " % e["name"][:16])
            if name:
                cat = norm_cat(name)
                if not cat:
                    say("%r cannot be a category name" % name)
                else:
                    try:
                        say(subscribe(e, cat))
                        state_["changed"] = True
                    except ConfigError as err:
                        say(err)
                    rows, idx = build()
        elif c == ord("a"):
            cat0 = rows[sel][1] if rows else "top"
            raw_url = prompt("feed or website address: ")
            url, why_ = feed_url(raw_url) if raw_url else (None, None)
            if why_:
                say("not added: " + why_)
            if url:
                put(h - 1, 0, (" looking at %s ..." % url).ljust(w - 1), w - 1, C(3))
                scr.refresh()
                e0 = NETSTAT["est"]
                p = probe_feed(url)
                cost = kbs(NETSTAT["est"] - e0)
                if not p["ok"]:
                    say("not added: %s (~%s)" % (p["why"] or "not a feed", cost))
                else:
                    name = prompt("name: ", p["title"] or "")
                    if name is not None:
                        cat = prompt("category: ", cat0) or cat0
                        try:
                            ok, m_ = add_custom(url, name or None, cat, probe=p)
                            say("%s (~%s)" % (m_, cost))
                            state_["changed"] = state_["changed"] or ok
                        except ConfigError as err:
                            say(err)
                        rows, idx = build()
        elif c == ord("d") and rows and rows[sel][0] == "feed" and rows[sel][3]:
            e = rows[sel][2]
            yn = prompt("remove %s from every category? y/n " % e["name"][:20])
            if yn and yn.lower().startswith("y"):
                try:
                    sub_ = [x for x in subs_load() if isinstance(x, dict)
                            and same_url(x.get("url"), e["url"])]
                    say(unsubscribe(sub_[0]["id"]) if sub_ else "not subscribed")
                    state_["changed"] = True
                except ConfigError as err:
                    say(err)
                rows, idx = build()
        elif c == ord("u"):
            if OFFLINE[0]:
                say("offline - the index was not updated")
            else:
                put(h - 1, 0, " fetching the feed index ...".ljust(w - 1), w - 1, C(3))
                scr.refresh()
                e0 = NETSTAT["est"]
                _st, m_ = catalog_update()
                say("%s (~%s)" % (m_, kbs(NETSTAT["est"] - e0)))
                rows, idx = build()
    if mouse:
        try:
            curses.mousemask(0)                # give text selection back
        except Exception:
            pass
    return state_["changed"]


def cells(t):
    import unicodedata
    return sum(0 if unicodedata.combining(ch) else
               2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in t)


def wrap_cells(text, width):
    """Word-wrap by screen cells, not characters: a CJK title has no spaces
    and every character is two cells wide. Long words are split, never lost."""
    width = max(4, width)
    lines, cur, cw = [], "", 0
    for word in str(text).split():
        ww = cells(word)
        while ww > width:                       # a word longer than the line
            room = width - cw - (1 if cur else 0)
            if room < 2:
                lines.append(cur); cur, cw = "", 0
                room = width
            part, pw = "", 0
            for ch in word:
                c_ = cells(ch)
                if pw + c_ > room:
                    break
                part += ch; pw += c_
            cur = (cur + " " + part) if cur else part
            lines.append(cur); cur, cw = "", 0
            word = word[len(part):]; ww = cells(word)
        if not word:
            continue
        need = ww + (1 if cur else 0)
        if cw + need > width:
            lines.append(cur); cur, cw = word, ww
        else:
            cur, cw = ((cur + " " + word) if cur else word), cw + need
    if cur:
        lines.append(cur)
    return lines or [""]


TITLE_LINES = 4      # a card shows the whole title up to this many lines


def card_lines(n, it, src, width, stamp, mark, show_sum):
    """-> [(text, kind)], kind in head/title/sum/gap. Everything here came with
    the feed: a card costs no bytes beyond the list itself."""
    ind = "    "
    tw = max(8, width - len(ind) - 1)
    head = "%3d %s %s \u00b7 %s" % (n, mark, src, stamp)
    out = [(head, "head")]
    tl = wrap_cells(it.get("ti") or "", tw)
    if len(tl) > TITLE_LINES:
        tl = tl[:TITLE_LINES]
        tl[-1] = tl[-1][:max(1, len(tl[-1]) - 1)] + "\u2026"
    out += [(ind + ln, "title") for ln in tl]
    sm = " ".join(str(it.get("s") or "").split())
    if show_sum and sm and sm.lower() != (it.get("ti") or "").lower():
        one = wrap_cells(sm, tw - 1)            # leave a cell for the ellipsis
        out.append((ind + one[0] + ("\u2026" if len(one) > 1 else ""), "sum"))
    out.append(("", "gap"))
    return out


def fit_keys(parts, drop, width):
    """The key-hint line, made to fit: a phone is narrower than every hint at
    once, and a cut-off line once hid "q quit" and "f feeds" entirely. Least
    essential hints go first; quitting is always shown."""
    parts = list(parts)
    for d in drop:
        if len(" " + "  ".join(parts)) <= width:
            break
        if d in parts:
            parts.remove(d)
    return " " + "  ".join(parts)


def getkey(scr):
    """getch, plus arrow keys in either encoding. In keypad mode terminals send
    ESC O C, which curses decodes; some multiplexers and remote shells send
    ESC [ C regardless, which curses then hands over as a bare Esc followed by
    junk - and Esc means "back" or "quit". Decode those here; a lone Esc stays
    an Esc."""
    import curses
    c = scr.getch()
    if c != 27:
        return c
    scr.timeout(30)                            # the rest of a sequence is already here
    try:
        n1 = scr.getch()
        if n1 in (ord("["), ord("O")):
            n2 = scr.getch()
            arrows = {ord("A"): curses.KEY_UP, ord("B"): curses.KEY_DOWN,
                      ord("C"): curses.KEY_RIGHT, ord("D"): curses.KEY_LEFT,
                      ord("H"): curses.KEY_HOME, ord("F"): curses.KEY_END}
            if n2 in arrows:
                return arrows[n2]
            while n2 != -1 and not (64 <= n2 <= 126):   # skip the rest of any CSI
                n2 = scr.getch()
            return -1                          # an unknown sequence: ignore it, never quit
        if n1 != -1:
            curses.ungetch(n1)
        return 27
    finally:
        scr.timeout(-1)


def tui_setup(scr, a):
    """Drawing and colour for any curses screen. -> (put, C, colour)."""
    import curses
    import unicodedata
    try:
        curses.curs_set(0)
    except Exception:
        pass                                   # some terminals cannot hide it

    def put(y, x, text, n, attr=0):
        """addnstr that cannot crash: a CJK or emoji title is two cells per
        character, and writing into the bottom-right cell raises."""
        h_, w_ = scr.getmaxyx()
        if y < 0 or y >= h_ or x >= w_ - 1 or n <= 0:
            return
        room = min(n, w_ - 1 - x)
        out, used = [], 0
        for ch in text:
            cw = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
            if used + cw > room:
                break
            out.append(ch)
            used += cw
        try:
            scr.addstr(y, x, "".join(out), attr)
        except curses.error:
            pass

    scr.keypad(True)
    try:
        curses.set_escdelay(25)                 # Esc cancels now, not after a second
    except Exception:
        pass                                    # Python < 3.9
    # prefer repainting to hardware insert/delete-line, which emulators
    # implement unevenly (scroll regions are handled in adopt() instead)
    try:
        scr.idlok(False)
        scr.idcok(False)
    except Exception:
        pass
    colour = False
    try:
        if getattr(a, "color", True) and not os.environ.get("NO_COLOR") \
                and curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            for i in range(1, 7):
                curses.init_pair(i, i, -1)
            colour = True
    except Exception:
        colour = False

    def C(n, bold=False):
        if not colour:
            return curses.A_BOLD if bold else curses.A_NORMAL
        at = curses.color_pair(n)
        return at | curses.A_BOLD if bold else at

    return put, C, colour


def tui_main(scr, a, cats, meter=None):
    import curses
    import threading
    import unicodedata
    put, C, colour = tui_setup(scr, a)

    # ---- state -----------------------------------------------------------
    S = {"rows": [], "meta": {}, "st": state(), "sel": 0, "top": 0,
         "mode": "list", "body": [], "bscroll": 0, "reading": None,
         "sums": True,                         # cards show the feed's one-line summary
         "all": [], "limit": getattr(a, "count", None) or SHOW}
    note = {"text": "", "until": 0.0}          # transient status line
    act = {"last": time.time()}                 # opening the reader counts as use
    bg = {"thread": None, "result": None, "gen": 0, "last_try": 0.0}
    ci = [cats.index(a.cat) if (a.cat or "") in cats else 0]

    def flash(text, secs=2.5):
        """A message that expires. Work-in-progress messages are replaced by
        the outcome when the work ends, so none outlives what it describes."""
        note["text"], note["until"] = text, time.time() + secs

    def adopt(full, meta, keep_sel=True):
        """Install a new list, keep the cursor on the same story if it is
        still there, and make -r/-o/-S numbering match what is on screen.
        Within a category nothing visible is pushed out: the window grows to
        keep down to the oldest story already shown, plus whatever is new
        above it. -> how many stories are new."""
        cur = None
        if keep_sel and S["rows"] and 0 <= S["sel"] < len(S["rows"]):
            cur = key(S["rows"][S["sel"]][0]["ti"])
        same = bool(S["meta"]) and S["meta"].get("cat") == meta.get("cat")
        known = {key(it["ti"]) for it, _x in S["all"]}
        lim, new_n = S["limit"], 0
        if same and S["rows"]:
            oldest = key(S["rows"][-1][0]["ti"])
            for i, (it, _x) in enumerate(full):
                if key(it["ti"]) == oldest:
                    lim = max(lim, i + 1)
                    break
            new_n = sum(1 for it, _x in full[:lim] if key(it["ti"]) not in known)
        elif not same and S["meta"]:
            lim = getattr(a, "count", None) or SHOW      # a new category starts short again
        S["all"], S["limit"] = full, max(1, lim)
        rows = full[:S["limit"]]
        S["rows"], S["meta"] = rows, meta
        S["st"] = state()                      # read/star may have changed elsewhere
        S["sel"] = 0
        if cur is not None:
            for i, (it, _x) in enumerate(rows):
                if key(it["ti"]) == cur:
                    S["sel"] = i
                    break
        S["top"] = min(S["top"], S["sel"])
        fit_top()                      # the selected card may have been pushed down
        # a new list moves lines around; left to itself curses shifts them with
        # scroll regions, which some emulators drop. One full repaint instead.
        try:
            scr.clearok(True)
        except Exception:
            pass
        try:
            jwrite(LAST, [dict(it, src=x["name"]) for it, x in rows])
        except Exception:
            pass
        return new_n

    def show_more():
        """Ten more, further back in time: from what is already stored, so it
        costs nothing. Says plainly when the feeds hold nothing older."""
        if S["limit"] >= len(S["all"]):
            old = S["all"][-1][0].get("d") if S["all"] else None
            sec = age_secs(old) if old else -1
            flash("that is everything stored%s" % ((", back to %s" % ago(sec)) if sec >= 0 else ""), 3)
            return False
        before = len(S["rows"])
        S["limit"] = min(len(S["all"]), S["limit"] + MORE)
        S["rows"] = S["all"][:S["limit"]]
        try:
            jwrite(LAST, [dict(it, src=x["name"]) for it, x in S["rows"]])
        except Exception:
            pass
        flash("%d more, back to %s" % (len(S["rows"]) - before,
                                        ago(age_secs(S["rows"][-1][0].get("d"))) if S["rows"][-1][0].get("d")
                                        else "an unknown time"), 2.5)
        return True

    def load_now(fresh, label):
        flash(label, 3600)
        draw()
        bg["gen"] += 1                          # anything in flight is now obsolete
        rows, meta = _tui_rows(a, fresh)
        new_n = adopt(rows, meta, keep_sel=False)
        S["top"] = 0
        txt, _c, stale = tui_freshness(meta)
        flash(("could not refresh: " + txt) if stale else
              ("refreshed, %d new at the top" % new_n) if new_n else "refreshed, nothing new", 2.5)

    def want_background():
        """Refresh on our own when the data has aged past its TTL, cheaply:
        load() refetches only expired feeds and uses conditional GETs."""
        if OFFLINE[0] or bg["thread"] is not None:
            return False
        if time.time() - act["last"] > TUIACTIVE:
            return False                        # idle: show the age, spend nothing
        if time.time() - bg["last_try"] < TUIRETRY:
            return False
        if meter is not None and meter.reading()[3] in ("no route",):
            return False
        return tui_freshness(S["meta"])[2]

    def start_background():
        gen, cat = bg["gen"], a.cat

        def work():
            try:
                r = _tui_rows(a, False)
            except Exception:
                r = None
            bg["result"] = (gen, cat, r)
        t = threading.Thread(target=work, daemon=True)
        bg["thread"] = t
        t.start()

    def collect_background():
        if bg["thread"] is None or bg["thread"].is_alive():
            return
        gen, cat, r = bg["result"] or (None, None, None)
        bg["thread"], bg["result"] = None, None
        if r is None:
            bg["last_try"] = time.time()        # it failed: back off before retrying
            return
        if gen != bg["gen"] or cat != a.cat:
            return                              # category changed meanwhile: drop it
        rows, meta = r
        if tui_freshness(meta)[2]:
            bg["last_try"] = time.time()        # still stale: the source is down
        if rows or not S["rows"]:
            n_new = adopt(rows, meta)
            if n_new:
                flash("%d new at the top" % n_new, 4)

    # ---- drawing ---------------------------------------------------------
    def draw():
        scr.erase()
        h, w = scr.getmaxyx()
        rows = S["rows"]
        hdr = " LowPingNews %s  %s  %d item%s%s " % (
            VERSION, cats[ci[0]].upper(), len(rows), "" if len(rows) == 1 else "s",
            (" of %d" % len(S["all"])) if len(S["all"]) > len(rows) else "")
        fresh_txt, fresh_col, _st = tui_freshness(S["meta"]) if S["meta"] else ("", 2, False)
        if bg["thread"] is not None:
            fresh_txt, fresh_col = "refreshing", 3
        put(0, 0, hdr.ljust(w - 1), w - 1, C(6, True))
        x_f = len(hdr)
        if fresh_txt and x_f + len(fresh_txt) + 1 < w - 1:
            put(0, x_f, fresh_txt, len(fresh_txt) + 1, C(fresh_col, True))
            x_f += len(fresh_txt) + 1
        if meter is not None:
            ms, smp, ref, state_ = meter.reading()
            vals = [x for x in smp if x is not None]
            band = ping_label(ms) if state_ == "ok" else state_
            txt = ("%dms %s" % (round(ms), band)) if ms is not None else band
            if len(vals) >= 2 and w >= 60:     # the trend matters more than a number
                txt = spark(vals[-8:], False) + " " + txt
            colr = {"good": 2, "fair": 3, "slow": 3, "poor": 1}.get(band, 1)
            x0 = w - 2 - len(txt)
            if x0 > x_f + 1:                   # never over the title or the age
                put(0, x0, txt, len(txt) + 1, C(colr, True))
        # widest name that still tells sources apart, capped so titles keep room
        nw = min(14, max([len(x["name"]) for _i, x in rows] or [4]))
        nw = max(4, min(nw, w // 4))
        st = S["st"]
        stars = {key(x["ti"]) for x in st["star"]}
        if S["mode"] == "list":
            if not rows:
                put(2, 2, "nothing to show - press r to refresh", max(1, w - 3), C(4))
            # when the view scrolls, cards move by several lines; left alone,
            # curses shifts screen regions to save output, which emulators
            # mishandle (lines vanished and interleaved). Repaint whole instead:
            # a few KB to the local screen, nothing over the network.
            layout = (S["top"], S["sums"], w, h)
            if S.get("drawn") != layout:
                scr.clearok(True)
                S["drawn"] = layout
            y = 1
            idx = S["top"]
            bar = "|" if a.ascii else "\u258c"
            while y < h - 1 and 0 <= idx < len(rows):
                it, s_ = rows[idx]
                k = key(it["ti"])
                rd = k in st["read"]
                # recomputed on every draw, so ages advance while the screen is open
                sec = age_secs(it.get("d")) if it.get("d") else -3
                stamp = "?" if sec < 0 else ("now" if sec < 60 else age(sec))
                mark = ("*" if a.ascii else "\u2605") if k in stars else (" " if rd else
                                                                        ("o" if a.ascii else "\u2022"))
                sel_ = idx == S["sel"]
                for txt, kind in card_lines(idx + 1, it, s_["name"][:24], w, stamp, mark, S["sums"]):
                    if y >= h - 1:
                        break
                    if kind == "head":
                        at = C(4) if rd else C(6 if colour else 0, True)
                    elif kind == "title":
                        at = C(0) if rd else C(7 if not colour else 0, True)
                    elif kind == "sum":
                        at = C(4)
                    else:
                        at = C(0)
                    # every line is padded to full width: frames are drawn over
                    # the last one, and a short line would leave its tail behind
                    if sel_ and kind != "gap":
                        put(y, 0, bar, 1, C(6 if colour else 0, True) | curses.A_BOLD)
                        put(y, 1, (txt[1:] if txt.startswith(" ") else txt).ljust(w - 2), w - 2,
                            at | (curses.A_BOLD if kind in ("head", "title") else 0))
                    else:
                        put(y, 0, txt.ljust(w - 1), w - 1, at)
                    y += 1
                idx += 1
            if rows and idx >= len(rows) and y < h - 1:
                # the end of the list says what lies beyond it, and how far back
                more_n = len(S["all"]) - len(rows)
                if more_n > 0:
                    nxt = S["all"][min(len(S["all"]), len(rows) + MORE) - 1][0].get("d")
                    end_txt = "  %s m: %d more, to %s" % ("v" if a.ascii else "\u25be", min(MORE, more_n),
                                                         ago(age_secs(nxt)) if nxt else "an unknown time")
                else:
                    od = rows[-1][0].get("d")
                    end_txt = "  all %d shown%s" % (len(rows), (", oldest " + ago(age_secs(od))) if od else "")
                put(y, 0, end_txt.ljust(w - 1), w - 1, C(4))
                y += 1
            while y < h - 1:                        # clear below the last card
                put(y, 0, " " * (w - 1), w - 1, C(0))
                y += 1
        else:
            for n in range(h - 2):
                if S["bscroll"] + n >= len(S["body"]):
                    break
                put(n + 1, 0, S["body"][S["bscroll"] + n][:w - 1], w - 1)
        keys = (fit_keys(["j/k", "enter read", "m more", "s star", "o open", "r refresh",
                          ("n/p" if a.ascii else "\u2190\u2192") + " cat", "v view", "f feeds", "q quit"],
                         ["j/k", "m more", "v view", "r refresh", "o open", "f feeds", "s star"], w - 1)
                if S["mode"] == "list" else
                " j/k scroll  b back  s star  o open  q quit")
        msg = note["text"] if time.time() < note["until"] else ""
        put(h - 1, 0, (" " + msg if msg else keys).ljust(w - 1), w - 1, C(4))
        scr.refresh()

    def card_h(i, w):
        """Lines card i takes at width w (the trailing gap included)."""
        return len(card_lines(i + 1, S["rows"][i][0], "", w, "", " ", S["sums"]))

    def fit_top():
        """Cards differ in height: scroll by whole cards until the selected
        one is entirely on screen."""
        rows_ = S["rows"]
        S["sel"] = max(0, min(S["sel"], max(0, len(rows_) - 1)))
        if S["sel"] < S["top"]:
            S["top"] = S["sel"]
        h_, w_ = scr.getmaxyx()
        avail = max(1, h_ - 2)
        while S["top"] < S["sel"] and \
                sum(card_h(i, w_) for i in range(S["top"], S["sel"] + 1)) - 1 > avail:
            S["top"] += 1
        S["top"] = max(0, min(S["top"], max(0, len(rows_) - 1)))

    def cards_on_screen():
        h_, w_ = scr.getmaxyx()
        used, n = 0, 0
        for i in range(S["top"], len(S["rows"])):
            used += card_h(i, w_)
            if used - 1 > h_ - 2:
                break
            n += 1
        return max(1, n)

    def wrap_article(it):
        h, w = scr.getmaxyx()
        width = max(20, min(w - 2, 100))
        out = [it["ti"], ""]
        txt, how = "", ""
        try:
            txt, _nb, how = fetch_article(it)
        except Exception as e:
            txt, how = "", "could not fetch: %s" % str(e)[:60]
        if not txt:
            txt = it.get("s") or "(no text available)"
            if how in ("full", "abstract"):
                how = "feed"
        out.append("[%s]" % kind_note(how, it)[0])
        if LAST_WHY and not str(how).endswith("full"):
            out.append("tried: " + "; ".join(LAST_WHY))
        out.append("")
        for para in txt.split("\n"):
            if not para.strip():
                out.append("")
                continue
            line = ""
            for word in para.split():
                if len(line) + len(word) + 1 > width:
                    out.append(line)
                    line = word
                else:
                    line = (line + " " + word).strip()
            out.append(line)
        out += ["", it.get("u") or ""]
        return out

    def toggle_star(it):
        st = S["st"]
        k = key(it["ti"])
        keep = [x for x in st["star"] if key(x["ti"]) != k]
        on = len(keep) == len(st["star"])
        if on:
            keep.append(it)
        st["star"] = keep[-STARCAP:]
        state(st)
        flash("starred" if on else "unstarred")

    def open_it(it):
        u = it.get("u")
        if not u:
            flash("no link")
            return
        curses.def_prog_mode()
        curses.endwin()                         # a text browser needs the terminal
        try:
            ok = open_url(u)
        finally:
            curses.reset_prog_mode()
            scr.refresh()
        flash("opened" if ok else "no browser: " + u[:60], 4)

    # ---- first load, then the loop --------------------------------------
    rows, meta = _tui_rows(a, bool(getattr(a, "fresh", False)))
    adopt(rows, meta, keep_sel=False)
    act["last"] = time.time()                   # idle is measured from a usable screen
    while True:
        collect_background()
        if want_background():
            start_background()
        if meter is not None:
            meter.active_until = act["last"] + TUIACTIVE
        # tick fast only while something is moving; otherwise every 15 s is
        # enough for minute-granular ages, and the CPU can sleep
        busy = bg["thread"] is not None or time.time() < note["until"]
        wait = 1.0 if busy else 15.0
        m_ = S["meta"]
        if m_.get("t") and not OFFLINE[0]:     # wake exactly when data goes stale
            due = m_["t"] + max(m_.get("ttl") or TTL, TUIMINAGE) - time.time()
            if due > 0:
                wait = min(wait, due + 0.2)
        scr.timeout(int(max(0.2, wait) * 1000))
        draw()
        try:
            c = getkey(scr)
        except KeyboardInterrupt:
            break
        if c == -1:                             # timeout tick, not a key
            continue
        act["last"] = time.time()
        h, _w = scr.getmaxyx()
        page = cards_on_screen()
        rows = S["rows"]
        if c in (ord("q"), 27):
            if S["mode"] == "read":
                S["mode"] = "list"
                continue
            break
        if S["mode"] == "list":
            last = max(0, len(rows) - 1)       # empty list: stay at 0, never -1
            # titles wrap now, so left and right are free: they change category,
            # which is what the arrow keys on a phone's extra-keys row are for
            if c in (curses.KEY_RIGHT, ord("l")):
                c = ord("n")
            elif c in (curses.KEY_LEFT, ord("h")):
                c = ord("p")
            if c == ord("m"):
                if show_more():
                    S["sel"] = min(len(S["rows"]) - 1, S["sel"] + 1) if S["sel"] >= last else S["sel"]
            elif c == ord("v"):
                S["sums"] = not S["sums"]
                flash("titles and summaries" if S["sums"] else "titles only", 2)
            elif c in (ord("j"), curses.KEY_DOWN):
                if S["sel"] >= last and S["rows"] and show_more():
                    S["sel"] = last + 1                # past the end: keep going back in time
                else:
                    S["sel"] = min(last, S["sel"] + 1)
            elif c in (ord("k"), curses.KEY_UP):
                S["sel"] = max(0, S["sel"] - 1)
            elif c in (curses.KEY_NPAGE, ord(" ")):
                S["sel"] = min(last, S["sel"] + page)
            elif c == curses.KEY_PPAGE:
                S["sel"] = max(0, S["sel"] - page)
            elif c in (ord("\n"), curses.KEY_ENTER, 10, 13):
                if rows:
                    it = rows[S["sel"]][0]
                    flash("fetching...", 3600)
                    draw()
                    S["body"], S["bscroll"], S["mode"] = wrap_article(it), 0, "read"
                    S["reading"] = it
                    note["until"] = 0
                    k = key(it["ti"])
                    if k not in S["st"]["read"]:
                        S["st"]["read"].append(k)
                        state(S["st"])
            elif c == ord("r"):
                load_now(True, "refreshing...")
            elif c in (ord("n"), ord("p"), 9):
                # letters, not Tab: terminal emulators and phone keyboards
                # swallow Tab before curses ever sees it
                ci[0] = (ci[0] + (-1 if c == ord("p") else 1)) % len(cats)
                a.cat = cats[ci[0]]
                load_now(False, "loading %s..." % cats[ci[0]])
            elif c == ord("f"):
                changed = feeds_screen(scr, put, C, a)
                try:
                    scr.clearok(True)
                except Exception:
                    pass
                if changed:
                    cats[:] = all_cats(a)
                    if (a.cat or "") not in cats:
                        a.cat = cats[0]
                    ci[0] = cats.index(a.cat)
                    load_now(False, "loading %s..." % a.cat)
            elif c == ord("s") and rows:
                toggle_star(rows[S["sel"]][0])
            elif c == ord("o") and rows:
                open_it(rows[S["sel"]][0])
            rows = S["rows"]
            S["sel"] = max(0, min(S["sel"], max(0, len(rows) - 1)))
            fit_top()
        else:
            body = S["body"]
            if c in (ord("j"), curses.KEY_DOWN):
                S["bscroll"] = min(max(0, len(body) - 1), S["bscroll"] + 1)
            elif c in (ord("k"), curses.KEY_UP):
                S["bscroll"] = max(0, S["bscroll"] - 1)
            elif c in (curses.KEY_NPAGE, ord(" ")):
                S["bscroll"] = min(max(0, len(body) - 1), S["bscroll"] + page)
            elif c == curses.KEY_PPAGE:
                S["bscroll"] = max(0, S["bscroll"] - page)
            elif c == ord("b"):
                S["mode"] = "list"
            elif c == ord("s") and S["reading"]:
                toggle_star(S["reading"])       # the hint promised this
            elif c == ord("o") and S["reading"]:
                open_it(S["reading"])


LIST_FLAGS = ("budget", "check", "cost", "download", "light", "list", "mark_all",
              "only", "open", "query", "read", "star", "stream", "titles",
              "unread", "update", "ascii")


def default_tui_ok(a):
    """True when nothing on the command line asks for list output."""
    for f in LIST_FLAGS:
        v = getattr(a, f, None)
        if v not in (None, False, 0, ""):
            return False
    # -n shapes the list; a count also raises n, but that is not a request for
    # list output - `lowpingnews top 13` should open the reader with 13
    if not getattr(a, "n_by_count", False) and getattr(a, "n", 5) not in (None, 5):
        return False
    return True


def cmd_feeds_tui(a, jump=None):
    """The feed manager as its own screen. -> True if it ran."""
    if not tui_can_start():
        return False
    import curses
    os.environ["LPN_NO_PROGRESS"] = "1"
    buf = io.StringIO()
    real_err, sys.stderr = sys.stderr, buf

    def body(scr):
        put, C, _colour = tui_setup(scr, a)
        return feeds_screen(scr, put, C, a, jump=jump)
    try:
        changed = curses.wrapper(body)
    except KeyboardInterrupt:
        changed = False
    finally:
        sys.stderr = real_err
        held = buf.getvalue().strip()
        if held:
            sys.stderr.write(held + "\n")
    if changed:
        print("  feeds saved - `lowpingnews` to read them")
    return True


def tui_can_start():
    """Default-mode check: everything --tui needs, without complaining."""
    if os.environ.get("LPN_NO_TUI"):
        return False
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    if os.environ.get("TERM", "") in ("", "dumb"):
        return False
    ok, _why = tui_available()
    return ok


def cmd_tui(a, P, D, explicit=True):
    ok, why = tui_available()
    if not ok:
        if not explicit:
            return None                        # default mode: fall back quietly
        sys.exit("news: %s" % why)
    if not sys.stdout.isatty() or not sys.stdin.isatty():
        if not explicit:
            return None
        sys.exit("news: --tui needs a terminal (this looks like a pipe)")
    import curses
    os.environ["LPN_NO_PROGRESS"] = "1"     # the progress bar would draw over us
    cats = all_cats(a)
    a.cat = (a.cat or "top").lower()
    if a.cat not in cats:
        a.cat = cats[0]
    meter = None
    if not OFFLINE[0] and not os.environ.get("LPN_NO_PING"):
        meter = PingMeter().start()
    # stderr would draw over the curses screen, but discarding it would hide
    # crashes: capture instead, and replay once the screen is released
    buf = io.StringIO()
    real_err, sys.stderr = sys.stderr, buf
    started = [False]

    def body(scr, *args):
        started[0] = True
        return tui_main(scr, *args)
    try:
        curses.wrapper(body, a, cats, meter)
    except KeyboardInterrupt:
        pass
    except curses.error:
        if explicit or started[0]:
            raise
        return None                            # could not even initialise: list
    finally:
        sys.stderr = real_err
        if meter is not None:
            meter.close()
        held = buf.getvalue().strip()
        if held:
            sys.stderr.write(held + "\n")
    return True


UPDATE_URL = "https://raw.githubusercontent.com/ATinyGreenCell/LowPingNews/main/news"
MAIN_GUARD = '\nif __name__ == "__main__":'


def update_verdict(raw, partial):
    """-> (version, None) for a complete, plausible program, or (None, why).
    A transfer cut between two functions still parses, so completeness is
    checked separately: no partial flag, and the closing main guard present."""
    if partial:
        return None, "the download was cut short"
    try:
        txt = raw.decode("utf-8")
    except UnicodeDecodeError:
        return None, "the download is not text"
    # an error page or some other file: this program has these, wherever they sit
    if len(raw) < 8000 or "\ndef cmd_update(" not in txt or "\ndef main(" not in txt:
        return None, "that does not look like LowPingNews (%s)" % kbs(len(raw))
    if MAIN_GUARD not in txt[-1500:]:
        return None, "the download is incomplete (its last part is missing)"
    try:
        import ast
        ast.parse(txt)
    except SyntaxError as e:
        return None, "the download does not parse (line %s)" % e.lineno
    m = re.search(r'^VERSION\s*=\s*["\']([^"\']+)["\']', txt, re.M)
    if not m:
        return None, "the download has no version"
    return m.group(1), None


def update_why(e):
    """A download failure in words a user can act on."""
    t = str(getattr(e, "reason", None) or e)
    if "CERTIFICATE_VERIFY_FAILED" in t:
        return ("this Python cannot check HTTPS certificates. On macOS, run "
                "'Install Certificates.command' in the Python folder under Applications")
    return t[:80]


def cmd_update(a, P, D):
    """Replace this program with the latest release, on any platform. Nothing
    is replaced unless the new copy is complete, parses, is newer, and runs."""
    import subprocess
    uf = CFD + "/update.url"
    url = a.update or os.environ.get("NEWS_UPDATE_URL", "")
    if not url and os.path.exists(uf):
        try:
            url = io.open(uf, encoding="utf-8").read().strip()
        except OSError:
            url = ""
    url = url or UPDATE_URL
    if not url.startswith(("https://", "http://")):
        sys.exit("news: an update address must start with https:// (got %r)" % url[:60])
    me = os.path.realpath(sys.argv[0])
    where = os.path.dirname(me)
    if not os.access(me, os.W_OK) or not os.access(where, os.W_OK):
        sys.exit("news: cannot write %s.\n  It was installed where your account cannot change it. Either run the\n"
                 "  update as the account that installed it, or reinstall into your own\n"
                 "  folder: sh install.sh (it picks ~/.local/bin when /usr/local is closed)" % me)
    # the first 4 KB settle most checks: VERSION is near the top
    if os.environ.get("LPN_FORCE") != "1":
        try:
            head, _h, _w, _p = get(url, 30, extra={"Range": "bytes=0-4095"}, cap=PAGECAP)
            m_ = re.search(r'^VERSION\s*=\s*["\']([^"\']+)["\']', head.decode("utf-8", "replace"), re.M)
            peek = m_.group(1) if m_ else "?"
            if peek == VERSION:
                print(D("  already %s, the latest %s %s" % (VERSION, bul_(a), spent())))
                return
            if peek != "?" and vkey(peek) < vkey(VERSION):
                sys.exit("news: %s offers %s, older than the installed %s - not installing.\n"
                         "  Set LPN_FORCE=1 to downgrade deliberately." % (url, peek, VERSION))
        except SystemExit:
            raise
        except Exception:
            pass                               # no verdict from the head: fetch it all
    try:
        raw, _h, _w, part = get(url, 60, cap=PAGECAP)
    except Exception as e:
        sys.exit("news: download failed - %s" % update_why(e))
    new, why = update_verdict(raw, part)
    if why:
        sys.exit("news: %s - nothing changed. Try again on a steadier connection." % why)
    if new == VERSION:
        print(D("  already %s, the latest %s %s" % (VERSION, bul_(a), spent())))
        return
    if vkey(new) < vkey(VERSION) and os.environ.get("LPN_FORCE") != "1":
        sys.exit("news: %s offers %s, older than the installed %s - not installing.\n"
                 "  Set LPN_FORCE=1 to downgrade deliberately." % (url, new, VERSION))
    # keep what the installer chose: its interpreter line, and the file mode
    body = raw
    try:
        first = io.open(me, "rb").readline()
    except OSError:
        first = b""
    if body.startswith(b"#!"):
        nl = body.find(b"\n")
        keep = first.rstrip(b"\r\n") if first.startswith(b"#!") else \
            ("#!%s" % (sys.executable or "/usr/bin/env python3")).encode()
        body = keep + body[nl:]
    try:
        mode = os.stat(me).st_mode & 0o777 | 0o100
    except OSError:
        mode = 0o755
    tmp = me + ".new"
    try:
        with io.open(tmp, "wb") as fh:             # bytes: no CRLF on Windows
            fh.write(body)
        os.chmod(tmp, mode)
        # run the new copy before trusting it: catches a program that parses
        # but fails on this Python or this platform
        env_ = dict(os.environ, LPN_NO_PING="1")
        r = subprocess.run([sys.executable, tmp, "--version"], stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE, env=env_, timeout=60)
        said = r.stdout.decode("utf-8", "replace").strip()
        if r.returncode != 0 or not said.endswith(new):
            err = (r.stderr.decode("utf-8", "replace").strip().splitlines() or [""])[-1]
            raise RuntimeError("the new version did not start here (%s)" % (err[:70] or said[:70]))
        try:
            shutil_copy(me, me + ".bak")
        except Exception:
            pass
        os.replace(tmp, me)                       # atomic: never a half-written news
    except Exception as e:
        try:
            os.remove(tmp)
        except OSError:
            pass
        sys.exit("news: update not installed - %s. Your current %s is untouched."
                 % (e if isinstance(e, RuntimeError) else update_why(e), VERSION))
    print(D("  updated %s -> %s %s %s" % (VERSION, new, bul_(a), spent())))
    print(D("  the previous version is kept at %s.bak" % me))
    if url != UPDATE_URL:
        try:
            if not os.path.exists(uf) or io.open(uf, encoding="utf-8").read().strip() != url:
                os.makedirs(CFD, exist_ok=True)
                io.open(uf, "w", encoding="utf-8").write(url + "\n")
        except OSError:
            pass

def cmd_pick(a, P, D, pick):
    try:
        last = json.load(open(LAST, encoding="utf-8"))
    except Exception:
        sys.exit("news: nothing listed yet - run `news` first")
    if not 1 <= pick <= len(last):
        sys.exit("news: pick 1-%d" % len(last))
    it = last[pick - 1]
    old_ = list_age_note()
    if old_:
        sys.stderr.write("  note: %s\n" % old_)
    st = state()
    if a.star:
        k = key(it["ti"])
        keep = [x for x in st["star"] if key(x["ti"]) != k]
        on = len(keep) == len(st["star"])
        st["star"] = (keep + ([it] if on else []))[-STARCAP:]
        state(st)
        print(D("  %s %s" % ("saved" if on else "unsaved", it["ti"][:50])))
        return
    if key(it["ti"]) not in st["read"]:
        st["read"].append(key(it["ti"]))
        state(st)
    if a.open:
        if not open_url(it["u"]):
            print(it["u"])            # no browser: the URL is the fallback
        return
    # -r: feed body first (already paid for), network only as fallback
    try:
        cols = min(os.get_terminal_size().columns, 100)
    except Exception:
        cols = 46
    try:
        body, nb, how = fetch_article(it)
    except Exception as e:
        sys.exit("news: fetch failed - %s" % str(e)[:60])
    if how == "nolink":
        sys.exit("news: no link and no text in feed")
    import textwrap
    Pr = pal(a.color)
    for ln in textwrap.wrap(it["ti"], max(20, cols - 2)) or [""]:
        print(Pr["b"](ln))
    note, col = kind_note(how, it)
    print(Pr["d"]("  %s %s %s" % (
        it.get("src", "?"), bul_(a), age(int(time.time()) - it["d"])
        if it.get("d") else "?")) + Pr["d"](" %s " % bul_(a)) + Pr[col](note))
    if LAST_WHY and not how.endswith("full"):
        print(Pr["d"]("  tried: " + "; ".join(LAST_WHY)[:max(20, cols - 10)]))
    print()
    for para in (body or "").split("\n\n"):
        print(textwrap.fill(para, max(20, cols - 2), initial_indent="  ",
                            subsequent_indent="  ") + "\n")
    if not body:
        print(D("  no readable paragraphs - likely paywalled or JS-rendered"))
    print(D("  %s" % ({"feed": "from feed, 0B over the wire",
                       "offline": "from offline store, 0B over the wire"}
                      .get(how, "fetched %s, stored offline" % kbs(nb)))))
    return


def cmd_download(a, P, D):
    try:
        last = json.load(open(LAST, encoding="utf-8"))
    except Exception:
        sys.exit("news: nothing listed yet - run `news` first")
    if a.download.strip().lower() == "all":
        want = list(range(1, len(last) + 1))
    else:
        try:
            want = [int(x) for x in a.download.replace(" ", "").split(",") if x]
        except ValueError:
            sys.exit("news: -d takes 1,3,5 or all")
    cap_ = max(1024, a.budget * 1024) if a.budget else DLBUDGET
    tot, got, free = 0, 0, 0
    for i in want:
        if not 1 <= i <= len(last):
            print(D("  %2d skipped - out of range" % i))
            continue
        it = last[i - 1]
        # afford it before starting it: every fetch pays at least a handshake,
        # so "stop once over" overshot the budget by a whole article
        need = predict(0, it.get("u"))
        if tot + need > cap_ and not have(key(it["ti"])):
            print(D("  stopped before %d - %s spent, the next needs ~%s "
                    "(--budget KB to raise)" % (i, kbs(tot), kbs(need))))
            break
        try:
            e0 = NETSTAT["est"]
            txt, nb, how = fetch_article(it)
            nb = NETSTAT["est"] - e0           # true cost, handshakes included
        except Exception as e:
            print(D("  %2d failed   %s" % (i, str(e)[:40])))
            tot += NETSTAT["est"] - e0         # a failed fetch still spent bytes
            continue
        tot += nb
        if how in ("feed", "offline"):
            free += 1
        if txt:
            got += 1
        Pd = pal(a.color)
        tag_ = (Pd["grn"]("%-6s" % "free") if not nb
                else (Pd["yel"] if nb < 102400 else Pd["red"])("%-6s" % kbs(nb)))
        print("  %s %s %s %s" % (Pd["d"]("%2d" % i), tag_,
                                 Pd["d"]("%-7s" % how),
                                 it["ti"][:max(10, cols_() - 21)]))
    print()
    wrapout("%d/%d stored %s %s over the wire%s"
            % (got, len(want), bul_(a), kbs(tot),
               "" if not free else " %s %d already had text" % (bul_(a), free)),
            pal(a.color), cols_())
    return


def cmd_signal(a, P, D):
    st_ = net_stats()
    W = cols_()
    # verdict first: the answer to "should I pull now" belongs on line one
    probes, verdict, vc = [], "unknown", P["d"]
    hosts = []
    for x in sources(argparse_ns({"only": None, "cat": "all"})):
        hp = hostport(x["url"])
        if hp[0] and hp not in hosts:
            hosts.append(hp)
    probes = probe(hosts[:2])
    reach = [r for r in probes if r["tcp"] is not None]
    if probes and not reach:
        verdict, vc = "offline", P["red"]
    elif st_:
        if st_["rate"] >= 90 and st_["bps"] > 20000:
            verdict, vc = "good", P["grn"]
        elif st_["rate"] >= 60:
            verdict, vc = "usable", P["yel"]
        else:
            verdict, vc = "poor", P["red"]
    elif reach:
        verdict, vc = "reachable", P["yel"]
    print(P["hdr"]("SIGNAL") + "  " + vc(verdict))

    for r_ in probes:
        h = r_["host"].split(".")
        short = r_["host"]
        if len(h) > 3 and not r_["host"].replace(".", "").isdigit():
            short = ".".join(h[-3:])   # trim subdomains, never an IP literal
        if r_["tcp"] is None:
            print("  %-7s %s %s" % ("link", P["red"]("%9s" % "no route"),
                                    D(short[:W - 20])))
            continue
        tc = (P["grn"] if r_["tcp"] < 150 else
              P["yel"] if r_["tcp"] < 500 else P["red"])
        dc = (D if (r_["dns_cold"] or 0) < 120 else P["yel"])
        note = " proxied?" if (r_["tcp"] < 2 and not r_["host"].startswith(
            ("127.", "10.", "192.168."))) else ""
        print("  %-7s %s %s  %s%s" % (
            "link", tc("%5dms" % r_["tcp"]), dc("%4dms dns" % (r_["dns_cold"] or 0)),
            D(short[:W - 26]), P["yel"](note)))
    ic = icmp(hosts[0][0]) if hosts else None
    if ic:
        print("  %-7s %s %s" % ("", D("%5.0fms" % (ic["avg"] or 0)),
              D("icmp, %.0f%% loss" % ic["loss"])))

    if st_:
        rc = (P["grn"] if st_["rate"] >= 90 else
              P["yel"] if st_["rate"] >= 60 else P["red"])
        print("  %-7s %s %s %s" % (
            "rate", P["b"]("%8s/s" % kbs(int(st_["bps"]))),
            D("%dms" % st_["ms"]),
            rc("%.0f%% ok" % st_["rate"]) + D(" of %d" % st_["n"])))

    # the actionable part: what a refresh costs, and how long it would take
    allsrc = sources(argparse_ns({"only": None, "cat": "all"}))
    unmeasured = sum(1 for x in allsrc
                     if jread("%s/%s.json" % (CD, x["id"]), {}).get("w") is None)
    shown = 0
    for cat in ("top", "science", "tech", "bio", "world"):
        due, _unk = cat_cost(cat)
        if not due:                    # within ttl: nothing to decide about
            continue
        eta = (" ~%.0fs" % (due / st_["bps"])) if (st_ and st_["bps"] > 500) else ""
        cc = (P["grn"] if due < 20480 else
              P["yel"] if due < 81920 else P["red"])
        print("  %-7s %s%s" % (cat, cc("%8s" % kbs(due)), D(eta)))
        shown += 1
    if not shown:
        if unmeasured >= len(allsrc):   # never fetched is not the same as fresh
            print("  %-7s %s" % ("cold", D("nothing cached yet, first pull "
                                           "fetches everything")))
        else:
            print("  %-7s %s" % ("fresh", D("all feeds within ttl, 0B to refresh")))
    if unmeasured:
        print("  %-7s %s" % ("", D("%d feed%s not measured yet" % (
            unmeasured, "" if unmeasured == 1 else "s"))))

    days = sorted((st_ or {}).get("day", {}).items())[-7:]
    if days:
        today_ = (st_ or {})["day"].get(dt.date.today().isoformat(), 0)
        print("  %-7s %s %s" % ("data", D("%8s today" % kbs(today_)),
              D("%s over %dd" % (kbs(sum(v_ for _, v_ in days)), len(days)))))
    if verdict == "poor":
        print(D("  tip: lowpingnews --light skips the heavy feeds"))
    return


def run(a):
    OFFLINE[0] = bool(getattr(a, "offline", False))
    a.unit = "celsius" if getattr(a, "celsius", False) else "fahrenheit"
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        a.color = False
    elif os.name == "nt":                  # enable VT processing or go colourless
        try:
            import ctypes
            k = ctypes.windll.kernel32
            if not k.SetConsoleMode(k.GetStdHandle(-11), 7):
                a.color = False
        except Exception:
            a.color = False
    enc = (getattr(sys.stdout, "encoding", None) or "ascii").lower()
    if "utf" not in enc:
        a.ascii = True                    # LANG=C: box glyphs would raise mid-line
    try:
        sys.stdout.reconfigure(errors="replace")
    except Exception:
        pass
    a.n = max(1, min(50, a.n))
    acts = [x for x in (a.open, a.read, a.star) if x is not None]
    if len(acts) > 1:
        sys.exit("news: pick one of -o / -r / -S at a time")
    locs = [n for n, v in (("-p", getattr(a, "place", None)),
                           ("-c", getattr(a, "coords", None)),
                           ("-g", getattr(a, "gps", False)),
                           ("--ip", getattr(a, "iploc", False))) if v]
    if len(locs) > 1:                      # silently preferring one is a guess
        sys.exit("news: pick one location source, not %s" % " and ".join(locs))
    P = pal(a.color)
    D, B, C = P["d"], P["b"], P["cyn"]

    if getattr(a, "tui", False):
        return cmd_tui(a, P, D, explicit=True)

    if a.update is not None:
        return cmd_update(a,P,D)

    if a.list:
        allsrc = sources(argparse_ns({"only": None, "cat": "all"}))
        print(D("  categories: " +
                ", ".join(sorted({z for x in allsrc for z in x["cats"]})) + ", all"))
        w = cols_()
        for x in allsrc:
            cats = ",".join(x["cats"])
            # categories in full: with custom ones, a truncated column hid them
            print("  %s %s" % (C("%-9s" % x["id"][:9]), x["name"][:max(8, w - 13)]))
            print(D("            %s" % cats[:max(10, w - 13)]))
            print(D("            " + x["url"][:max(10, w - 13)]))
        print(D("\n  manage: lowpingnews catalog   or press f in the reader"))
        print(D("  edit:   %s" % CFG))
        return

    pick = a.open or a.read or a.star
    if pick is not None:
        return cmd_pick(a,P,D,pick)

    if a.download:
        return cmd_download(a,P,D)

    if a.mark_all:
        st = state()
        try:
            last = json.load(open(LAST, encoding="utf-8"))
        except Exception:
            last = []
        for it in last:
            if key(it["ti"]) not in st["read"]:
                st["read"].append(key(it["ti"]))
        state(st)
        print(D("  marked %d read" % len(last)))
        return

    st = state()
    rd = set(st["read"])

    if a.query or (a.cat or "").lower() == "saved":
        rows = []
        if a.query:
            q = a.query.lower()
            for x in sources(argparse_ns({"only": None, "cat": "all"})):
                try:
                    c = json.load(open("%s/%s.json" % (CD, x["id"]), encoding="utf-8"))
                except Exception:
                    continue
                for it in c.get("items", []):
                    if q in it["ti"].lower() or q in (it.get("s") or "").lower():
                        rows.append((x["name"], it))
        else:
            rows = [(it.get("src", "saved"), it) for it in reversed(st["star"])]
        show(a, rows, rd, "search: %s" % a.query if a.query else "saved",
             "%s no network" % bul_(a))
        return

    if (a.cat or "").lower() in ("radio", "noaa"):
        rc = jread(RADIOCF, {})
        mz = getattr(a, "marine", None)
        if mz:
            mz = mz.strip().upper()
            if mz in ("OFF", "NONE"):
                rc.pop("marine", None)
            elif not MARINE_ZONE.match(mz):
                sys.exit("news: a marine zone looks like ANZ335 (see weather.gov/marine)")
            else:
                rc["marine"] = mz
            jwrite(RADIOCF, rc)
        loc = wx_locate(a)
        r = nws_fetch(loc, a.fresh, rc.get("marine"))
        raise SystemExit(radio_show(a, P, loc, r))

    if (a.cat or "").lower() == "weather":
        loc = wx_locate(a)
        d, wire, age_s, stale = wx_fetch(loc, a.unit, a.fresh)
        wx_show(a, P, loc, d, wire, age_s, stale)
        return

    # location and radio flags mean nothing to the reader. Ignoring them
    # silently let `lowpingnews -p PLACE` look like it had moved the radio.
    misplaced = [f for f, k in (("-p", "place"), ("-c", "coords"), ("--label", "label"),
                                ("-g", "gps"), ("--ip", "iploc"), ("--marine", "marine"),
                                ("--full", "full")) if getattr(a, k, None)]
    if misplaced:
        sys.stderr.write("news: %s %s for weather and radio, not the news list. Try:\n"
                         "  lowpingnews weather %s ...\n  lowpingnews radio %s ...\n"
                         % (" ".join(misplaced), "is" if len(misplaced) == 1 else "are",
                            misplaced[0], misplaced[0]))
        raise SystemExit(2)

    if (a.cat or "").lower() == "signal":
        return cmd_signal(a,P,D)

    srcs = sources(a)
    # interactive by default, but only for a plain listing in a real terminal:
    # any flag that shapes or acts on the list, a pipe, or a dumb terminal keeps
    # the classic output, so `news | head`, -q, --stream and scripts behave
    if not getattr(a, "plain", False) and default_tui_ok(a) and tui_can_start():
        if cmd_tui(a, P, D, explicit=False):
            return

    if a.light:
        keep_ = []
        for x in srcs:
            w_ = jread("%s/%s.json" % (CD, x["id"]), {}).get("w")
            if w_ is None or w_ <= 30 * 1024:
                keep_.append(x)
        if keep_:
            skipped = len(srcs) - len(keep_)
            srcs = keep_
            if skipped:
                print(D("  --light: skipped %d heavy feed%s"
                        % (skipped, "" if skipped == 1 else "s")))
    if a.cost:
        print(P["hdr"]("COST") + D("  estimate from last known sizes, nothing fetched"))
        tot, unknown = 0, 0
        for x in srcs:
            c_ = jread("%s/%s.json" % (CD, x["id"]), {})
            w_, age_ = c_.get("w"), age_of(c_.get("t"))
            fresh_ = age_ < (x.get("ttl") or TTL)
            if w_ is None:
                unknown += 1
                print("  %-7s %s" % (x["id"],
                      D("unknown - not fetched since v2.4")))
                continue
            due = 0 if fresh_ else predict(w_)
            tot += due
            print("  %-7s %s %s" % (x["id"],
                  (P["grn"] if not due else P["yel"] if due < 40960 else P["red"])(
                      "%7s" % (kbs(due) if due else "cached")),
                  D("body %s%s" % (kbs(w_), "" if due else ", within ttl"))))
        print(D("  ~%s if refreshed now%s" % (kbs(tot),
                ", %d unknown" % unknown if unknown else "")))
        print(D("  each refresh pays ~%s of handshake even when nothing changed"
                % kbs(predict(0))))
        return
    if a.check:
        for x in srcs:
            t0 = time.time()
            try:
                raw, rh_, wire, _p = get(x["url"], 12)
                n = len(parse_hn(raw) if x["kind"] == "hn" else
                        parse_epmc(raw) if x["kind"] == "epmc" else parse_feed(raw))
                val = "v" if (rh_.get("ETag") or rh_.get("Last-Modified")) else "-"
                cost = P["grn"] if wire < 20480 else P["yel"] if wire < 81920 else P["red"]
                print("  %-6s %s %3di %s %s %s %4.1fs" % (
                    x["id"][:6], P["grn"]("ok ") if n else P["yel"]("nil"), n,
                    cost("%6s" % kbs(wire)), P["d"]("%6s" % kbs(len(raw))),
                    (P["grn"] if val == "v" else P["yel"])(val),
                    time.time() - t0))
            except Exception as e:
                print("  %-6s %s %s" % (x["id"][:6], P["red"]("err"),
                                        P["d"](str(e)[:max(10, cols_() - 14)])))
        return
    if a.offline:
        bag = {}
        for x in srcs:
            c_ = jread("%s/%s.json" % (CD, x["id"]), {})
            if c_.get("items"):
                bag[x["id"]] = (c_["items"], 0, (max(1, age_secs(c_.get("t"))) if age_secs(c_.get("t")) >= 0 else -3), 0, 0)
            else:
                bag[x["id"]] = ([], 0, -1, 0, 0)
    elif a.stream:
        import textwrap
        cols_s = cols_()
        now_ = dt.datetime.now()
        print(P["hdr"]("NEWS") + " " + P["cyn"]((a.cat or "top").lower()) +
              D("   %s %d %s %s" % (now_.strftime("%a"), now_.day,
                                    now_.strftime("%b"), clock(now_))))
        print()
        st_seen, st_keep, st_n = set(), [], [0]
        wrap_s = textwrap.TextWrapper(width=max(20, cols_s - 5),
                                      initial_indent="    ", subsequent_indent="    ")

        def emit(x, entry):
            items, nb, sta, unch, part_ = entry
            if sta == -1:
                print(D("  %s unreachable" % x["name"]))
                return
            for it in sorted(items, key=lambda z: -when_sort(z))[:a.n]:
                if getattr(a, "count", None) and st_n[0] >= a.count:
                    return                     # `top 13` streams thirteen
                k_ = key(it["ti"])
                if k_ in st_seen:
                    continue
                if a.unread and k_ in rd:
                    continue
                st_seen.add(k_)
                st_n[0] += 1
                r_ = dict(it)
                r_["src"] = x["name"]
                st_keep.append(r_)
                render_row(a, P, st_n[0], x["name"], it, rd, cols_s, wrap_s)
            sys.stdout.flush()              # a dying link should not lose buffered rows

        bag = gather(srcs, a.fresh, on_feed=emit)
        jwrite(LAST, st_keep)
    else:
        bag = gather(srcs, a.fresh)
        for x in srcs:                     # deadline hit with the worker stuck:
            got = bag.get(x["id"])         # a stale copy still beats nothing
            if got is not None and got[2] not in (-1, -2):
                continue
            c_ = jread("%s/%s.json" % (CD, x["id"]), {})
            if c_.get("items"):
                bag[x["id"]] = (c_["items"], 0,
                                (max(1, age_secs(c_.get("t"))) if age_secs(c_.get("t")) >= 0 else -3), 0, 0)
    try:
        cols = os.get_terminal_size().columns
    except Exception:
        cols = 46
    if cols < 24:
        cols = 46
    cols = min(cols, 100)

    if a.stream:                           # rows already printed as they arrived
        tot_b = sum(bag.get(x["id"], ([], 0, 0, 0, 0))[1] for x in srcs)
        dn = [x["name"] for x in srcs if bag.get(x["id"], ([], 0, -1, 0, 0))[2] == -1]
        wrapout("%d item%s %s %s%s%s" % (
            st_n[0], "" if st_n[0] == 1 else "s", bul_(a),
            spent(),
            stale_note([bag.get(x["id"], ([], 0, -1, 0, 0)) for x in srcs], a),
            (" %s down: %s" % (bul_(a), ", ".join(dn))) if dn else ""),
            P, cols_())
        return
    rows, seen, down, skipped, stale, bytes_, nm, partial_n = \
        [], set(), [], [], 0, 0, 0, 0
    # no count and no -n: the newest SHOW across every feed (each feed may
    # supply all of them), with the footer saying how many more there are
    by_default = getattr(a, "count", None) is None and getattr(a, "n", 5) in (None, 5)
    per_feed = None if by_default else a.n      # newest overall: every stored item competes
    for x in srcs:
        items, nb, sta, unch, part_ = bag.get(x["id"], ([], 0, -1, 0, 0))
        bytes_ += nb
        nm += unch
        partial_n += part_
        if sta == -2:
            skipped.append(x["name"])
            continue
        if sta == -1:
            down.append(x["name"])
            continue
        for it in sorted(items, key=lambda z: -when_sort(z))[:per_feed]:
            k = key(it["ti"])
            if k in seen:
                continue
            seen.add(k)
            rows.append((x["name"], it))
    rows.sort(key=lambda r: -when_sort(r[1]))
    want_n = getattr(a, "count", None) or (SHOW if by_default else None)
    total = len(rows)
    if want_n:
        rows = rows[:want_n]
    foot = "%s %s" % (bul_(a), spent())
    if by_default and total > len(rows):
        foot += " %s %d of %d: lowpingnews %s %d for more" % (
            bul_(a), len(rows), total, (a.cat or "top").lower(), min(total, len(rows) + MORE))
    if getattr(a, "count", None) and len(rows) < want_n:
        foot += " %s only %d of %d available" % (bul_(a), len(rows), want_n)
    if partial_n:
        foot += " %s %d truncated, salvaged" % (bul_(a), partial_n)
    if nm:
        foot += " %s %d unchanged (304)" % (bul_(a), nm)
    foot += stale_note([bag.get(x["id"], ([], 0, -1, 0, 0)) for x in srcs], a)
    if down:
        foot += " %s down: %s" % (bul_(a), ", ".join(down))
    if skipped:
        foot += " %s %d not reached (deadline)" % (bul_(a), len(skipped))
    show(a, rows, rd, (a.cat or "top").lower() if not a.only else a.only, foot)


def render_row(a, P, i, src, it, rd, cols, wrap):
    """One item, exactly as the batch view draws it. Shared so the streaming
    path and the sorted path can never render differently."""
    import textwrap
    D, B = P["d"], P["b"]
    bul = bul_(a)
    d0 = it.get("d") or 0
    if not d0:
        secs = -1                      # no date at all: distinct from any offset
    else:
        secs = int(time.time()) - d0
        if -3600 <= secs < 0:          # minor clock skew reads as now
            secs = 0
        elif secs < 0:                 # dated well ahead: the date is not usable
            secs = -1
    stamp = age(secs) if secs >= 0 else "?"
    k = key(it["ti"])
    unread = k not in rd
    offline = bool(it.get("c") or have(k))
    mark = ""
    if unread:
        mark += P["yel"]("*" if a.ascii else "\u25cf") + " "
    if offline:
        mark += P["grn"]("+" if a.ascii else "\u2193") + " "
    print(" %s %s %s %s" % (D("%2d" % i), srcpaint(src, a.color)(src), D(bul),
                            (agepaint(secs, P) if secs >= 0 else D)(stamp)))
    body_c = B if unread else D          # read items recede
    plain = ("%s%s" % ("*" if a.ascii else "\u25cf", " ") if unread else "")
    plain += ("%s%s" % ("+" if a.ascii else "\u2193", " ") if offline else "")
    lines = textwrap.wrap(plain + it["ti"], max(16, cols - 5)) or [plain]
    for j, ln in enumerate(lines):
        if j == 0 and plain:             # recolour the marker, keep the width
            print("    " + mark + body_c(ln[len(plain):]))
        else:
            print("    " + body_c(ln))
    if not a.titles and it.get("s"):
        body = wrap.wrap(it["s"])
        if len(body) > 2:
            body = body[:2]
            body[1] = body[1][:max(4, len(body[1]) - 1)].rstrip() + (
                "..." if a.ascii else "\u2026")
        for ln in body:
            print(D(ln))
    print()


def show(a, rows, rd, tag, foot):
    import textwrap
    P = pal(a.color)
    D, B = P["d"], P["b"]
    bul = bul_(a)
    cols = cols_()
    if a.unread:
        rows = [r for r in rows if key(r[1]["ti"]) not in rd]
    now = dt.datetime.now()
    print(P["hdr"]("NEWS") + " " + P["cyn"](tag) +
          D("   %s %d %s %s" % (now.strftime("%a"), now.day,
                                now.strftime("%b"), clock(now))))
    if not rows:
        print(D("  nothing to show " + foot))
        return
    print()
    keep, wrap = [], textwrap.TextWrapper(
        width=max(20, cols - 5), initial_indent="    ", subsequent_indent="    ")
    for i, (src, it) in enumerate(rows, 1):
        r = dict(it)
        r["src"] = src
        keep.append(r)
        render_row(a, P, i, src, it, rd, cols, wrap)
    jwrite(LAST, keep)
    n = len(keep)
    wrapout("%d item%s %s %s news -r N to read"
            % (n, "" if n == 1 else "s", foot, bul), P, cols)
    return


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.stderr.write("\n")
        sys.exit(130)
    except BrokenPipeError:
        try:
            os.close(1)
        except OSError:
            pass
        sys.exit(0)
