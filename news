#!/usr/bin/env python3
"""news - ultra-light terminal headlines. Parallel gzipped fetch, cached for offline."""
import datetime as dt, io, json, os, re, sys, time
# Everything else is imported lazily. urllib.request alone drags in email and
# http.client for ~100ms, and a cached run never opens a socket.

VERSION = "8.2"
def _base(env, win, fallback):
    """XDG where it exists, %APPDATA% on Windows, ~/... everywhere else."""
    v = os.environ.get(env)
    if v and os.path.isabs(v):
        return os.path.join(v, "lowpingnews")
    if os.name == "nt":
        w = os.environ.get(win) or os.environ.get("APPDATA")
        if w:
            return os.path.join(w, "lowpingnews")
    return os.path.expanduser(fallback)


DATA = _base("XDG_DATA_HOME", "LOCALAPPDATA", "~/.local/share/news")

ADIR = DATA + "/art"
NET = DATA + "/net.json"
# name, icon. Icons use only glyphs Unicode classes as one cell and fonts draw
# as text (sun, cloud, umbrella, snowflake, thunderstorm, fog), paired so every
# icon is exactly two cells. Weather emoji look nicer but several (🌤 🌧) are
# classed narrow while drawn wide, which shifts every column after them.
_S, _C, _R, _N, _T, _F = "\u2600", "\u2601", "\u2602", "\u2744", "\u2608", "\u224b"
WMO = {0: ("Clear", _S + " "), 1: ("Mostly Clear", _S + " "),
       2: ("Partly Cloudy", _S + _C), 3: ("Overcast", _C + _C),
       45: ("Fog", _F + _F), 48: ("Freezing Fog", _F + _N),
       51: ("Light Drizzle", _R + " "), 53: ("Drizzle", _R + " "),
       55: ("Heavy Drizzle", _R + _R), 56: ("Icy Drizzle", _R + _N),
       57: ("Icy Drizzle", _R + _N), 61: ("Light Rain", _R + " "),
       63: ("Rain", _R + " "), 65: ("Heavy Rain", _R + _R),
       66: ("Freezing Rain", _R + _N), 67: ("Freezing Rain", _R + _N),
       71: ("Light Snow", _N + " "), 73: ("Snow", _N + " "), 75: ("Heavy Snow", _N + _N),
       77: ("Snow Grains", _N + " "), 80: ("Light Showers", _S + _R),
       81: ("Showers", _S + _R), 82: ("Heavy Showers", _R + _R),
       85: ("Snow Showers", _S + _N), 86: ("Heavy Snowfall", _N + _N),
       95: ("Thunderstorm", _T + " "), 96: ("Thunder & Hail", _T + _N),
       99: ("Thunder & Hail", _T + _N)}
MOON = "\u263e "
WXNAMEMAX = max(len(v[0]) for v in WMO.values())    # 14: every name fits whole


def clock(d, short=False, hour=False):
    """A time of day as people say it: 3:05 PM, 3 PM, or 3p on a tight axis.
    LPN_CLOCK=24 keeps 24-hour time. d: a datetime, or epoch seconds (local)."""
    if isinstance(d, (int, float)):
        d = dt.datetime.fromtimestamp(d)
    if os.environ.get("LPN_CLOCK") == "24":
        return d.strftime("%H") if short else d.strftime("%H:00" if hour else "%H:%M")
    h12 = d.hour % 12 or 12
    ap = "am" if d.hour < 12 else "pm"
    if short:
        return "%d%s" % (h12, ap[0])
    if hour:
        return "%d %s" % (h12, ap.upper())
    return "%d:%02d %s" % (h12, d.minute, ap.upper())


def wx_label(code, ascii_, night=False):
    """-> (icon, words). The icon is two cells, or "" where Unicode cannot show."""
    name, icon = WMO.get(int(code or 0), ("Unknown", "? "))
    if night and int(code or 0) in (0, 1):
        icon = MOON
    return ("" if ascii_ else icon), name


SEV = {0: 0, 1: 1, 2: 2, 3: 3, 45: 4, 48: 4,
       51: 5, 53: 6, 55: 7, 56: 8, 57: 8,          # drizzle / freezing drizzle
       61: 6, 63: 8, 65: 10, 66: 11, 67: 11,       # rain / freezing rain
       71: 7, 73: 9, 75: 11, 77: 6,                # snow
       80: 7, 81: 9, 82: 11,                       # rain showers
       85: 9, 86: 11,                              # snow showers
       95: 13, 96: 14, 99: 14}                     # thunderstorm


def worst(codes):
    """Highest severity, not highest number: 80 (showers) < 75 (heavy snow)."""
    best, rank = None, -1
    for c in codes:
        r = SEV.get(int(c or 0), int(c or 0) // 10)
        if r > rank:
            best, rank = int(c or 0), r
    return best


