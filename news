TAGS = re.compile(r"<[^>]+>")
WS = re.compile(r"\s+")
CTRL = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")


def safe_url(u):
    """Item links end up in a browser. Same rule as feed URLs: http(s) only."""
    u = (u or "").strip()
    return u if u[:7].lower() == "http://" or u[:8].lower() == "https://" else ""


def clean(s, limit=400):
    if not s:
        return ""
    import html
    for _ in range(2):            # content:encoded arrives escaped: unescape, then strip
        s = TAGS.sub(" ", html.unescape(s))
    s = CTRL.sub(" ", s)               # a feed must not emit escapes or NULs
    s = WS.sub(" ", s).strip()
    s = re.sub(r" +([,.;:!?%)\]])", r"\1", s)      # tag-stripping leaves gaps
    s = re.sub(r"([(\[]) +", r"\1", s)
    return s[:limit]


def when(s):
    """RSS pubDate or Atom ISO timestamp -> epoch seconds, 0 if unparseable."""
    if not s:
        return 0
    s = s.strip()
    import email.utils
    try:
        d = email.utils.parsedate_to_datetime(s)
        if d.tzinfo is None:           # legal in RSS; .timestamp() would assume local
            d = d.replace(tzinfo=dt.timezone.utc)
        return int(d.timestamp())
    except Exception:
        pass
    # dc:date routinely carries a bare date; time and zone are both optional
    m = re.match(r"(\d{4})-(\d\d)-(\d\d)"
                 r"(?:[T ](\d\d):(\d\d)(?::(\d\d))?(?:\.\d+)?)?"
                 r"\s*(Z|z|[+-]\d\d:?\d\d)?\s*$", s)
    if not m:
        m2 = re.match(r"(\d{4})/(\d\d)/(\d\d)\s*$", s) or \
             re.match(r"(\d{4})(\d\d)(\d\d)\s*$", s)
        if m2:
            try:
                return int(dt.datetime(int(m2.group(1)), int(m2.group(2)),
                                       int(m2.group(3)),
                                       tzinfo=dt.timezone.utc).timestamp())
            except Exception:
                return 0
        return 0
    try:
        y, mo, da = (int(x) for x in m.groups()[:3])
        hh, mi = int(m.group(4) or 0), int(m.group(5) or 0)
        ss = int(m.group(6) or 0)
        off = m.group(7)
        d = dt.datetime(y, mo, da, hh, mi, ss, tzinfo=dt.timezone.utc)
        if off and off not in ("Z", "z"):
            off = off.replace(":", "")
            mins = int(off[1:3]) * 60 + int(off[3:5])
            d -= dt.timedelta(minutes=mins if off[0] == "+" else -mins)
        return int(d.timestamp())
    except Exception:
        return 0


def state(w=None):
    if w is not None:
        w["read"] = w["read"][-4000:]
        jwrite(ST, w)
        return w
    v = jread(ST, {})
    if not isinstance(v.get("read"), list):
        v["read"] = []
    if not isinstance(v.get("star"), list):
        v["star"] = []
    return v


def apath(k):
    return "%s/%s.txt" % (ADIR, k)


def have(k):
    return os.path.exists(apath(k))


def store_article(k, txt, kind="abstract"):
    try:
        os.makedirs(ADIR, exist_ok=True)
        with open(apath(k), "w", encoding="utf-8") as fh:
            fh.write("\x01kind:%s\n" % kind)
            fh.write(txt)
    except Exception:
        return
    try:
        f = [(os.path.getmtime(ADIR + "/" + x), os.path.getsize(ADIR + "/" + x), x)
             for x in os.listdir(ADIR)]
    except OSError:
        return
    tot = sum(z[1] for z in f)
    for mt, sz, name in sorted(f):                  # evict oldest until under cap
        if tot <= ARTCAP:
            break
        try:
            os.remove(ADIR + "/" + name)
            tot -= sz
        except OSError:
            pass


KINDNOTE = {
    "full": ("full article", "grn"),
    "offline-full": ("full article, saved copy", "grn"),
    "abstract": ("abstract only - no full text available", "yel"),
    "offline-abstract": ("abstract only, saved copy", "yel"),
    "feed": ("feed summary only - no full text available", "yel"),
}


def kind_note(how, it=None):
    """Label for what a read produced; a saved copy also says how old it is."""
    note, col = KINDNOTE.get(how, (how, "d"))
    if it is not None and str(how).startswith("offline-"):
        try:
            a_ = age_of(os.path.getmtime(apath(key(it["ti"]))))
        except OSError:
            a_ = None
        if a_ is not None:
            note += ", age unknown" if a_ == float("inf") else ", saved %s" % ago(int(a_))
    return note, col


LISTOLD = 3600                 # -r/-o/-S on a list older than this gets a note


def list_age_note():
    """-r 3 means "item 3 of the last list you saw". If that list is old, the
    reader should know it is not today's item 3."""
    try:
        a_ = age_of(os.path.getmtime(LAST))
    except OSError:
        return ""
    if a_ == float("inf"):
        return "from a list of unknown age - run lowpingnews to refresh"
    if a_ > LISTOLD:
        return "from a list shown %s - run lowpingnews to refresh" % ago(int(a_))
    return ""


def preprint_id(u):
    """bioRxiv/medRxiv id from any link shape they use.

    Feeds have linked as /cgi/content/short/<id>?rss=1 as well as
    /content/10.1101/<id>; both carry the same id, and the full paper always
    lives at /content/10.1101/<id>.full on the matching host.
    """
    lu = (u or "").lower()
    host = ("medrxiv" if "medrxiv" in lu else
            "biorxiv" if "biorxiv" in lu else None)
    m = re.search(r"(\d{4}\.\d{2}\.\d{2}\.\d{5,}v\d+|(?<![\d.])\d{6}v\d+)", u or "")
    if not m:
        return None, None
    # hostname, or either path shape these servers use, marks a preprint
    if host is None and not re.search(r"/content/10\.\d+/|/cgi/content/short/", lu):
        return None, None
    return host or "biorxiv", m.group(1)


def full_text_urls(u):
    """Where a site keeps the whole article, best first."""
    base = (u or "").split("?")[0].split("#")[0].rstrip("/")
    host, pid = preprint_id(u)
    if pid:
        if host in ("biorxiv", "medrxiv") and ("%s.org" % host) in (u or "").lower():
            root = "https://www.%s.org" % host
        else:                                  # mirror or test server: same origin
            m = re.match(r"(https?://[^/]+)", base)
            root = m.group(1) if m else "https://www.biorxiv.org"
        full = "%s/content/10.1101/%s.full" % (root, pid)
        abstract = "%s/content/10.1101/%s" % (root, pid)
        return [full, abstract] if base != full else [full]
    if "europepmc.org/article/" in (u or "").lower():
        return [base + "#free-full-text", base]
    return [base or u]


def looks_complete(txt, url):
    """Full paper, or just an abstract? Judged, not guessed at random.

    A bioRxiv `.full` page carries the body sections; an abstract page is one
    block of a few hundred words. Elsewhere, length plus paragraph count is
    the only signal available without a site-specific parser.
    """
    if not txt:
        return False
    lu = (url or "").lower()
    paras = [p for p in txt.split("\n\n") if len(p) > 80]
    if "biorxiv.org" in lu or "medrxiv.org" in lu:
        # the body of a paper names its own sections
        marks = sum(1 for w in ("introduction", "results", "methods", "discussion",
                                "materials and methods", "conclusion")
                    if w in txt[:12000].lower())
        return marks >= 2 and len(txt) > 4000
    # a news article runs a few thousand characters over several paragraphs;
    # a paywall teaser or abstract is one or two blocks
    return len(txt) > 1200 and len(paras) >= 4


def fetch_article(it, want_full=True):
    """-> (text, bytes_over_wire, source). Feed body and saved copies are free.

    source: full, abstract, feed, nolink, or offline-<kind>. A saved abstract is
    not the end of the road: if a full-text address exists, it is tried first,
    and the saved copy is only the fallback.
    """
    LAST_WHY[:] = []                       # never show a previous read's reasons
    k = key(it["ti"])
    saved_kind, saved = None, ""
    if have(k):
        try:
            saved_kind, saved = _split_kind(open(apath(k), encoding="utf-8").read())
        except OSError:
            saved = ""
    if saved and (saved_kind == "full" or not want_full or OFFLINE[0]):
        return saved, 0, "offline-" + saved_kind
    if not it.get("u"):
        if saved:
            return saved, 0, "offline-" + saved_kind
        return (it["c"], 0, "feed") if it.get("c") else ("", 0, "nolink")
    urls = full_text_urls(it["u"])
    best, best_url, wire_tot, why = "", "", 0, []
    for u in urls:
        try:
            raw, _, wire, _p = get(u, 20, cap=PAGECAP)
        except Exception as e:
            code = getattr(e, "code", None)
            why.append("%s %s" % (u.rsplit("/", 1)[-1][:28],
                                  "HTTP %s" % code if code else str(e)[:24]))
            continue
        wire_tot += wire
        txt = extract(raw)[:ARTMAX]
        if len(txt) > len(best):
            best, best_url = txt, u
        if looks_complete(txt, u):
            break                              # got the paper; stop paying
        why.append("%s gave %d chars" % (u.rsplit("/", 1)[-1][:28], len(txt)))
    if not best:
        if saved:
            return saved, wire_tot, "offline-" + saved_kind
        if it.get("c"):
            return it["c"], wire_tot, "feed"
    kind = "full" if looks_complete(best, best_url) else "abstract"
    if best:
        store_article(k, best, kind)
    LAST_WHY[:] = why if kind != "full" else []
    return best, wire_tot, kind




def _split_kind(blob):
    """Stored articles carry their kind on the first line."""
    if blob.startswith("\x01kind:"):
        head, _, rest = blob.partition("\n")
        return head.split(":", 1)[1].strip() or "abstract", rest
    return "abstract", blob


_RD = [None]


def _readable():
    if _RD[0] is None:
        from html.parser import HTMLParser

        class Readable(HTMLParser):
            """Paragraph text only. No JS: paywalled pages come back empty."""
            SKIP = {"script", "style", "nav", "aside", "footer", "header", "form",
                    "noscript", "figure", "svg", "button", "select"}
            KEEP = {"p", "h1", "h2", "h3", "li", "blockquote"}

            def __init__(self):
                super().__init__(convert_charrefs=True)
                self.depth, self.cur, self.out = 0, [], []

            def handle_starttag(self, t, a):
                if t in self.SKIP:
                    self.depth += 1
                elif t in self.KEEP and not self.depth:
                    self.cur = []

            def handle_endtag(self, t):
                if t in self.SKIP and self.depth:
                    self.depth -= 1
                elif t in self.KEEP and not self.depth:
                    x = " ".join("".join(self.cur).split())
                    if len(x) > 40:
                        self.out.append(x)
                    self.cur = []

            def handle_data(self, d):
                if not self.depth:
                    self.cur.append(d)
        _RD[0] = Readable
    return _RD[0]


def _meta_fallback(txt):
    """Most sites embed the body in JSON-LD or a description tag. Already paid for."""
    import html as _h
    m = re.search(r'"articleBody"\s*:\s*"((?:[^"\\]|\\.)*)"', txt)
    if m:
        try:
            body = json.loads('"%s"' % m.group(1))
        except Exception:
            body = m.group(1)
        body = " ".join(body.split())
        if len(body) > 200:
            return body
    for pat in (r'<meta[^>]+property=["\']og:description["\'][^>]+content=["\']([^"\']{80,})',
                r'<meta[^>]+name=["\']description["\'][^>]+content=["\']([^"\']{80,})'):
        m = re.search(pat, txt, re.I)
        if m:
            return " ".join(_h.unescape(m.group(1)).split())
    return ""


def extract(raw):
    p = _readable()()
    try:
        p.feed(raw.decode("utf-8", "replace"))
    except Exception:
        pass
    out = "\n\n".join(p.out[:120])
    if len(out) < 200:            # paywalled or JS-rendered: try the embedded copy
        alt = _meta_fallback(raw.decode("utf-8", "replace"))
        if len(alt) > len(out):
            return alt
    return out


SKEW = 300                 # clocks disagree by this much without it meaning anything


def age_of(t):
    """Seconds since t. A stamp in the future means the clock was wrong when
    it was written; `now - t < ttl` would then call it fresh forever, so a
    future stamp counts as infinitely old instead. Missing or junk: same."""
    try:
        t = float(t or 0)
    except (TypeError, ValueError):
        return float("inf")
    if t <= 0:
        return float("inf")
    a = time.time() - t
    if a < -SKEW:
        return float("inf")
    return max(0.0, a)


def age_secs(t):
    """age_of() as an int for display; -3 means "age unknown"."""
    a = age_of(t)
    return -3 if a == float("inf") else int(a)


LAST_WHY = []              # why the last read got less than full text
OFFLINE = [False]          # set once from --offline; get() refuses while it holds

# What a request really costs. A body is the smallest part of it: every new
# connection pays a TCP handshake and a TLS handshake carrying the server's
# certificate chain. Measured against a live HTTPS server, a 304 with an empty
# body cost 6.7 KB on the wire with a fresh handshake and 3.8 KB with a resumed
# TLS session; of that, headers were ~0.8 KB and the rest was TCP+TLS. Bodies
# also pay packet framing: IP/TCP headers plus the ACKs sent back, ~6%.
# These are estimates - certificate chains and paths vary - so the app says "~".
EST_TLS_FULL = 5900
EST_TLS_RESUMED = 3000
EST_TCP_PLAIN = 900
EST_FRAMING = 0.05
NETSTAT = {"full": 0, "resumed": 0, "plain": 0, "est": 0, "body": 0}
TLS_SESS = {}              # host -> ssl session: a repeat connection resumes
PROBEWIN = 8192            # receive buffer for probes: caps what is in flight


def _small_window(address, timeout=None, source_address=None, *a, **kw):
    """create_connection with a small receive buffer, set BEFORE connecting so
    the advertised TCP window is small. A server that ignores Range then cannot
    stream far ahead of a probe that only wants the first few KB: measured,
    129 KB arrived for a 16 KB probe with the default window."""
    import socket
    host, port = address
    err = None
    for af, st, proto, _cn, sa in socket.getaddrinfo(host, port, 0, socket.SOCK_STREAM):
        sk = None
        try:
            sk = socket.socket(af, st, proto)
            sk.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, PROBEWIN)
            if timeout is not None:
                sk.settimeout(timeout)
            sk.connect(sa)
            return sk
        except OSError as e:
            err = e
            if sk is not None:
                sk.close()
    raise err or OSError("no address for %s" % host)


import threading as _thr
_PROBE = _thr.local()      # set while get() is fetching in probe (soft) mode
_OPENER = [None]


def _opener():
    """One TLS context for the whole process: a session can only be resumed
    with the context that created it, and urllib's default makes a new one
    per request, so nothing was ever resumed."""
    if _OPENER[0] is not None:
        return _OPENER[0]
    import http.client, ssl, urllib.request
    ctx = ssl.create_default_context()

    class Resuming(http.client.HTTPSConnection):
        def __init__(self, *a, **kw):
            http.client.HTTPSConnection.__init__(self, *a, **kw)
            if getattr(_PROBE, "on", False):
                self._create_connection = _small_window

        def connect(self):
            http.client.HTTPConnection.connect(self)      # also handles proxies
            host = getattr(self, "_tunnel_host", None) or self.host
            sess = TLS_SESS.get(host)
            try:
                self.sock = self._context.wrap_socket(self.sock, server_hostname=host,
                                                      session=sess)
            except (TypeError, ValueError):               # stale session or old Python
                self.sock = self._context.wrap_socket(self.sock, server_hostname=host)
            self._lpn_host = host
            NETSTAT["resumed" if getattr(self.sock, "session_reused", False)
                    else "full"] += 1

        def close(self):
            # called once the response headers are in: under TLS 1.3 the
            # resumption ticket arrives after the handshake, so take it now
            sk = self.sock
            if sk is not None and getattr(self, "_lpn_host", None):
                try:
                    if sk.session is not None:
                        TLS_SESS[self._lpn_host] = sk.session
                except Exception:
                    pass
            http.client.HTTPSConnection.close(self)

    class Handler(urllib.request.HTTPSHandler):
        def https_open(self, req):
            return self.do_open(Resuming, req, context=self._context)

    class PlainConn(http.client.HTTPConnection):
        def __init__(self, *a, **kw):
            http.client.HTTPConnection.__init__(self, *a, **kw)
            if getattr(_PROBE, "on", False):
                self._create_connection = _small_window

    class Plain(urllib.request.HTTPHandler):
        def http_open(self, req):
            NETSTAT["plain"] += 1
            return self.do_open(PlainConn, req)

    _OPENER[0] = urllib.request.build_opener(Handler(context=ctx), Plain())
    return _OPENER[0]


def vkey(v):
    """'6.10' sorts after '6.9'; anything unparseable sorts first."""
    try:
        return tuple(int(p) for p in str(v).split("."))
    except ValueError:
        return (-1,)


def spent():
    """What this run actually cost the data plan, estimated, for footers."""
    e = NETSTAT["est"]
    return "0B, cached" if not e else "~%s" % kbs(e)


def predict(body_bytes, url=None):
    """Cost of one request on a fresh connection: the handshake is paid even if
    the server answers 304; the body only if it changed."""
    kind = "plain" if (url or "").lower().startswith("http://") else "full"
    return est_wire(body_bytes or 0, 300, 500, kind)


def est_wire(body_bytes, req_hdr, resp_hdr, kind):
    """Estimated bytes on the wire for one request."""
    base = {"full": EST_TLS_FULL, "resumed": EST_TLS_RESUMED,
            "plain": EST_TCP_PLAIN}.get(kind, EST_TLS_FULL)
    return int(base + req_hdr + resp_hdr + body_bytes * (1 + EST_FRAMING))


class OfflineError(OSError):
    pass


LAST_URL = [""]            # where the last get() actually ended up, after redirects


class ResumeMismatch(ValueError):
    """The server answered a resume with bytes that do not continue ours."""


def strong_validator(headers):
    """A validator that promises byte-identical bodies, or None. Servers that
    compress on the fly mark their ETags weak (W/), which is exactly the case
    where splicing two downloads together would be unsafe."""
    et = (headers.get("ETag") or "").strip()
    if et and not et.startswith("W/"):
        return et
    enc = (headers.get("Content-Encoding") or "").lower()
    if headers.get("Last-Modified") and enc in ("", "identity"):
        return headers["Last-Modified"]
    return None


def get(url, t=10, extra=None, cap=FEEDCAP, tap=None, soft=False, until=None,
        resume=None, raw_out=None):
    """-> (body, headers, wire_bytes, partial). Raises HTTPError(304) when unchanged.
    resume={"raw", "v", "enc"} asks only for the bytes after the ones we have,
    guarded by If-Range: a changed document comes back whole, never spliced.
    raw_out, a dict, receives the raw received bytes so a cut transfer can
    be resumed later."""
    if OFFLINE[0]:
        # one choke point: a caller that forgets --offline cannot reach the net
        raise OfflineError("offline")
    h = {"Accept-Encoding": "gzip, deflate", "User-Agent": UA}
    h.update(extra or {})
    if resume:
        h["Range"] = "bytes=%d-" % len(resume["raw"])
        h["If-Range"] = resume["v"]
        for k in ("If-None-Match", "If-Modified-Since"):
            h.pop(k, None)                 # If-Range does the validating
    import urllib.error, urllib.parse, urllib.request, zlib
    if urllib.parse.urlsplit(url).scheme not in ("http", "https"):
        raise ValueError("refusing non-http url")
    r = urllib.request.Request(url, headers=h)
    before = (NETSTAT["full"], NETSTAT["resumed"], NETSTAT["plain"])
    req_hdr = len(url) + 20 + sum(len(k) + len(v) + 4 for k, v in h.items())

    def account(body_len, resp_headers):
        now_ = (NETSTAT["full"], NETSTAT["resumed"], NETSTAT["plain"])
        kind = ("full" if now_[0] > before[0] else "resumed" if now_[1] > before[1]
                else "plain" if now_[2] > before[2] else "full")
        try:
            rh = 30 + sum(len(k) + len(v) + 4 for k, v in resp_headers.items())
        except Exception:
            rh = 500
        e = est_wire(body_len, req_hdr, rh, kind)
        NETSTAT["est"] += e
        NETSTAT["body"] += body_len
        return e
    _PROBE.on = bool(soft)
    try:
        f = _opener().open(r, timeout=t)
    except urllib.error.HTTPError as he:
        account(0, he.headers or {})              # a 304 is not free: it paid a handshake
        raise
    finally:
        _PROBE.on = False
    with f:
        # Read in chunks and keep whatever arrived. On a dying link the useful
        # question is not "did it finish" but "how much of it is usable".
        import http.client
        buf, partial = bytearray(), False      # the prefix joins after the read
        # `until` looks at what the bytes SAY: if they arrive compressed (servers
        # gzip ranged responses too), test the decompressed stream, or a marker
        # like </head> never matches and the read runs on to the cap
        enc_ = (f.headers.get("Content-Encoding") or "").lower()
        prefix = b""
        if resume:
            status_ = getattr(f, "status", None) or f.getcode()
            if status_ == 206:
                cr = (f.headers.get("Content-Range") or "").replace(" ", "")
                if not cr.startswith("bytes%d-" % len(resume["raw"])) or \
                        enc_ != (resume.get("enc") or ""):
                    raise ResumeMismatch("resume did not continue the same bytes")
                prefix = resume["raw"]
            # a 200 means the document changed or ranges are ignored: take it whole
        dz = None
        if until is not None and enc_ in ("gzip", "x-gzip", "deflate"):
            dz = zlib.decompressobj(16 + zlib.MAX_WBITS if "gzip" in enc_ else zlib.MAX_WBITS)
        seen_ = bytearray()
        try:
            while True:
                # near a soft cap, read only what is still wanted: a 64 KB read
                # pulls (and pays for) far more than a probe keeps
                chunk = f.read(65536 if not soft else max(1, min(4096, cap - len(buf) + 1)))
                if not chunk:
                    break
                buf += chunk
                if tap:
                    tap(len(buf))         # live byte count for the progress bar
                if until is not None:
                    if dz is not None:
                        try:
                            seen_ += dz.decompress(bytes(chunk), 1 << 20)
                        except zlib.error:
                            dz, seen_ = None, buf    # not really compressed
                    view = seen_ if dz is not None else buf
                    if until(bytes(view)):
                        partial = True    # got what was wanted: stop paying
                        break
                if len(buf) > cap:
                    if soft:              # a probe: keep the head, stop paying
                        partial = True
                        del buf[cap:]
                        break
                    raise ValueError("response exceeds %s cap" % kbs(cap))
            if getattr(f, "length", None):       # server promised more than it sent
                partial = True
        except ValueError:
            raise
        except http.client.IncompleteRead as e:
            buf += e.partial                     # the bytes are on the exception
            partial = True
        except Exception:
            if not buf:
                raise                            # nothing arrived: a real failure
            partial = True
        got_now = len(buf)                     # bytes this request carried
        b = prefix + bytes(buf)
        if raw_out is not None:
            raw_out.update({"raw": b, "enc": enc_, "v": strong_validator(f.headers),
                            "cut": bool(partial and not soft and until is None),
                            "resumed": bool(prefix)})
        stopped_early = bool(partial and (soft or until is not None))
        try:
            LAST_URL[0] = f.geturl()
        except Exception:
            LAST_URL[0] = url
        wire = got_now                    # compressed bytes received; resumed ones were paid before
        # stopping early does not recall what is already in flight: up to a
        # receive window more arrives and is billed. Measured ~9 KB at PROBEWIN.
        account(wire + (PROBEWIN + 1024 if stopped_early else 0), f.headers)
        ce = (f.headers.get("Content-Encoding") or "").lower()
        if ce in ("gzip", "deflate", "x-gzip"):
            for wbits in ((16 + zlib.MAX_WBITS,) if "gzip" in ce
                          else (zlib.MAX_WBITS, -zlib.MAX_WBITS)):
                try:
                    z = zlib.decompressobj(wbits)
                    out = z.decompress(b, cap + 1)   # bounded: a bomb stops here
                    if z.unconsumed_tail and not soft:
                        raise ValueError("decompressed body exceeds %s cap" % kbs(cap))
                    b = out                          # truncated gzip still yields
                    break                            # every complete block so far
                except zlib.error:
                    continue                  # raw deflate vs zlib-wrapped: try both
        return b, f.headers, wire, partial


def parse_feed(raw):
    """RSS 2.0, RSS 1.0/RDF and Atom, without caring which one showed up."""
    import xml.etree.ElementTree as ET
    try:
        root = ET.fromstring(raw)
    except ET.ParseError:
        loose = parse_loose(raw)
        if loose:
            return loose
        raise
    for el in root.iter():                       # drop namespaces, then treat alike
        if "}" in el.tag:
            el.tag = el.tag.split("}", 1)[1]
    out = []
    for it in list(root.iter("item")) + list(root.iter("entry")):
        def txt(*names):
            for n in names:
                e = it.find(n)
                if e is not None and e.text and e.text.strip():
                    return e.text
            return ""
        link = ""
        for l in it.iter("link"):
            if l.get("href"):                    # Atom: prefer rel=alternate
                if l.get("rel", "alternate") == "alternate":
                    link = l.get("href")
                    break
                link = link or l.get("href")
            elif l.text and l.text.strip():
                link = l.text.strip()
                break
        ti = clean(txt("title"), 200)
        if not ti:
            continue
        short = clean(txt("description", "summary", "content"))
        full = clean(txt("encoded", "content", "description"), 6000)
        rec = {"ti": ti, "u": safe_url(link), "s": short,
               "d": when(txt("pubDate", "published", "date", "updated",
                             "publicationDate", "issued", "created", "modified"))}
        if len(full) > len(short) + 200:      # feed shipped the body: already paid for
            rec["c"] = full
        out.append(rec)
    return out


def parse_loose(raw):
    """Last resort for feeds with invalid XML. Real feeds are often slightly broken."""
    txt = raw.decode("utf-8", "replace")
    out = []
    for m in re.finditer(r"<(item|entry)\b[^>]*>(.*?)</\1>", txt, re.S | re.I):
        blk = m.group(2)

        def g(*names):
            for n in names:
                mm = re.search(r"<%s\b[^>]*>(.*?)</%s>" % (n, n), blk, re.S | re.I)
                if mm and mm.group(1).strip():
                    return mm.group(1)
            return ""
        ti = clean(g("title"), 200)
        if not ti:
            continue
        link = g("link").strip()
        if not link:
            mm = re.search(r'<link[^>]*href=["\']([^"\']+)', blk, re.I)
            link = mm.group(1) if mm else ""
        out.append({"ti": ti, "u": safe_url(link),
                    "s": clean(g("description", "summary")),
                    "d": when(g("pubDate", "published", "date", "updated",
                                "publicationDate", "issued"))})
        if len(out) > 200:
            break
    return out


def parse_epmc(raw):
    """Europe PMC REST search: one JSON request, covers PubMed and preprints."""
    j = json.loads(raw)
    out = []
    for r in (j.get("resultList") or {}).get("result", []):
        ti = clean(r.get("title") or "", 200)
        if not ti:
            continue
        doi, pmid = r.get("doi"), r.get("pmid")
        url = ("https://doi.org/" + doi if doi else
               "https://pubmed.ncbi.nlm.nih.gov/%s/" % pmid if pmid else
               "https://europepmc.org/article/%s/%s" % (r.get("source", "MED"),
                                                        r.get("id", "")))
        bits = [b for b in (r.get("journalTitle"), r.get("authorString")) if b]
        out.append({"ti": ti, "u": safe_url(url),
                    "s": clean(" - ".join(bits), 300),
                    "d": when(r.get("firstPublicationDate")
                              or r.get("pubYear") or "")})
    return out


def parse_hn(raw):
    j = json.loads(raw)
    out = []
    for h in j.get("hits", []):
        pts, nc = h.get("points") or 0, h.get("num_comments") or 0
        out.append({
            "ti": clean(h.get("title") or h.get("story_title") or "", 200),
            "u": safe_url(h.get("url")) or ("https://news.ycombinator.com/item?id=%s"
                                            % h.get("objectID", "")),
            "s": "%d points, %d comments" % (pts, nc),
            "d": int(h.get("created_at_i") or 0)})
    return out


def transient(e):
    """Is this the kind of failure a flickering signal causes, worth retrying?
    A refused connection, a bad certificate or a name that does not exist is
    a definite answer: retrying it only stalls - a dead feed once cost every
    load 2.4 s of pointless retries."""
    import errno, socket, http.client
    r = getattr(e, "reason", None) or e          # urllib wraps the real cause
    if isinstance(r, str):
        return "timed out" in r.lower()
    if isinstance(r, ConnectionRefusedError):
        return False
    if isinstance(r, socket.gaierror):
        return getattr(r, "errno", None) == getattr(socket, "EAI_AGAIN", -3)
    if isinstance(r, (socket.timeout, TimeoutError, ConnectionResetError, ConnectionAbortedError,
                      BrokenPipeError, http.client.RemoteDisconnected, http.client.IncompleteRead)):
        return True
    if isinstance(r, OSError):
        return getattr(r, "errno", None) in (errno.ENETUNREACH, errno.EHOSTUNREACH, errno.ENETDOWN,
                                              errno.ETIMEDOUT, errno.ECONNRESET, errno.ECONNABORTED)
    return False


def ttl_eff(src, c):
    """Check quiet feeds less often. Every check that finds nothing new doubles
    the wait, to 8x (15 min -> 2 h); any change snaps it back. A check that
    finds nothing still pays a handshake (~6.7 KB), so this is the biggest
    saving there is. Alert feeds never back off; -f always fetches."""
    base = src.get("ttl") or TTL
    if not c or "alerts" in (src.get("cats") or []):
        return base
    q = max(0, min(int(c.get("q") or 0), 3))
    return min(base * (2 ** q), max(base, TTLMAX))


DNSF = os.path.join(CD, "dns.json")
DNSAGE = 14 * 86400
_DNS = {"c": None, "dirty": False}


def dns_install():
    """A failed lookup falls back to the last address that worked for that
    host. On a weak signal the lookup is often the step that fails - one lost
    packet stalls it for seconds - while a connection would have got through.
    Healthy lookups always win: CDNs rotate addresses, so this is never used
    to skip DNS, only to survive it failing."""
    import socket, atexit, ipaddress
    real = socket.getaddrinfo
    if getattr(real, "_lpn", False):
        return
    if _DNS["c"] is None:
        _DNS["c"] = jread(DNSF, {})
        if not isinstance(_DNS["c"], dict):
            _DNS["c"] = {}

    def literal(h):
        try:
            ipaddress.ip_address(str(h).split("%")[0])
            return True
        except ValueError:
            return False

    def gai(host, port, family=0, type=0, proto=0, flags=0):
        h = host.decode() if isinstance(host, bytes) else host
        try:
            res = real(host, port, family, type, proto, flags)
        except socket.gaierror:
            ent = _DNS["c"].get(h) if isinstance(h, str) else None
            if not ent or age_of(ent.get("t")) >= DNSAGE:
                raise
            NETSTAT["dnsfb"] = NETSTAT.get("dnsfb", 0) + 1
            p = int(port) if str(port or "").isdigit() else 0
            out = []
            for fam, ip in ent.get("a") or []:
                if family and fam != family:
                    continue
                addr = (ip, p) if fam == socket.AF_INET else (ip, p, 0, 0)
                out.append((fam, type or socket.SOCK_STREAM, proto or 6, "", addr))
            if not out:
                raise
            return out
        if isinstance(h, str) and h and not literal(h):
            addrs = [[r[0], r[4][0]] for r in res if r[0] in (socket.AF_INET, socket.AF_INET6)][:4]
            ent = _DNS["c"].get(h) or {}
            if addrs and (ent.get("a") != addrs or age_of(ent.get("t")) > 86400):
                _DNS["c"][h] = {"a": addrs, "t": int(time.time())}
                _DNS["dirty"] = True
        return res
    gai._lpn = True
    socket.getaddrinfo = gai

    def save():
        if _DNS["dirty"]:
            c_ = _DNS["c"]
            if len(c_) > 200:                  # keep the most recently confirmed
                c_ = dict(sorted(c_.items(), key=lambda kv: -int(kv[1].get("t") or 0))[:200])
            jwrite(DNSF, c_)
    atexit.register(save)


def drop_part(cf):
    try:
        os.remove(cf[:-5] + ".part")
    except OSError:
        pass


def load(src, fresh, bag):
    """Fetch or reuse one source. Never raises - records the failure instead."""
    cf = "%s/%s.json" % (CD, src["id"])
    ttl = src.get("ttl") or TTL
    c = jread(cf, {})                      # once: it decides freshness and validators
    if not isinstance(c.get("items"), list):
        c = None
    if c is not None and not fresh and age_of(c.get("t")) < ttl_eff(src, c):
        bag[src["id"]] = (c["items"], 0, 0, 0, 0)     # a future stamp is not fresh
        return
    import urllib.error
    val = {}
    if c:                                  # conditional GET: 304 costs ~0 bytes
        if c.get("et"):
            val["If-None-Match"] = c["et"]
        if c.get("lm"):
            val["If-Modified-Since"] = c["lm"]
        elif age_of(c.get("t")) != float("inf"):
            # no server validator: ask with our own - but never a future date,
            # which invites a 304 and freezes the cache even under -f
            import email.utils
            val["If-Modified-Since"] = email.utils.formatdate(
                min(float(c["t"]), time.time()), usegmt=True)
    t_start = time.time()
    tapper = lambda n: PROG.__setitem__(src["id"], n)
    PROG.setdefault(src["id"], 0)
    # bytes kept from a transfer that was cut last time: ask only for the rest
    resume = None
    rs = (c or {}).get("rs")
    if rs:
        try:
            raw_p = open(cf[:-5] + ".part", "rb").read()
            if len(raw_p) == rs.get("n") and age_of(rs.get("t")) < PARTTTL and rs.get("v"):
                resume = {"raw": raw_p, "v": rs["v"], "enc": rs.get("enc", "")}
        except (OSError, TypeError):
            pass
    ro = {}
    try:
        try:
            trim = c.get("trim", 2) if c else 2
            probe = dict(c or {}, trim=trim)
            fails, resumes, loops, wire_tot = 0, 0, 0, 0
            while True:
                loops += 1
                if loops > 8:
                    raise ValueError("gave up after repeated attempts")
                ro = {}
                try:
                    raw, rh, wire, part = get(request_url(src, probe), extra=val, tap=tapper,
                                              t=src.get("timeout") or 10, resume=resume, raw_out=ro)
                except urllib.error.HTTPError as he_:
                    # a server that rejects the trimmed query: step down once
                    if he_.code == 400 and src.get("kind") == "hn" and probe["trim"] > 0:
                        probe["trim"] -= 1
                        continue
                    if he_.code == 416 and resume:     # our kept bytes do not fit: start over
                        resume = None
                        drop_part(cf)
                        continue
                    raise                  # a real HTTP answer: do not retry
                except ResumeMismatch:
                    resume = None              # never splice: fetch it whole instead
                    drop_part(cf)
                    continue
                except Exception as e_:
                    # nothing arrived at all: a weak signal flickers, so try again
                    # after a pause - but only while there is time for it, and
                    # only for failures a flicker causes
                    if not transient(e_):
                        raise
                    fails += 1
                    if fails > len(RETRY_GAPS) or time.time() - t_start > RETRY_WINDOW:
                        raise
                    time.sleep(RETRY_GAPS[fails - 1])
                    continue
                wire_tot += wire
                # cut partway? continue from where it stopped, while there is time
                if part and ro.get("cut") and ro.get("v") and len(ro["raw"]) >= RESUME_MIN \
                        and resumes < 2 and time.time() - t_start < RETRY_WINDOW:
                    resumes += 1
                    resume = {"raw": ro["raw"], "v": ro["v"], "enc": ro["enc"]}
                    continue
                break
            wire = wire_tot
            trim = probe["trim"]
        except urllib.error.HTTPError as he:
            if he.code == 304 and c:
                c["t"] = int(time.time())
                c["q"] = int(c.get("q") or 0) + 1      # quiet: check less often
                jwrite(cf, c)
                bag[src["id"]] = (c["items"], 0, 0, 1, 0)
                DONE.add(src["id"])
                bag.setdefault("_net", []).append(
                    (True, (time.time() - t_start) * 1000, 0))
                return
            raise
        try:
            kind_ = src["kind"]
            items = (parse_hn(raw) if kind_ == "hn" else
                     parse_epmc(raw) if kind_ == "epmc" else parse_feed(raw))
        except Exception:
            if not part:
                raise
            items = parse_loose(raw)      # truncated: keep the items that closed
        items = [i for i in items if i["ti"]]
        items = sorted(items, key=lambda z: -when_sort(z))[:STORECAP]
        if not items:
            raise ValueError("no items parsed")
        rec = {"t": int(time.time()), "items": items, "w": wire}
        if not part and c:
            same = [key(x["ti"]) for x in (c.get("items") or [])[:5]] == \
                   [key(x["ti"]) for x in items[:5]]
            rec["q"] = (int(c.get("q") or 0) + 1) if same else 0
        if part and ro.get("cut") and ro.get("v") and len(ro.get("raw") or b"") >= RESUME_MIN:
            try:                           # keep the bytes: next time ask for the rest
                with open(cf[:-5] + ".part", "wb") as fh:
                    fh.write(ro["raw"])
                rec["rs"] = {"n": len(ro["raw"]), "v": ro["v"], "enc": ro["enc"], "t": int(time.time())}
                # finishing costs only the missing bytes now: due again at once
                rec["due_now"] = 1
            except OSError:
                pass
        else:
            drop_part(cf)
        if src.get("kind") == "hn":
            rec["trim"] = trim             # remember what this server accepts
        if part:
            # Never store validators for a truncated body: a later 304 would
            # confirm a copy we never fully received. Also expire it quickly.
            rec["p"] = 1
            rec["t"] = int(time.time()) - max(0, (src.get("ttl") or TTL) - 120)
            if rec.pop("due_now", None):
                rec["t"] = int(time.time()) - (src.get("ttl") or TTL)
        else:
            if rh.get("ETag"):
                rec["et"] = rh["ETag"]
            if rh.get("Last-Modified"):
                rec["lm"] = rh["Last-Modified"]
        jwrite(cf, rec)
        PROG[src["id"]] = wire
        bag[src["id"]] = (items, wire, 0, 0, 1 if part else 0)
        DONE.add(src["id"])
        bag.setdefault("_net", []).append((True, (time.time() - t_start) * 1000, wire))
    except Exception as e:
        if os.path.exists(cf):                      # offline: stale beats nothing
            try:
                c = json.load(open(cf, encoding="utf-8"))
                bag[src["id"]] = (c["items"], 0, max(1, age_secs(c.get("t"))) if age_secs(c.get("t")) >= 0 else -3, 0, 0)
                DONE.add(src["id"])
                bag.setdefault("_net", []).append(      # still a failed request:
                    (False, (time.time() - t_start) * 1000, 0))   # count it as one
                return
            except Exception:
                pass
        bag[src["id"]] = ([], 0, -1, 0, 0)
        DONE.add(src["id"])
        bag.setdefault("_net", []).append((False, (time.time() - t_start) * 1000, 0))
        bag.setdefault("_err", {})[src["id"]] = str(e)[:60]


PROG = {}          # src id -> bytes so far; dict writes are atomic under the GIL
DONE = set()       # ids that finished, however they finished


def expected(srcs):
    """Snapshot once: these cache files get rewritten while the fetch runs."""
    tot = 0
    for x in srcs:
        w = jread("%s/%s.json" % (CD, x["id"]), {}).get("w")
        tot += w if w else 0
    return tot


def progress_line(srcs, cols, want, t0=None):
    """One-line status: real percentage when we know what the feeds usually cost."""
    got = sum(PROG.get(x["id"], 0) for x in srcs)
    done = [x for x in srcs if x["id"] in DONE]
    live = [x["id"] for x in srcs if x["id"] not in DONE and PROG.get(x["id"])]
    frac = (min(1.0, got / float(want)) if want else
            len(done) / float(len(srcs) or 1))
    w_bar = max(6, min(14, cols - 30))
    fill = int(frac * w_bar)
    bar = "\u2588" * fill + "\u00b7" * (w_bar - fill)
    el = (" %ds" % int(time.time() - t0)) if t0 else ""
    txt = "  [%s] %d/%d %s%s%s" % (bar, len(done), len(srcs), kbs(got),
                                   ("/~" + kbs(want)) if want else "", el)
    if live:
        txt += " " + ",".join(live[:2])
    return txt[:cols - 1]


def net_log(entries):
    if not entries:
        return
    d = jread(NET, {})
    log = d.get("log") or []
    day = d.get("day") or {}
    today = dt.date.today().isoformat()
    for ok, ms, wire in entries:
        log.append([int(time.time()), 1 if ok else 0, int(ms), int(wire)])
        day[today] = day.get(today, 0) + int(wire)
    d["log"] = log[-NETCAP:]
    for k in list(day):                    # keep a fortnight of daily totals
        if k < (dt.date.today() - dt.timedelta(days=14)).isoformat():
            day.pop(k, None)
    d["day"] = day
    jwrite(NET, d)


def net_stats(window=1800):
    d = jread(NET, {})
    log = d.get("log") or []
    cut = time.time() - window
    recent = [r for r in log if r[0] >= cut]        # a 20-minute-old outage is
    if len(recent) < 5:                             # not this connection
        recent = log[-12:]
    if not recent:
        return None
    ok = [r for r in recent if r[1]]
    rate = 100.0 * len(ok) / len(recent)
    lat = sorted(r[2] for r in ok) or [0]
    med = lat[len(lat) // 2]
    tp = sorted((r[3] * 1000.0 / r[2]) for r in ok if r[2] > 0 and r[3] > 0)
    return {"n": len(recent), "rate": rate, "ms": med, "win": window,
            "bps": (tp[len(tp) // 2] if tp else 0), "day": d.get("day") or {}}


def hostport(url):
    """(host, port) from a feed URL. Probing a hardcoded 443 reports a plain-http
    or non-standard-port feed as unreachable, which is worse than not probing."""
    rest = url.split("//", 1)[-1].split("/", 1)[0]
    default = 443 if url.lower().startswith("https") else 80
    if rest.startswith("["):                      # IPv6 literal
        h, _, tail = rest.partition("]")
        return h[1:], int(tail[1:]) if tail.startswith(":") and tail[1:].isdigit() else default
    if ":" in rest:
        h, _, p = rest.rpartition(":")
        if p.isdigit():
            return h, int(p)
    return rest, default


def probe(targets, n=3):
    """DNS + TCP connect to the hosts we actually fetch from. No ICMP: carriers
    drop it independently of TCP, and it skips DNS, which is the usual killer
    on a lossy link. Costs a SYN/ACK per attempt, no TLS, no payload."""
    import socket
    res = []
    for h, port in targets:
        dns, tcp, fails, cold = [], [], 0, None
        for i in range(n):
            t0 = time.time()
            try:
                socket.getaddrinfo(h, port, 0, socket.SOCK_STREAM)
                t1 = time.time()
                if cold is None:
                    cold = (t1 - t0) * 1000     # first lookup only: rest are cached
                dns.append((t1 - t0) * 1000)
                c = socket.create_connection((h, port), timeout=6)
                tcp.append((time.time() - t1) * 1000)
                c.close()
            except Exception:
                fails += 1
        med = lambda v: sorted(v)[len(v) // 2] if v else None
        res.append({"host": h, "port": port, "dns_cold": cold, "dns": med(dns),
                    "tcp": med(tcp), "loss": 100.0 * fails / n})
    return res


def pingcmd(n, host):
    if os.name == "nt":
        return ["ping", "-n", str(n), "-w", "2000", host]
    if sys.platform == "darwin":
        return ["ping", "-c", str(n), "-W", "2000", host]   # macOS: milliseconds
    return ["ping", "-c", str(n), "-W", "2", host]          # Linux/BSD: seconds


def icmp(host, n=3):
    """Supplementary only, and absent on most Termux installs."""
    import shutil, subprocess
    if not shutil.which("ping"):
        return None
    try:
        r = subprocess.run(pingcmd(n, host), stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE, timeout=12)
    except Exception:
        return None
    out = r.stdout.decode("utf-8", "replace")
    m = re.search(r"(\d+(?:\.\d+)?)% (?:packet )?loss", out)
    t = re.search(r"=\s*[\d.]+/([\d.]+)/", out)
    if not m:
        return None
    return {"loss": float(m.group(1)), "avg": float(t.group(1)) if t else None}


def radio():
    """Best-effort. termux-api is optional and these calls are slow-ish, so this
    is only invoked by `news signal`, never on a normal run."""
    import shutil, subprocess
    out = []
    for cmd, want in (("termux-wifi-connectioninfo", "wifi"),
                      ("termux-telephony-cellinfo", "cell")):
        if not shutil.which(cmd):
            continue
        try:
            r = subprocess.run([cmd], stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, timeout=6)
            j = json.loads(r.stdout.decode("utf-8", "replace") or "null")
        except Exception:
            continue
        if want == "wifi" and isinstance(j, dict) and j.get("rssi") is not None:
            if j.get("supplicant_state") in (None, "COMPLETED"):
                out.append(("wifi", j.get("rssi"), "%s Mbps" % j.get("link_speed_mbps", "?")))
        elif want == "cell" and isinstance(j, list):
            for c in j:
                dbm = c.get("dbm")
                if dbm is not None:
                    out.append((c.get("type", "cell"), dbm, c.get("level", "")))
    return out


def cat_cost(cat):
    """What a refresh of one category would cost, from cached wire sizes."""
    try:
        srcs = [x for x in sources(argparse_ns({"only": None, "cat": cat}))]
    except SystemExit:
        return None, 0
    due, unknown = 0, 0
    for x in srcs:
        c = jread("%s/%s.json" % (CD, x["id"]), {})
        w = c.get("w")
        if w is None:
            unknown += 1
        elif age_of(c.get("t")) >= (x.get("ttl") or TTL):
            due += predict(w)                  # a 304 still pays the handshake
    return due, unknown


def mac_fix(timeout):
    """macOS has CoreLocation but no stdlib access; CoreLocationCLI exposes it."""
    import shutil, subprocess
    if sys.platform != "darwin" or not shutil.which("CoreLocationCLI"):
        return None
    try:
        o = subprocess.run(["CoreLocationCLI", "-once", "-format",
                            "%latitude %longitude %horizontalAccuracy"],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           timeout=timeout)
        parts = o.stdout.decode("utf-8", "replace").split()
        if len(parts) >= 2:
            d = {"latitude": float(parts[0]), "longitude": float(parts[1]),
                 "_provider": "corelocation"}
            if len(parts) > 2:
                d["accuracy"] = float(parts[2])
            return d
    except Exception:
        pass
    return None


def win_fix(timeout):
    """Windows.Devices.Geolocation via PowerShell. Location must be enabled."""
    import subprocess
    if os.name != "nt":
        return None
    ps = ("Add-Type -AssemblyName System.Device;"
          "$w=New-Object System.Device.Location.GeoCoordinateWatcher;"
          "$w.Start();$n=0;"
          "while($w.Status -ne 'Ready' -and $n -lt 40){Start-Sleep -m 250;$n++};"
          "$c=$w.Position.Location;"
          "if(-not $c.IsUnknown){'{0} {1} {2}' -f $c.Latitude,$c.Longitude,"
          "$c.HorizontalAccuracy}")
    try:
        o = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           timeout=timeout)
        parts = o.stdout.decode("utf-8", "replace").split()
        if len(parts) >= 2:
            d = {"latitude": float(parts[0]), "longitude": float(parts[1]),
                 "_provider": "windows"}
            if len(parts) > 2:
                d["accuracy"] = float(parts[2])
            return d
    except Exception:
        pass
    return None


US_STATES = dict(x.split(":") for x in (
    "AL:Alabama;AK:Alaska;AZ:Arizona;AR:Arkansas;CA:California;CO:Colorado;"
    "CT:Connecticut;DE:Delaware;DC:District of Columbia;FL:Florida;GA:Georgia;"
    "HI:Hawaii;ID:Idaho;IL:Illinois;IN:Indiana;IA:Iowa;KS:Kansas;KY:Kentucky;"
    "LA:Louisiana;ME:Maine;MD:Maryland;MA:Massachusetts;MI:Michigan;MN:Minnesota;"
    "MS:Mississippi;MO:Missouri;MT:Montana;NE:Nebraska;NV:Nevada;NH:New Hampshire;"
    "NJ:New Jersey;NM:New Mexico;NY:New York;NC:North Carolina;ND:North Dakota;"
    "OH:Ohio;OK:Oklahoma;OR:Oregon;PA:Pennsylvania;RI:Rhode Island;"
    "SC:South Carolina;SD:South Dakota;TN:Tennessee;TX:Texas;UT:Utah;VT:Vermont;"
    "VA:Virginia;WA:Washington;WV:West Virginia;WI:Wisconsin;WY:Wyoming;"
    "PR:Puerto Rico").split(";"))


def place_parts(name):
    """'Huntington, NY' -> ('Huntington', ['new york', 'ny']). The geocoder
    matches names only: a whole 'town, region' string is fuzzy-matched as a
    name and can land on a large place that merely shares a word."""
    parts = [p.strip() for p in str(name).split(",") if p.strip()]
    if not parts:
        return "", []
    quals = []
    for q in parts[1:]:
        alts = [q.lower()]
        if q.upper() in US_STATES:
            alts.append(US_STATES[q.upper()].lower())
        quals.append(alts)
    return parts[0], quals


def place_fits(r, quals):
    """Every qualifier must match the state, county, country or country code."""
    fields = [str(r.get(k) or "").lower() for k in
              ("admin1", "admin2", "admin3", "admin4", "country", "country_code")]
    # exact, allowing only " county": "Virginia" must not match West Virginia
    return all(any(f and (alt == f or f == alt + " county" or alt == f + " county")
                   for alt in alts for f in fields) for alts in quals)


def geocode(name, timeout=12, count=6):
    """Open-Meteo geocoding: no key, same provider as the forecast. A region
    after a comma filters the matches; it is never sent as part of the name."""
    import urllib.parse
    town, quals = place_parts(name)
    if not town:
        return []
    url = ("https://geocoding-api.open-meteo.com/v1/search?name=%s"
           "&count=%d&language=en&format=json"
           % (urllib.parse.quote(town), 20 if quals else count))
    raw, _h, _w, _p = get(url, timeout, cap=262144)
    res = (json.loads(raw) or {}).get("results")
    if not isinstance(res, list):          # the API may answer with anything
        return []
    out = []
    for r in res:
        if not isinstance(r, dict):
            continue
        try:
            la, lo = float(r["latitude"]), float(r["longitude"])
        except (KeyError, TypeError, ValueError):
            continue                       # a place without coordinates is not one
        if not (-90 <= la <= 90 and -180 <= lo <= 180):
            continue
        r = dict(r)
        r["latitude"], r["longitude"] = la, lo
        out.append(r)
    if quals:
        out = [r for r in out if place_fits(r, quals)]   # none fit: say so, never guess
    return out[:count]


def place_label(r):
    # names come from a remote API and land in the header: clean and bound them
    bits = []
    for k in ("name", "admin1", "country"):
        v = clean(str(r.get(k) or ""), 40)
        if v and v not in bits:
            bits.append(v)
    return ", ".join(bits)[:60]


def ip_fix(timeout=12):
    """Coarse, city-level, and it tells a third party your IP. Opt-in only."""
    for url, la, lo, ac in (
            ("https://ipapi.co/json/", "latitude", "longitude", "city"),
            ("https://ipwho.is/", "latitude", "longitude", "city")):
        try:
            raw, _, _w, _p = get(url, timeout, cap=65536)
            j = json.loads(raw)
            if j.get(la) is None:
                continue
            lat_, lon_ = float(j[la]), float(j[lo])
            if not (-90 <= lat_ <= 90 and -180 <= lon_ <= 180):
                continue
            return {"latitude": lat_, "longitude": lon_,
                    "accuracy": 5000, "_provider": "ip",
                    "_place": clean(str(j.get(ac) or ""), 40)}
        except Exception:
            continue
    return None


def gps_fix(want_gps, timeout=50):
    """Ask Termux for a fix. GPS is accurate but needs sky; network is instant
    but coarse. Try the accurate one first and fall back rather than fail."""
    import shutil, subprocess
    for prov in (mac_fix, win_fix):        # laptops: OS location services
        got = prov(min(timeout, 20))
        if got:
            return got, None
    if not shutil.which("termux-location"):
        if sys.platform == "darwin":
            return None, ("no location provider. On macOS install CoreLocationCLI "
                          "(brew install corelocationcli), or use --ip, or pin:\n"
                          "  lowpingnews weather -c 40.900,-73.412 --label 'Home'")
        if os.name == "nt":
            return None, ("Windows location services returned nothing. Enable "
                          "Settings > Privacy > Location, or use --ip, or pin:\n"
                          "  lowpingnews weather -c 40.900,-73.412 --label 'Home'")
        return None, ("no location provider on this system. Use --ip for a "
                      "city-level guess, or pin one:\n"
                      "  lowpingnews weather -c 40.900,-73.412 --label 'Home'")
    order = ["gps", "network"] if want_gps else ["network", "gps"]
    last, noapp, nofix = "no fix", False, False
    for p in order:
        try:
            o = subprocess.run(["termux-location", "-p", p],
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               timeout=timeout)
        except subprocess.TimeoutExpired:
            last = "%s timed out after %ds" % (p, timeout)
            continue
        except Exception as e:
            last = "%s could not run (%s)" % (p, str(e)[:40])
            continue
        txt = (o.stdout.decode("utf-8", "replace") +
               o.stderr.decode("utf-8", "replace")).strip()
        # the CLI prints a human notice, not JSON, when the companion app is
        # missing. Blaming the sky for that sent people outdoors for nothing.
        low = txt.lower()
        if "termux:api" in low or "not yet available" in low:
            # "not yet available on Google Play" comes from the Play build of
            # Termux, whose companion app does not exist yet. An F-Droid
            # Termux:API is signed differently and will never pair with it.
            noapp = "google play" in low or "play store" in low
            noapp = "play" if noapp else True
            continue
        try:
            j = json.loads(txt or "null")
        except Exception:
            last = "%s returned %s" % (p, ("no output" if not txt
                                           else repr(txt[:60])))
            continue
        if j and j.get("latitude") is not None:
            j["_provider"] = p
            return j, None
        nofix = True                   # answered properly, just had no position
        last = "%s returned no fix" % p
    if noapp == "play":
        return None, ("this is the Google Play build of Termux, and its "
                      "Termux:API companion is not released yet. An F-Droid "
                      "Termux:API is signed differently and cannot pair with "
                      "it. Pin a location instead:\n"
                      "  lowpingnews weather -c 40.900,-73.412 --label 'Home'")
    if noapp:
        return None, ("the Termux:API app is not installed. The termux-api "
                      "package alone is not enough - install Termux:API from "
                      "the same source as Termux itself, or pin a location:\n"
                      "  lowpingnews weather -c 40.900,-73.412 --label 'Home'")
    # only suggest the sky when a provider actually answered without a position
    return None, last + (" - GPS needs open sky; try outdoors" if nofix else "")


def _store_fix(j, label=None):
    return {"lat": round(float(j["latitude"]), 4),
            "lon": round(float(j["longitude"]), 4),
            "label": clean(str(label or ""), 60) or None,
            "acc": j.get("accuracy"),
            "via": j.get("_provider"), "t": int(time.time())}


def wx_locate(a):
    """Follow the device by default. A location is only sticky if you pinned it
    on purpose with -c; otherwise a stale fix is refreshed quietly."""
    if getattr(a, "coords", None):
        try:
            la, lo = [float(x) for x in a.coords.replace(" ", "").split(",")]
        except Exception:
            sys.exit("news: coords look like 40.900,-73.412")
        if not (-90 <= la <= 90 and -180 <= lo <= 180):
            sys.exit("news: latitude must be -90..90 and longitude -180..180")
        d = {"lat": round(la, 4), "lon": round(lo, 4),
             "label": clean(str(getattr(a, "label", None) or ""), 60) or None,
             "via": "pinned",
             "t": int(time.time())}
        jwrite(WXLOC, d)
        return d

    if getattr(a, "place", None):
        try:
            hits = geocode(a.place)
        except Exception as e:
            sys.exit("news: place lookup failed (%s)" % str(e)[:60])
        if not hits:
            sys.exit("news: no place matched %r. Try adding a region, e.g.\n"
                     "  lowpingnews weather -p 'Huntington, New York'" % a.place)
        top = hits[0]
        d = {"lat": round(float(top["latitude"]), 4),
             "lon": round(float(top["longitude"]), 4),
             "label": clean(str(getattr(a, "label", None) or ""), 60)
                      or place_label(top) or None,
             "via": "place", "t": int(time.time())}
        jwrite(WXLOC, d)
        others = [place_label(r) for r in hits[1:4]
                  if place_label(r) != place_label(top)]
        if others:                          # ambiguity is the user's to resolve
            sys.stderr.write("  also matched: %s\n" % "; ".join(others))
        return d

    if getattr(a, "iploc", False):
        j = ip_fix()
        if not j:
            sys.exit("news: IP lookup failed. Pin a location instead:\n"
                     "  lowpingnews weather -c 40.900,-73.412 --label 'Home'")
        fix = _store_fix(j, getattr(a, "label", None) or (j.get("_place") or None))
        jwrite(WXLOC, fix)
        return fix

    if getattr(a, "gps", False):
        sys.stderr.write("  locating...\r")
        sys.stderr.flush()
        j, err = gps_fix(True)
        sys.stderr.write("\r" + " " * 48 + "\r")
        sys.stderr.flush()
        if not j:
            sys.exit("news: %s" % err)
        d = _store_fix(j, getattr(a, "label", None))   # a fresh fix clears the pin
        jwrite(WXLOC, d)
        return d

    d = jread(WXLOC, {})
    try:
        la, lo = float(d["lat"]), float(d["lon"])
        if not (-90 <= la <= 90 and -180 <= lo <= 180):
            raise ValueError
        d["lat"], d["lon"] = la, lo
    except Exception:
        d = {}

    pinned = d.get("via") in ("pinned", "place")
    stale = age_of(d.get("t")) > LOCTTL
    if d and (pinned or not stale):
        return d                                       # good enough, spend nothing

    # followed and stale, or nothing stored at all: ask the device quietly.
    # network provider, not GPS: instant, works indoors, accurate to a city block
    j, err = gps_fix(False, timeout=15)
    if j:
        fix = _store_fix(j)
        jwrite(WXLOC, fix)
        return fix
    if d:
        return d                                       # no fix: last known is fine
    sys.exit("news: no location. Pin one, or install Termux:API for a fix:\n"
             "  lowpingnews weather -c 40.900,-73.412 --label 'Fleets Cove'")


# ---------------------------------------------------------------- NOAA radio
# The National Weather Service API: what a NOAA weather radio broadcasts -
# watches, warnings and the spoken-style forecast - as small gzipped JSON.
# United States only. It asks callers to identify themselves.
NWS = "https://api.weather.gov"
NWS_HDR = {"Accept": "application/geo+json"}
NWSC = os.path.join(CD, "nws.json")
NWS_ALERT_TTL = 300            # warnings are the point: re-ask after five minutes
NWS_FC_TTL = 1800
NWS_POINT_TTL = 30 * 86400     # which office and grid cover a spot rarely changes
SEV_RANK = {"Extreme": 0, "Severe": 1, "Moderate": 2, "Minor": 3}
URG_RANK = {"Immediate": 0, "Expected": 1, "Future": 2, "Past": 4}
MARINE_ZONE = re.compile(r"^[A-Z]{2}Z\d{3}$")


def nws_ua():
    return {"User-Agent": "LowPingNews/%s (github.com/ATinyGreenCell/LowPingNews)" % VERSION}


def nws_get(url, cap):
    h = dict(NWS_HDR)
    h.update(nws_ua())
    raw, _hd, wire, _p = get(url, 15, extra=h, cap=cap)
    return json.loads(raw), wire


def nws_alerts_live(alerts, now=None):
    """Drop what has run out, and anything not a real alert (tests, drills).
    A cached copy can outlive the warnings in it; never show those as current."""
    now = time.time() if now is None else now
    keep, gone = [], 0
    for p in alerts:
        if not isinstance(p, dict) or p.get("status", "Actual") != "Actual":
            continue
        if p.get("messageType") == "Cancel":
            continue
        end = when(p.get("ends") or p.get("expires") or "")
        if end and end < now:
            gone += 1
            continue
        keep.append(p)
    keep.sort(key=lambda p: (SEV_RANK.get(p.get("severity"), 5),
                             URG_RANK.get(p.get("urgency"), 3), -(when(p.get("onset") or "") or 0)))
    return keep, gone


def nws_fetch(loc, fresh, marine=None):
    """-> dict with point, alerts, periods, marine text, and how fresh each is.
    Each part fails on its own: a dead forecast must never hide a warning."""
    c = jread(NWSC, {})
    key_ = "%.4f,%.4f" % (loc["lat"], loc["lon"])
    if c.get("key") != key_:
        c = {"key": key_}
    now = time.time()
    out = {"wire": 0, "err": {}}

    def stale(part, ttl):
        t_ = (c.get(part) or {}).get("t")
        return fresh or not t_ or age_of(t_) >= ttl

    if stale("point", NWS_POINT_TTL) and not OFFLINE[0]:
        try:
            d, w = nws_get("%s/points/%s" % (NWS, key_), 64 * 1024)
            out["wire"] += w
            pr = d.get("properties") or {}
            fc = str(pr.get("forecast") or "")
            if not fc.startswith(NWS + "/"):     # only ever follow links to NWS itself
                raise ValueError("no forecast office for this spot")
            rel = ((pr.get("relativeLocation") or {}).get("properties") or {})
            c["point"] = {"t": int(now), "fc": fc, "office": str(pr.get("gridId") or "")[:8],
                          "place": ("%s %s" % (rel.get("city") or "", rel.get("state") or "")).strip()[:60],
                          "zone": str(pr.get("forecastZone") or "").rsplit("/", 1)[-1][:8]}
        except Exception as e:
            out["err"]["point"] = nws_why(e)
    if stale("alerts", NWS_ALERT_TTL) and not OFFLINE[0]:
        try:
            d, w = nws_get("%s/alerts/active?point=%s" % (NWS, key_), 1024 * 1024)
            out["wire"] += w
            feats = d.get("features")
            if not isinstance(feats, list):
                raise ValueError("unreadable alert list")
            keep = []
            for f in feats[:60]:
                p = (f or {}).get("properties") if isinstance(f, dict) else None
                if isinstance(p, dict):
                    keep.append({k: (clean_alert(p.get(k), 4000, keep_lines=True)
                                     if k in ("description", "instruction") else clean_alert(p.get(k), 300))
                                 for k in ("event", "headline", "severity", "urgency", "certainty",
                                           "onset", "effective", "expires", "ends", "status",
                                           "messageType", "senderName", "areaDesc",
                                           "description", "instruction")})
            c["alerts"] = {"t": int(now), "list": keep}
        except Exception as e:
            out["err"]["alerts"] = nws_why(e)
    pt = c.get("point") or {}
    if pt.get("fc") and stale("fc", NWS_FC_TTL) and not OFFLINE[0]:
        try:
            d, w = nws_get(pt["fc"], 256 * 1024)
            out["wire"] += w
            per = ((d.get("properties") or {}).get("periods"))
            if not isinstance(per, list) or not per:
                raise ValueError("no forecast periods")
            c["fc"] = {"t": int(now), "periods": [
                {"name": clean_alert(p.get("name"), 30), "temp": p.get("temperature"),
                 "unit": clean_alert(p.get("temperatureUnit"), 2),
                 "short": clean_alert(p.get("shortForecast"), 80),
                 "text": clean_alert(p.get("detailedForecast"), 600),
                 "day": bool(p.get("isDaytime", True))}
                for p in per[:14] if isinstance(p, dict)]}
        except Exception as e:
            out["err"]["fc"] = nws_why(e)
    if not marine or (c.get("marine") or {}).get("zone") != marine:
        c.pop("marine", None)                  # switched off or changed: drop the old text
    if marine and stale("marine", NWS_FC_TTL) and not OFFLINE[0]:
        try:
            raw, _hd, w, _p = get("https://tgftp.nws.noaa.gov/data/forecasts/marine/coastal/%s/%s.txt"
                                  % (marine[:2].lower(), marine.lower()), 15, extra=nws_ua(), cap=64 * 1024)
            out["wire"] += w
            c["marine"] = {"t": int(now), "zone": marine,
                           "text": clean_alert(raw.decode("utf-8", "replace"), 6000, keep_lines=True)}
        except Exception as e:
            out["err"]["marine"] = nws_why(e)
    jwrite(NWSC, c)
    if out["wire"]:
        net_log([(True, 0, out["wire"])])
    out.update(c)
    return out


def nws_why(e):
    code = getattr(e, "code", None)
    if code == 404:
        return "not covered (NOAA serves the United States only)"
    if code in (403, 429):
        return "refused by weather.gov (%d)" % code
    if code:
        return "weather.gov error %d" % code
    return str(e)[:60] or e.__class__.__name__


def clean_alert(v, n, keep_lines=False):
    """Text from an outside service: strip control characters, bound the size."""
    if v is None:
        return ""
    v = str(v)
    if keep_lines:
        v = "\n".join(CTRL.sub("", ln).rstrip() for ln in v.replace("\r", "").split("\n"))
    else:
        v = " ".join(CTRL.sub(" ", v).split())
    return v[:n]


def radio_banner(loc):
    """For `weather`: warnings the radio found here recently, from its cache.
    Costs nothing; silent when the check is over an hour old, so a stale copy
    can never pass for current."""
    c = jread(NWSC, {})
    if c.get("key") != "%.4f,%.4f" % (loc["lat"], loc["lon"]):
        return []
    al = c.get("alerts") or {}
    if not al.get("t") or age_of(al["t"]) >= 3600:
        return []
    live, _gone = nws_alerts_live(al.get("list") or [])
    return live


def radio_show(a, P, loc, r):
    import textwrap
    B, D = P["b"], P["d"]
    cols = cols_()
    wrap = lambda t, ind="    ": textwrap.wrap(t, max(20, cols - len(ind) - 1)) or [""]

    pt = r.get("point") or {}
    def say(txt, fn=None, ind="  "):
        """Every message wraps: error text from outside can be any length."""
        for ln in textwrap.wrap(txt, max(16, cols - len(ind) - 1)) or [""]:
            print((fn or D)(ind + ln))

    def paras(t):
        """NWS text is hard-wrapped at ~70 columns with blank lines between
        paragraphs: rejoin each paragraph, then wrap it to this screen."""
        out_ = []
        for para in re.split(r"\n\s*\n", t.strip()):
            para = " ".join(para.split())
            if para:
                if out_:
                    out_.append("")
                out_.extend(wrap(para))
        return out_

    # Which spot was checked comes first and is never left implicit: a radio
    # that reads the right warnings for the wrong county looks authoritative.
    where = loc.get("label") or pt.get("place") or "%.4f,%.4f" % (loc["lat"], loc["lon"])
    print(P["hdr"]("NOAA RADIO") + "  " + B(where[:max(10, cols - 14)]))
    via = loc.get("via") or "device"
    how = {"pinned": "pinned", "place": "set by place name",
           "ip": "approximate, from your network address"}.get(via, "device fix")
    say("For %.4f,%.4f (%s)" % (loc["lat"], loc["lon"], how))
    if pt.get("office"):
        say("Weather Service office %s%s%s" % (
            pt["office"], (", zone " + pt["zone"]) if pt.get("zone") else "",
            (", near " + pt["place"]) if pt.get("place") and pt.get("place") != where else ""))
    if via == "ip":
        say("A network address can place you many miles off, so these alerts may be "
            "for the wrong county. Pin your spot:", P["yel"])
        say("lowpingnews radio -c LAT,LON --label NAME", P["b"], "    ")
    elif via not in ("pinned", "place") and age_secs(loc.get("t")) > LOCTTL:
        say("Location fixed %s and could not be refreshed. If you have moved, pin "
            "where you are:" % ago(age_secs(loc.get("t"))), P["yel"])
        say("lowpingnews radio -c LAT,LON --label NAME", P["b"], "    ")
    errs = r.get("err") or {}
    if "point" in errs and not pt:
        print()
        say("No NOAA coverage here: " + errs["point"], P["red"])
        return 1
    # ---- alerts: first, always, and honest about how old they are
    al = r.get("alerts")
    rc_ = 0
    print()
    if al is None:
        rc_ = 2                                 # could not check: never mistaken for "all clear"
        print("  " + P["red"](B("ALERTS UNKNOWN")))
        say("Could not reach weather.gov (%s). This is not an all-clear." % errs.get("alerts", "offline"))
    else:
        live, gone = nws_alerts_live(al.get("list") or [])
        age_ = age_secs(al.get("t"))
        old = age_ >= NWS_ALERT_TTL * 2 or "alerts" in errs
        if not live:
            print("  " + P["grn"](B("No active alerts")))
        else:
            n = len(live)
            print("  " + P["red"](B("%s %d ACTIVE ALERT%s" % ("!!" if a.ascii else "\u26a0",
                                                              n, "" if n == 1 else "S"))))
        if old:
            say("Alerts checked %s%s - may be out of date" % (
                ago(age_) if age_ >= 0 else "at an unknown time",
                " (%s)" % errs["alerts"] if "alerts" in errs else ""), P["yel"])
        if gone:
            say("%d expired alert%s hidden" % (gone, "" if gone == 1 else "s"))
        for p in live:
            sev = p.get("severity") or "Unknown"
            col = P["red"] if sev in ("Extreme", "Severe") else P["yel"] if sev == "Moderate" else D
            end = when(p.get("ends") or p.get("expires") or "")
            until = (" until %s %s" % (time.strftime("%a", time.localtime(end)), clock(end))) if end else ""
            ev = (p.get("event") or "Alert").upper()
            if 2 + len(ev) + len(until) <= cols:
                print("\n  " + col(B(ev)) + D(until))
            else:                               # narrow: the time on its own line
                print("\n  " + col(B(ev[:cols - 2])))
                if until:
                    print(D("   " + until))
            sep = ", " if a.ascii else " \u00b7 "
            facts = sep.join(x for x in (sev.lower(), (p.get("urgency") or "").lower(),
                                         (p.get("certainty") or "").lower()) if x)
            for ln in wrap(facts):
                print(D("    " + ln))
            for ln in wrap(p.get("headline") or ""):
                print("    " + ln)
            body = p.get("description") or ""
            todo = p.get("instruction") or ""
            full = getattr(a, "full", False) or sev in ("Extreme", "Severe")
            if body:
                lines = paras(body)
                show_ = lines if full else lines[:4]
                for ln in show_:
                    print(D("    " + ln) if ln else "")
                if len(show_) < len(lines):
                    say("... %d more lines: radio --full" % (len(lines) - len(show_)), ind="    ")
            if todo:
                print("    " + B("What to do:"))
                for ln in (paras(todo) if full else paras(todo)[:3]):
                    print(("    " + ln) if ln else "")
    # ---- forecast: the spoken periods, the way the radio reads them
    fc = r.get("fc")
    print("\n" + D("  FORECAST"))
    if not fc:
        say("unavailable (%s)" % errs.get("fc", errs.get("point", "offline")), ind="    ")
    else:
        if "fc" in errs or age_secs(fc.get("t")) >= NWS_FC_TTL * 3:
            say("Forecast from %s" % ago(age_secs(fc.get("t"))), P["yel"])
        for p in fc.get("periods") or []:
            t_ = p.get("temp")
            head = "%s  %s" % ((p.get("name") or "").upper(),
                               ("%s\u00b0%s" % (t_, p.get("unit") or "")) if isinstance(t_, (int, float)) else "")
            print("  " + B(head.strip()))
            for ln in wrap(p.get("text") or p.get("short") or ""):
                print("    " + ln)
    mar = r.get("marine")
    if mar:
        print()
        say("MARINE  zone %s, %s" % (mar.get("zone"), ago(age_secs(mar.get("t")))))
        for raw_ln in (mar.get("text") or "").split("\n"):
            for ln in (textwrap.wrap(raw_ln, max(20, cols - 5)) or [""]):
                print("    " + ln)
    elif "marine" in errs:
        print()
        say("MARINE  unavailable (%s)" % errs["marine"])
    spent_ = ("~%s" % kbs(r["wire"])) if r.get("wire") else "0B, cached"
    print(D("\n  " + spent_))
    return rc_


def wx_fetch(loc, unit, fresh):
    """One gzipped Open-Meteo call, cached like any feed."""
    c = jread(WXC, {})
    fresh_enough = (not fresh and c.get("t")
                    and age_of(c.get("t")) < WXTTL
                    and c.get("u") == unit
                    and abs((c.get("lat") or 999) - loc["lat"]) < .03
                    and abs((c.get("lon") or 999) - loc["lon"]) < .03)
    if fresh_enough:
        return c["d"], 0, age_secs(c.get("t")), False
    q = ("latitude=%s&longitude=%s&current=temperature_2m,apparent_temperature,"
         "weather_code,wind_speed_10m,wind_gusts_10m,wind_direction_10m,"
         "relative_humidity_2m,is_day"
         "&hourly=temperature_2m,precipitation_probability,precipitation,weather_code"
         "&daily=weather_code,temperature_2m_max,temperature_2m_min,"
         "precipitation_probability_max,precipitation_sum,sunrise,sunset"
         "&forecast_hours=24&forecast_days=7"
         "&timeformat=unixtime&timezone=auto&temperature_unit=%s&wind_speed_unit=%s"
         "&precipitation_unit=%s&cell_selection=land"
         % (loc["lat"], loc["lon"], unit,
            "mph" if unit == "fahrenheit" else "kmh",
            "inch" if unit == "fahrenheit" else "mm"))
    try:
        raw, _, wire, _p = get("https://api.open-meteo.com/v1/forecast?" + q, 15)
        d = json.loads(raw)
        if d.get("error"):
            raise ValueError(d.get("reason", "api error"))
        jwrite(WXC, {"t": int(time.time()), "u": unit, "lat": loc["lat"],
                     "lon": loc["lon"], "d": d})
        net_log([(True, 0, wire)])
        return d, wire, 0, False
    except Exception as e:
        if c.get("d"):                     # offline: stale beats nothing
            net_log([(False, 0, 0)])
            return c["d"], 0, age_secs(c.get("t")), True
        sys.exit("news: no forecast and no cache (%s)" % str(e)[:60])


def spark(v, asc):
    ch = ABLK if asc else BLK
    lo, hi = min(v), max(v)
    if hi - lo < 1e-9:                 # flat: the floor would imply a low, not a level
        return ch[len(ch) // 2] * len(v)
    return "".join(ch[min(7, int((x - lo) / (hi - lo) * 7.999))] for x in v)


def rainbar(p, asc):
    ch = ABLK if asc else BLK
    dry = "." if asc else "\u00b7"     # parenthesised: the unbracketed form made
    return "".join(dry if (x or 0) < 10  # ascii mode draw a flat line of dots
                   else ch[min(7, int((x or 0) / 100 * 7.999))] for x in p)


def wx_show(a, P, loc, d, wire, age_s, stale):
    D, B = P["d"], P["b"]
    cols = cols_()
    cu, h, dy = d["current"], d["hourly"], d["daily"]
    off = d.get("utc_offset_seconds", 0)
    L = lambda t: dt.datetime.fromtimestamp(t + off, dt.timezone.utc)
    U = "\u00b0F" if a.unit == "fahrenheit" else "\u00b0C"
    t0 = L(cu["time"])
    icon, name = wx_label(cu.get("weather_code"), a.ascii, night=not cu.get("is_day", 1))
    place = loc.get("label") or "%.3f,%.3f" % (loc["lat"], loc["lon"])
    when_ = "%s %d %s %s" % (t0.strftime("%a"), t0.day, t0.strftime("%b"), clock(t0))
    if len(place) + 2 + len(when_) <= cols:
        print(P["hdr"](place) + D("  " + when_))
    else:                                       # a narrow screen: one line each
        print(P["hdr"](place[:cols]))
        print(D("  " + when_))
    for p_ in radio_banner(loc)[:3]:
        end_ = when(p_.get("ends") or p_.get("expires") or "")
        print("  " + P["red"](P["b"]("%s %s" % ("!!" if a.ascii else "\u26a0", (p_.get("event") or "Alert")[:cols - 6])))
              + (P["d"](" until %s %s" % (time.strftime("%a", time.localtime(end_)), clock(end_)))
                 if end_ and len(p_.get("event") or "") + 20 <= cols else ""))
    if radio_banner(loc):
        print(P["d"]("  details: lowpingnews radio"))
    via = loc.get("via")
    if via and via not in ("pinned", "place"):
        t_fix = loc.get("t") or 0
        fixage = int(time.time() - t_fix)
        # an implausible timestamp is unknown age, not a 20000-day-old fix
        when_ = ("" if not t_fix or fixage > 30 * 86400 else
                 ", " + ago(fixage) if fixage > 120 else "")
        acc_ = ("" if not loc.get("acc") else
                ", city-level" if via == "ip" else ", +/-%dm" % loc["acc"])
        print(D("  %.4f,%.4f via %s%s%s" % (
            loc["lat"], loc["lon"], via, acc_, when_)))
    elif via in ("pinned", "place") or loc.get("label"):
        print(D("  %.4f,%.4f %s" % (loc["lat"], loc["lon"],
                                    "matched" if via == "place" else "pinned")))
    temp = round(cu["temperature_2m"])
    tc = (P["cyn"] if temp <= 32 else P["grn"] if temp <= 80 else P["yel"])
    print("  " + B(tc("%d%s" % (temp, U))) + "  " + (icon + " " if icon else "") + B(name))
    feels = "Feels like %d\u00b0" % round(cu["apparent_temperature"])
    humid = "Humidity %d%%" % round(cu.get("relative_humidity_2m") or 0)
    if 2 + len(feels) + 3 + len(humid) <= cols:
        print(D("  %s %s %s" % (feels, bul_(a), humid)))
    else:
        print(D("  " + feels))
        print(D("  " + humid))
    wd = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"][
        int((cu.get("wind_direction_10m", 0) + 22.5) % 360 // 45)]
    gust = cu.get("wind_gusts_10m")
    spd = round(cu.get("wind_speed_10m") or 0)
    gtxt = ""
    if gust and round(gust) > spd + 3:      # only worth saying when it is gusty
        gtxt = P["yel"](", gusts %d" % round(gust))
    # the next event chronologically, not sunrise-first: at 15:00 the useful
    # number is tonight's sunset, not tomorrow's sunrise
    cand = [(ts, lbl) for lbl, key_ in (("rises", "sunrise"), ("sets", "sunset"))
            for ts in (dy.get(key_) or [])[:3] if ts and ts > cu["time"]]
    sun = sun_short = ""
    if cand:
        ts, lbl = min(cand)
        mins = int((ts - cu["time"]) / 60)
        word = "Sunrise" if lbl == "rises" else "Sunset"
        sun_short = D("  %s %s" % (word, clock(L(ts))))
        if mins < 180:                      # imminent: say how long is left
            sun = P["yel"]("  %s %s, in %dh %02dm" % (
                word, clock(L(ts)), mins // 60, mins % 60))
        else:
            sun = sun_short
    unit_w = " mph" if a.unit == "fahrenheit" else " km/h"
    print(D("  Wind %s %d%s" % (wd, spd, unit_w) if spd else "  Wind calm") + gtxt)
    for cand in (sun, sun_short):           # the countdown is the long form
        if len(_plain(cand)) <= cols:
            if cand:
                print(cand)
            break
    n = min(24, len(h["time"]), max(1, cols - 4))
    tp = h["temperature_2m"][:n]
    pr = [x or 0 for x in h["precipitation_probability"][:n]]
    print("\n" + D("  NEXT %dH" % n) +
          D("   %d\u2013%d%s" % (round(min(tp)), round(max(tp)), U)))
    print("  " + P["yel"](spark(tp, a.ascii)))
    amt = [x or 0 for x in (h.get("precipitation") or [0] * n)][:n]
    k = max(range(n), key=lambda i: pr[i])
    tot = sum(amt)
    unit_p = "in" if a.unit == "fahrenheit" else "mm"
    # probability alone does not support a decision; the amount does
    if pr[k] >= 10:
        note = "Rain %d%% around %s" % (pr[k], clock(L(h["time"][k]), hour=True))
        note += (", %.2f %s total" % (tot, unit_p)) if tot >= 0.005 else ", a trace"
    else:
        note = "No rain expected"
    print("  " + P["cyn"](rainbar(pr, a.ascii)))
    ax = [" "] * n
    for i in range(0, n, 6):               # a sparkline you cannot time-index is
        lab = clock(L(h["time"][i]), short=True)    # a picture, not a forecast
        for j, ch in enumerate(lab):
            if i + j < n:
                ax[i + j] = ch
    print("  " + D("".join(ax).rstrip()))
    import textwrap
    for ln_ in textwrap.wrap(note, max(20, cols - 3)):      # a sentence, not a row
        print("  " + (P["cyn"] if pr[k] >= 10 else D)(ln_))
    lo_a = min(dy["temperature_2m_min"])
    hi_a = max(dy["temperature_2m_max"])
    labels = [wx_label(c, a.ascii) for c in dy["weather_code"]]
    iw = 0 if a.ascii else 3                        # icon (two cells) and a space
    labw = max(len(w) for _i, w in labels)          # never more than WXNAMEMAX
    # day icon label | lo bar hi | rain. Names are never cut: on a narrow
    # screen the bar goes and the temperatures become a plain range instead.
    base_w = 2 + 3 + 1 + iw + labw + 2
    # a row is: left(base_w) + "lo° " + bar(W) + " hi°" + " " + "rain%"(5) + "*"
    # i.e. base_w + W + 17 cells; without the bar: base_w + range(8) + 7
    W = max(0, min(12, cols - base_w - 17))
    use_bar = W >= 5
    # a mid-line bar, not a full block: in phone fonts the block is taller than
    # the line, so seven days of it merged into one shape instead of seven ranges
    fl, gp = ("#", ".") if a.ascii else ("\u25ac", "\u00b7")
    if use_bar:
        head = "  7 DAY".ljust(base_w) + "low " + " " * (W + 1) + "high" + " " + "rain".rjust(5)
    elif base_w + 15 <= cols:
        head = "  7 DAY".ljust(base_w) + "low\u2013high" + " " + "rain".rjust(5)
    else:
        # too narrow for a name and the numbers on one line: two lines a day,
        # rather than cutting words back into abbreviations
        base_w = 6
        head = "  7 DAY\n" + " " * base_w + "low\u2013high" + " " + "rain".rjust(5)
    two_line = not use_bar and base_w == 6
    print("\n" + D(head))
    sp = (hi_a - lo_a) or 1.0
    # today's daily max spans midnight-to-midnight, so at 19:00 it reports rain
    # that already fell. Use only the hours still ahead of us.
    rest = None
    today = L(cu["time"]).date()
    ahead = [(p or 0, c or 0) for t, p, c in zip(
        h["time"], h["precipitation_probability"], h["weather_code"])
        if t >= cu["time"] and L(t).date() == today]
    rest_code = None
    if ahead:
        rest = max(p for p, _ in ahead)
        rest_code = worst(c for _, c in ahead)      # the worst hour still to come
    for i, ts in enumerate(dy["time"]):
        lo, hi = dy["temperature_2m_min"][i], dy["temperature_2m_max"][i]
        pp = dy["precipitation_probability_max"][i] or 0
        amt_d = (dy.get("precipitation_sum") or [0] * 7)[i] or 0
        code = int(dy["weather_code"][i] or 0)
        mark_ = ""
        if i == 0 and rest is not None and (rest != pp or rest_code != code):
            pp, mark_ = rest, "*"                   # remaining hours, not the whole day
            if rest_code is not None:
                code = rest_code
        icon_, word_ = wx_label(code, a.ascii)
        if two_line:
            left = "  %s " % L(ts).strftime("%a")
        else:
            left = "  %s %s%s  " % (L(ts).strftime("%a"), (icon_ + " ") if icon_ else "",
                                    word_.ljust(labw))
        if use_bar:
            b0 = int((lo - lo_a) / sp * W)
            b1 = max(b0 + 1, int(round((hi - lo_a) / sp * W)))
            mid = "%3d\u00b0 %s %3d\u00b0" % (round(lo), P["yel"]((gp * b0 + fl * (b1 - b0)).ljust(W, gp)),
                                          round(hi))
        else:
            mid = "%-8s" % ("%d\u2013%d\u00b0" % (round(lo), round(hi)))
        wet = "%4d%%" % pp
        row_w = len(_plain(left + mid)) + 1 + len(wet) + 1      # +1: room for "*"
        if pp >= 10 and amt_d >= 0.005:             # the amount, only if it fits
            more = " %.2f" % amt_d
            if row_w + len(more) <= cols:
                wet += more
        print(left + mid + " " + (P["cyn"] if pp >= 10 else D)(wet) + D(mark_))
        if two_line:
            print("      " + (icon_ + " " if icon_ else "") + D(word_))
    if rest is not None and (rest != (dy["precipitation_probability_max"][0] or 0)
                             or rest_code != int(dy["weather_code"][0] or 0)):
        print(D("  * today = hours remaining"))
    if age_s == -3:                    # the cache's clock is unusable: say so
        foot = ("offline, cached, age unknown" if stale else "0B, cached, age unknown")
    else:
        foot = ("offline, cached %s" % ago(age_s) if stale
                else spent() if NETSTAT["est"]
                else "0B, cached" if age_s < 60 else "0B, cached %s" % ago(age_s))
    print(D("\n  " + foot))


# Hacker News via Algolia returns highlighting metadata, tags and more that the
# parser never reads. Ask for the fields it uses. Applied at request time, so it
# reaches configs written before this existed. Unmeasured against the live API
# (not reachable from the build machine), so it steps down if rejected:
# level 2 = fields + no highlighting, 1 = fields only, 0 = the plain request.
HN_TRIM = {
    2: "attributesToRetrieve=title,story_title,url,points,num_comments,created_at_i"
       "&attributesToHighlight=",
    1: "attributesToRetrieve=title,story_title,url,points,num_comments,created_at_i",
}


def request_url(src, c):
    u = src["url"]
    if src.get("kind") != "hn" or "attributesToRetrieve" in u:
        return u
    lvl = c.get("trim", 2)
    if lvl in HN_TRIM:
        u += ("&" if "?" in u else "?") + HN_TRIM[lvl]
    return u


def host_units(srcs):
    """Feeds on the same host share one worker and run in turn, so the second
    resumes the first's TLS session instead of paying a fresh handshake
    (measured: 3.8 KB instead of 6.7 KB for a 304). Order is preserved."""
    import urllib.parse
    units, pos = [], {}
    for x in srcs:
        try:
            h = urllib.parse.urlsplit(x.get("url") or "").hostname or x["id"]
        except Exception:
            h = x["id"]
        if h in pos:
            units[pos[h]].append(x)
        else:
            pos[h] = len(units)
            units.append([x])
    return units


def gather(srcs, fresh, on_feed=None):
    import threading
    want_total = expected(srcs)            # before any cache file is rewritten
    units = host_units(srcs)
    # a unit runs its feeds in turn, so its worst case is the sum of theirs
    slowest = max([sum(x.get("timeout") or 10 for x in u) for u in units] or [10])
    batches = (len(units) + MAXPAR - 1) // MAXPAR
    # per-batch budget, not a single global one: with many feeds a fixed 20s
    # silently drops whole batches and the footer still looks complete
    deadline = min(HARDCAP, batches * max(DEADLINE, slowest * 2 + 6))
    os.makedirs(CD, exist_ok=True)
    bag = {}
    end = time.time() + deadline
    def run_unit(unit):
        for s_ in unit:
            if time.time() >= end:
                return                     # deadline: the rest are "not reached"
            load(s_, fresh, bag)

    for i in range(0, len(units), MAXPAR):      # batches: 40 feeds != 40 sockets
        if time.time() >= end:
            break
        ths = []
        for u in units[i:i + MAXPAR]:
            t = threading.Thread(target=run_unit, args=(u,), daemon=True)
            t.start()
            ths.append(t)
        show_prog = sys.stderr.isatty() and not os.environ.get("LPN_NO_PROGRESS")
        cols = cols_()
        announced, t_started = set(), time.time()
        while time.time() < end and any(t.is_alive() for t in ths):
            if on_feed:
                for x in srcs:             # announce in the main thread only
                    if x["id"] in DONE and x["id"] not in announced and x["id"] in bag:
                        announced.add(x["id"])
                        on_feed(x, bag[x["id"]])
            elif show_prog:                # bar and stream would fight for the line
                sys.stderr.write("\r" + progress_line(
                    srcs, cols, want_total, t_started).ljust(cols - 1))
                sys.stderr.flush()
            # wait on a worker, not the clock: from cache they finish in a
            # millisecond, and a fixed sleep here cost 120ms on every warm run
            alive = [t for t in ths if t.is_alive()]
            if alive:
                alive[0].join(0.12)
        for t in ths:                      # join() is the real ceiling: socket
            t.join(max(0.05, end - time.time()))   # timeouts do not bound getaddrinfo
        if on_feed:
            for x in srcs:                 # anything that landed on the last tick
                if x["id"] in DONE and x["id"] not in announced and x["id"] in bag:
                    announced.add(x["id"])
                    on_feed(x, bag[x["id"]])
        elif show_prog:
            sys.stderr.write("\r" + " " * (cols - 1) + "\r")
            sys.stderr.flush()
    for x in srcs:                         # never attempted: say so, don't imply ok
        bag.setdefault(x["id"], ([], 0, -2, 0, 0))
    net_log(bag.pop("_net", []))
    return bag


def stale_note(entries, a):
    """Footer phrase for data served from cache after a failed refresh, or ""
    when everything is current. entries: the bag's 5-tuples. -3 means the
    cache's own timestamp is unusable, which must be said, not hidden."""
    worst, unknown = 0, False
    for e in entries:
        sta = e[2]
        if sta == -3:
            unknown = True
        elif sta > 0:
            worst = max(worst, sta)
    if unknown:
        return " %s stale, age unknown" % bul_(a)
    if worst:
        return " %s stale %s" % (bul_(a), ago(worst))
    return ""


def ago(sec):
    """age() plus the right preposition: "just now", or "3m ago"."""
    a_ = age(sec)
    return a_ if a_ == "just now" else a_ + " ago"


def age(sec):
    if sec < 60:
        return "just now"
    if sec < 3600:
        return "%dm" % (sec // 60)
    if sec < 86400:
        return "%dh" % (sec // 3600)
    return "%dd" % (sec // 86400)


def shutil_copy(a, b):
    import shutil
    shutil.copy2(a, b)


SRCC = ("36", "35", "32", "33", "34", "95")     # stable per-source hues


def pal(on):
    w = (lambda c: (lambda t: "\033[%sm%s\033[0m" % (c, t))) if on else (lambda c: (lambda t: t))
    return {"d": w("2"), "b": w("1"), "red": w("31"), "grn": w("32"), "yel": w("33"),
            "cyn": w("36"), "hdr": w("1;36"), "n": (lambda t: t)}


def srcpaint(name, on):
    if not on:
        return lambda t: t
    return lambda t: "\033[%sm%s\033[0m" % (SRCC[sum(map(ord, name)) % len(SRCC)], t)


def agepaint(sec, P):
    if sec < 3600:
        return P["grn"]
    if sec < 86400:
        return P["n"]
    return P["d"]


def _plain(s):
    """Visible width: colour codes take no columns."""
    return re.sub(r"\x1b\[[0-9;]*m", "", s)


def kbs(n):
    """Compact, fixed-width-ish: a phone terminal is 40 columns."""
    if n < 1024:
        return "%dB" % n
    if n < 1024 * 1024:
        return "%.1fK" % (n / 1024.0)
    return "%.1fM" % (n / 1048576.0)


def wrapout(text, P, cols, indent="  "):
    """Footers carry variable-length source lists; wrap instead of overflowing."""
    import textwrap
    for ln in textwrap.wrap(text, max(20, cols - 2), initial_indent=indent,
                            subsequent_indent=indent + "  ") or [indent]:
        print(P["d"](ln))


def cols_():
    try:                               # COLUMNS wins: os.get_terminal_size ignores it
        return max(20, min(int(os.environ["COLUMNS"]), 200))
    except Exception:
        pass
    try:
        return min(os.get_terminal_size().columns, 100)
    except Exception:
        return 46


def jwrite(path, obj):
    """Never let a full disk or a read-only home take the whole command down."""
    tmp = "%s.tmp%d" % (path, os.getpid())
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(obj, f, separators=(",", ":"))
        os.replace(tmp, path)          # atomic: a second terminal sees old or new
        return True
    except Exception:
        try:
            os.remove(tmp)
        except Exception:
            pass
        return False


def jread(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            v = json.load(f)
        return v if isinstance(v, type(default)) else default
    except Exception:
        return default





def bul_(a):
    return "-" if a.ascii else "\u00b7"


def when_sort(it):
    """A date we will not display is a date we will not rank by. Minor skew is
    tolerated; anything beyond an hour ahead sorts as undated."""
    d = it.get("d") or 0
    return 0 if d > int(time.time()) + 3600 else d


def key(t):
    k = re.sub(r"[^a-z0-9]", "", (t or "").lower())[:60]
    if len(k) < 6:          # CJK, Cyrillic, Greek etc. reduce to nothing
        import hashlib
        k = "h" + hashlib.sha1((t or "").encode("utf-8")).hexdigest()[:16]
    return k


def sources(a):
    os.makedirs(CFD, exist_ok=True)
    if not os.path.exists(CFG):
        jwrite(CFG, DEFAULTS)
    s = jread(CFG, None)
    if s is None:
        try:
            with open(CFG, encoding="utf-8") as fh:
                s = json.load(fh)
        except Exception:
            s = DEFAULTS
    if not isinstance(s, list):
        s = DEFAULTS
    ok, seen = [], set()
    for x in s:
        if not isinstance(x, dict) or not x.get("url"):
            continue
        u_ = str(x["url"]).strip().lower()
        if not (u_.startswith("http://") or u_.startswith("https://")):
            continue                      # no file://, no ftp:// from a config file
        i = re.sub(r"[^A-Za-z0-9_-]", "", str(x.get("id") or ""))[:24]
        if i.upper() in WINRESERVED:      # CON, NUL, COM1... unopenable on Windows
            i += "_"
        if not i or i in seen:            # ids index cache files: no dupes, no ../
            continue
        seen.add(i)
        x["id"] = i
        x["name"] = clean(str(x.get("name") or i), 32) or i   # no escapes to the terminal
        x.setdefault("kind", "rss")
        try:
            x["ttl"] = max(0, min(int(x.get("ttl") or TTL), 604800))
        except Exception:
            x["ttl"] = TTL
        try:
            x["timeout"] = max(3, min(int(x.get("timeout") or 10), 60))
        except Exception:
            x["timeout"] = 10
        c = x.get("cats")
        cs = []
        for z in (c if isinstance(c, list) else []):
            z = norm_cat(z)
            if z and z not in cs:
                cs.append(z)
        x["cats"] = cs or ["top"]
        ok.append(x)
    s = ok or DEFAULTS
    if a.only:
        want = {y.strip().lower() for y in a.only.split(",")}
        s = [x for x in s if x["id"].lower() in want]
        if not s:
            sys.exit("news: no source id matches %r (try: news -l)" % a.only)
        return s
    c = (a.cat or "top").lower()
    if c == "all":
        return s
    sel = [x for x in s if c in [z.lower() for z in x["cats"]]]
    if not sel:
        cats = sorted({z for x in s for z in x["cats"]})
        sys.exit("news: no category %r. try: %s, all" % (c, ", ".join(cats)))
    return sel


# ---------------------------------------------------------------- catalog
# An apt-style list of feeds one can subscribe to. The list is data, fetched
# from the project's repository like a package index: one small gzipped file,
# conditional on its ETag, never applied on its own. Nothing in it changes
# what you are subscribed to until you say so.
CATALOG_URL = (os.environ.get("LPN_CATALOG_URL") or
               "https://raw.githubusercontent.com/ATinyGreenCell/LowPingNews/main/catalog.json")
CATC = CD + "/catalog.json"            # the fetched index, with its validators
CATCAP = 256 * 1024                    # an index bigger than this is not an index
CATMAXFEEDS = 500
PROBECAP = 16 * 1024                   # a probe reads at most this much
KINDS = ("rss", "hn", "epmc")
CATMAX = 20
# words the command line already gives meaning to can never be categories
RESERVED_CATS = {"radio", "noaa", "all", "weather", "signal", "saved", "catalog", "feeds", "help",
                 "update", "list", "add", "remove", "check", "upgrade"}


def norm_cat(c):
    """A category is a short lowercase word: 'My Stuff!' -> 'my-stuff'."""
    c = str(c or "").strip().lower().replace(" ", "-")
    c = re.sub(r"[^\w-]", "", c)[:CATMAX].strip("-_")   # letters in any script
    if c.isdigit():
        return ""                          # `lowpingnews 13` means thirteen articles
    return "" if c in RESERVED_CATS else c


def norm_id(i):
    i = re.sub(r"[^A-Za-z0-9_-]", "", str(i or ""))[:24]
    if i.upper() in WINRESERVED:
        i += "_"
    return i


def same_url(a_, b_):
    """Equal for subscription purposes: scheme and host case, trailing slash."""
    def k(u):
        u = (u or "").strip()
        m = re.match(r"(?i)(https?)://([^/?#]+)(.*)$", u)
        if not m:
            return u
        return "%s://%s%s" % (m.group(1).lower(), m.group(2).lower(),
                              m.group(3).rstrip("/") or "")
    return k(a_) == k(b_)


def catalog_entry(x):
    """One catalog feed, validated field by field. None if unusable. Every
    field may have come from the network, so none of it is trusted."""
    if not isinstance(x, dict):
        return None
    i = norm_id(x.get("id"))
    u = safe_url(str(x.get("url") or ""))
    if not i or not u or len(u) > 600:
        return None
    cats = []
    for c in (x.get("cats") if isinstance(x.get("cats"), list) else [])[:8]:
        c = norm_cat(c)
        if c and c not in cats:
            cats.append(c)
    if not cats:
        return None
    e = {"id": i, "name": clean(str(x.get("name") or i), 32) or i, "url": u,
         "cats": cats, "kind": x.get("kind") if x.get("kind") in KINDS else "rss"}
    for f_, lo, hi in (("ttl", 60, 604800), ("timeout", 3, 60)):
        try:
            if x.get(f_) is not None:
                e[f_] = max(lo, min(int(x[f_]), hi))
        except (TypeError, ValueError):
            pass
    for f_ in ("kb", "raw"):
        try:
            v = float(x[f_])
            if 0 <= v < 1e6 and v == v:         # NaN fails v == v
                e[f_] = round(v, 1)
        except (KeyError, TypeError, ValueError):
            pass
    for f_ in ("gz", "val", "rec"):
        if isinstance(x.get(f_), bool):
            e[f_] = x[f_]
    for f_, n in (("ok", 10), ("fail", 40), ("note", 60)):
        if isinstance(x.get(f_), str) and x[f_].strip():
            e[f_] = clean(x[f_], n)
    return e


def catalog_validate(obj):
    """-> {"feeds": [...], "cats": {...}, "updated": str}. Bad entries are
    dropped one by one; an index with nothing usable is rejected whole."""
    if not isinstance(obj, dict) or not isinstance(obj.get("feeds"), list):
        raise ValueError("not a feed index")
    feeds, seen = [], set()
    for x in obj["feeds"][:CATMAXFEEDS]:
        e = catalog_entry(x)
        if e and e["id"] not in seen:
            seen.add(e["id"])
            feeds.append(e)
    if not feeds:
        raise ValueError("no usable feeds in the index")
    cats = {}
    raw_c = obj.get("cats") if isinstance(obj.get("cats"), dict) else {}
    for k_, v in list(raw_c.items())[:64]:
        k2 = norm_cat(k_)
        if k2:
            cats[k2] = clean(str(v), 40) or k2
    for e in feeds:
        for c in e["cats"]:
            cats.setdefault(c, c)
    return {"feeds": feeds, "cats": cats,
            "updated": clean(str(obj.get("updated") or ""), 10)}


CATOLD = 14 * 86400                    # an index older than this gets a nudge


def starred(e):
    """A star claims "light and reliable". Being picked is not enough: it also
    needs a recorded check (`catalog check all --write catalog.json`) that
    found it working and has not since found it failing."""
    return bool(e.get("rec") and e.get("ok") and not e.get("fail"))


def catalog_age_note(idx):
    """How current the local copy of the index is - not when it was published,
    which says nothing about how long ago anyone checked for a newer one."""
    if idx.get("updated") == "built-in" or not idx.get("fetched"):
        return "built-in list - catalog update for more"
    a_ = age_of(idx.get("fetched"))
    if a_ == float("inf"):
        return "index age unknown - catalog update"
    if a_ > CATOLD:
        return "checked %s - catalog update" % ago(int(a_))
    return "checked %s" % ago(int(a_))


# The index as shipped. With no network at all a new install can still offer
# every recommended feed, and `catalog export` writes it out as catalog.json,
# which is how the published index is first created. Validated like any
# fetched index; if it were ever damaged, the defaults alone are offered.
CATALOG_SEED = '{"v":1,"updated":"2026-10-03","about":"Feeds LowPingNews can subscribe to. kb = compressed size on the wire; gz = server compresses; val = sends ETag/Last-Modified so unchanged refreshes are cheap; ok = month last verified; rec = recommended: light and reliable.","cats":{"top":"Headlines","world":"World","science":"Science","tech":"Technology","bio":"Biology and preprints","health":"Health","alerts":"Hazards and emergencies","app":"LowPingNews releases"},"feeds":[{"id":"bbc","name":"BBC World","url":"https://feeds.bbci.co.uk/news/world/rss.xml","cats":["top","world"],"kb":4.3,"gz":true,"val":false,"ok":"2026-09","rec":true},{"id":"csm","name":"CS Monitor","url":"https://rss.csmonitor.com/feeds/world","cats":["top","world"],"kb":4.4,"gz":true,"val":false,"ok":"2026-09","rec":true},{"id":"dw","name":"DW","url":"https://rss.dw.com/rdf/rss-en-all","cats":["top","world"],"kb":26.3,"gz":true,"val":false,"ok":"2026-09"},{"id":"aje","name":"Al Jazeera","url":"https://www.aljazeera.com/xml/rss/all.xml","cats":["world"],"kb":4.1,"gz":true,"val":true,"ok":"2026-09","rec":true},{"id":"f24","name":"France 24","url":"https://www.france24.com/en/rss","cats":["world"],"kb":8.5,"gz":true,"val":false,"ok":"2026-09"},{"id":"npr","name":"NPR News","url":"https://feeds.npr.org/1001/rss.xml","cats":["top","world"]},{"id":"guardian","name":"Guardian World","url":"https://www.theguardian.com/world/rss","cats":["world"]},{"id":"un","name":"UN News","url":"https://news.un.org/feed/subscribe/en/news/all/rss.xml","cats":["world"]},{"id":"phys","name":"Phys.org","url":"https://phys.org/rss-feed/","cats":["top","science"],"kb":7.8,"gz":true,"val":false,"ok":"2026-09","rec":true},{"id":"sd","name":"ScienceDaily","url":"https://www.sciencedaily.com/rss/all.xml","cats":["science"],"kb":12.1,"gz":true,"val":true,"ok":"2026-09"},{"id":"quanta","name":"Quanta","url":"https://api.quantamagazine.org/feed/","cats":["science"],"kb":3.1,"gz":true,"val":true,"ok":"2026-09","rec":true},{"id":