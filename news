def D_(i, n, u, c, k="rss", ttl=None, timeout=None):
    d = {"id": i, "name": n, "url": u, "cats": c, "kind": k}
    if ttl:
        d["ttl"] = ttl
    if timeout:
        d["timeout"] = timeout
    return d


HEAVY = 6 * 3600               # slow-publishing feeds that send no validators
