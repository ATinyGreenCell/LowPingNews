#!/usr/bin/env python3
"""news - ultra-light terminal headlines. Parallel gzipped fetch, cached for offline."""
import datetime as dt, json, os, re, sys, time
# Everything else is imported lazily. urllib.request alone drags in email and
# http.client for ~100ms, and a cached run never opens a socket.

VERSION = "3.2"
DATA = os.path.expanduser("~/.local/share/news")
ADIR = DATA + "/art"
NET = DATA + "/net.json"
WMO = {0: ("Clear", "CL"), 1: ("Mostly clear", "MC"), 2: ("Partly cloudy", "PC"),
       3: ("Overcast", "OV"), 45: ("Fog", "FG"), 48: ("Rime fog", "FG"),
       51: ("Light drizzle", "dz"), 53: ("Drizzle", "dz"), 55: ("Drizzle", "DZ"),
       56: ("Frz drizzle", "FZ"), 57: ("Frz drizzle", "FZ"), 61: ("Light rain", "rn"),
       63: ("Rain", "RN"), 65: ("Heavy rain", "RN"), 66: ("Frz rain", "FZ"),
       67: ("Frz rain", "FZ"), 71: ("Light snow", "sn"), 73: ("Snow", "SN"),
       75: ("Heavy snow", "SN"), 77: ("Snow grains", "sn"), 80: ("Showers", "sh"),
       81: ("Showers", "sh"), 82: ("Hvy showers", "SH"), 85: ("Snow showers", "SS"),
       86: ("Snow showers", "SS"), 95: ("Thunderstorm", "TS"),
       96: ("Thunderstorm", "TS"), 99: ("Thunderstorm", "TS")}
BLK = "\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588"
ABLK = "._-~=+*#"
NETCAP = 200
ARTCAP = 3 * 1024 * 1024        # offline library ceiling
FEEDCAP = 2 * 1024 * 1024       # refuse oversized feeds and gzip bombs
PAGECAP = 5 * 1024 * 1024
STARCAP = 500
STORECAP = 40                  # items kept per feed; DW ships 136, you read 5
DLBUDGET = 4 * 1024 * 1024     # ceiling for one -d run; raise with --budget
ST = DATA + "/state.json"
CD = os.path.expanduser("~/.cache/news")
CFD = os.path.expanduser("~/.config/news")
WXLOC = CFD + "/loc.json"
WXC = CD + "/weather.json"
WXTTL = 1800
CFG = CFD + "/sources.json"
LAST = CD + "/last.json"
TTL = 900                      # a feed younger than this is reused, no request
DEADLINE = 20                  # hard ceiling on the whole fetch round
MAXPAR = 6                     # concurrent fetches; a phone radio is not a datacentre
ARTMAX = 200000                # per-article text ceiling
UA = "news/1.0 (+termux)"

def D_(i, n, u, c, k="rss", ttl=None):
    d = {"id": i, "name": n, "url": u, "cats": c, "kind": k}
    if ttl:
        d["ttl"] = ttl
    return d


HEAVY = 6 * 3600               # slow-publishing feeds that send no validators
DEFAULTS = [
    # general - center-rated, wire//institutional rather than opinion-led
    D_("bbc", "BBC World", "https://feeds.bbci.co.uk/news/world/rss.xml",
       ["top", "world"]),
    D_("csm", "CS Monitor", "https://rss.csmonitor.com/feeds/world",
       ["top", "world"]),
    D_("dw", "DW", "https://rss.dw.com/rdf/rss-en-all", ["top", "world"]),
    D_("aje", "Al Jazeera", "https://www.aljazeera.com/xml/rss/all.xml", ["world"]),
    D_("f24", "France 24", "https://www.france24.com/en/rss", ["world"]),
    # science - low political valence, high factual
    D_("phys", "Phys.org", "https://phys.org/rss-feed/", ["top", "science"]),
    D_("sd", "ScienceDaily", "https://www.sciencedaily.com/rss/all.xml", ["science"]),
    D_("quanta", "Quanta", "https://api.quantamagazine.org/feed/", ["science"]),
    D_("nature", "Nature", "https://www.nature.com/nature.rss", ["science"],
       ttl=HEAVY),
    # tech
    D_("ars", "Ars Technica", "https://feeds.arstechnica.com/arstechnica/index",
       ["top", "tech"]),
    D_("reg", "The Register", "https://www.theregister.com/headlines.atom", ["tech"]),
    D_("hn", "Hacker News", "https://hn.algolia.com/api/v1/search"
       "?tags=front_page&hitsPerPage=20", ["tech"], "hn"),
    # bio - preprints, no editorial layer at all
    D_("brxp", "bioRxiv plant",
       "https://connect.biorxiv.org/biorxiv_xml.php?subject=plant_biology", ["bio"],
       ttl=HEAVY),
    D_("brxs", "bioRxiv synbio",
       "https://connect.biorxiv.org/biorxiv_xml.php?subject=synthetic_biology", ["bio"],
       ttl=HEAVY),
