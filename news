ATOM = "{http://www.w3.org/2005/Atom}"
TAGS = re.compile(r"<[^>]+>")
WS = re.compile(r"\s+")


def clean(s, limit=400):
    if not s:
        return ""
    import html
    for _ in range(2):            # content:encoded arrives escaped: unescape, then strip
        s = TAGS.sub(" ", html.unescape(s))
    s = WS.sub(" ", s).strip()
    s = re.sub(r" +([,.;:!?%)\]])", r"\1", s)      # tag-stripping leaves gaps
    s = re.sub(r"([(\[]) +", r"\1", s)
    return s[:limit]


def when(s):
    """RSS pubDate or Atom ISO timestamp -> epoch seconds, 0 if unparseable."""
    if not s:
        return 0
    s = s.strip()
    import email.utils
    try:
        d = email.utils.parsedate_to_datetime(s)
        if d.tzinfo is None:           # legal in RSS; .timestamp() would assume local
            d = d.replace(tzinfo=dt.timezone.utc)
        return int(d.timestamp())
    except Exception:
        pass
    try:
        d = dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
        if d.tzinfo is None:
            d = d.replace(tzinfo=dt.timezone.utc)
        return int(d.timestamp())
    except Exception:
        return 0


def state(w=None):
    if w is not None:
        w["read"] = w["read"][-4000:]
        jwrite(ST, w)
        return w
    v = jread(ST, {})
    if not isinstance(v.get("read"), list):
        v["read"] = []
    if not isinstance(v.get("star"), list):
        v["star"] = []
    return v


def apath(k):
    return "%s/%s.txt" % (ADIR, k)


def have(k):
    return os.path.exists(apath(k))


def store_article(k, txt):
    try:
        os.makedirs(ADIR, exist_ok=True)
        with open(apath(k), "w", encoding="utf-8") as fh:
            fh.write(txt)
    except Exception:
        return
    try:
        f = [(os.path.getmtime(ADIR + "/" + x), os.path.getsize(ADIR + "/" + x), x)
             for x in os.listdir(ADIR)]
    except OSError:
        return
    tot = sum(z[1] for z in f)
    for mt, sz, name in sorted(f):                  # evict oldest until under cap
        if tot <= ARTCAP:
            break
        try:
            os.remove(ADIR + "/" + name)
            tot -= sz
        except OSError:
            pass


def fetch_article(it):
    """-> (text, bytes_over_wire, source). Feed body and offline copies are free."""
    k = key(it["ti"])
    if it.get("c"):
        return it["c"], 0, "feed"
    if have(k):
        try:
            return open(apath(k), encoding="utf-8").read(), 0, "offline"
        except OSError:
            pass
    if not it.get("u"):
        return "", 0, "nolink"
    raw, _, wire = get(it["u"], 20, cap=PAGECAP)
    txt = extract(raw)
    txt = txt[:ARTMAX]
    if txt:
        store_article(k, txt)
    return txt, wire, "web"


_RD = [None]


def _readable():
    if _RD[0] is None:
        from html.parser import HTMLParser

        class Readable(HTMLParser):
            """Paragraph text only. No JS: paywalled pages come back empty."""
            SKIP = {"script", "style", "nav", "aside", "footer", "header", "form",
                    "noscript", "figure", "svg", "button", "select"}
            KEEP = {"p", "h1", "h2", "h3", "li", "blockquote"}

            def __init__(self):
                super().__init__(convert_charrefs=True)
                self.depth, self.cur, self.out = 0, [], []

            def handle_starttag(self, t, a):
                if t in self.SKIP:
                    self.depth += 1
                elif t in self.KEEP and not self.depth:
                    self.cur = []

            def handle_endtag(self, t):
                if t in self.SKIP and self.depth:
                    self.depth -= 1
                elif t in self.KEEP and not self.depth:
                    x = " ".join("".join(self.cur).split())
                    if len(x) > 40:
                        self.out.append(x)
                    self.cur = []

            def handle_data(self, d):
                if not self.depth:
                    self.cur.append(d)
        _RD[0] = Readable
    return _RD[0]


def _meta_fallback(txt):
    """Most sites embed the body in JSON-LD or a description tag. Already paid for."""
    import html as _h
    m = re.search(r'"articleBody"\s*:\s*"((?:[^"\\]|\\.)*)"', txt)
    if m:
        try:
            body = json.loads('"%s"' % m.group(1))
        except Exception:
            body = m.group(1)
        body = " ".join(body.split())
        if len(body) > 200:
            return body
    for pat in (r'<meta[^>]+property=["\']og:description["\'][^>]+content=["\']([^"\']{80,})',
                r'<meta[^>]+name=["\']description["\'][^>]+content=["\']([^"\']{80,})'):
        m = re.search(pat, txt, re.I)
        if m:
            return " ".join(_h.unescape(m.group(1)).split())
    return ""


def extract(raw):
    p = _readable()()
    try:
        p.feed(raw.decode("utf-8", "replace"))
    except Exception:
        pass
    out = "\n\n".join(p.out[:120])
    if len(out) < 200:            # paywalled or JS-rendered: try the embedded copy
        alt = _meta_fallback(raw.decode("utf-8", "replace"))
        if len(alt) > len(out):
            return alt
    return out


def get(url, t=10, extra=None, cap=FEEDCAP):
    """-> (body, headers, wire_bytes). Raises HTTPError(304) when unchanged."""
    h = {"Accept-Encoding": "gzip, deflate", "User-Agent": UA}
    h.update(extra or {})
    import urllib.parse, urllib.request, zlib
    if urllib.parse.urlsplit(url).scheme not in ("http", "https"):
        raise ValueError("refusing non-http url")
    r = urllib.request.Request(url, headers=h)
    with urllib.request.urlopen(r, timeout=t) as f:
        b = f.read(cap + 1)
        if len(b) > cap:
            raise ValueError("response exceeds %s cap" % kb(cap))
        wire = len(b)                     # compressed: what the data plan is billed
        ce = (f.headers.get("Content-Encoding") or "").lower()
        if ce in ("gzip", "deflate", "x-gzip"):
            for wbits in ((16 + zlib.MAX_WBITS,) if "gzip" in ce
                          else (zlib.MAX_WBITS, -zlib.MAX_WBITS)):
                try:
                    z = zlib.decompressobj(wbits)
                    out = z.decompress(b, cap + 1)   # bounded: a bomb stops here
                    if z.unconsumed_tail:
                        raise ValueError("decompressed body exceeds %s cap" % kb(cap))
                    b = out
                    break
                except zlib.error:
                    continue                  # raw deflate vs zlib-wrapped: try both
        return b, f.headers, wire


def parse_feed(raw):
    """RSS 2.0, RSS 1.0/RDF and Atom, without caring which one showed up."""
    import xml.etree.ElementTree as ET
    try:
        root = ET.fromstring(raw)
    except ET.ParseError:
        loose = parse_loose(raw)
        if loose:
            return loose
        raise
    for el in root.iter():                       # drop namespaces, then treat alike
        if "}" in el.tag:
            el.tag = el.tag.split("}", 1)[1]
    out = []
    for it in list(root.iter("item")) + list(root.iter("entry")):
        def txt(*names):
            for n in names:
                e = it.find(n)
                if e is not None and e.text and e.text.strip():
                    return e.text
            return ""
        link = ""
        for l in it.iter("link"):
            if l.get("href"):                    # Atom: prefer rel=alternate
                if l.get("rel", "alternate") == "alternate":
                    link = l.get("href")
                    break
                link = link or l.get("href")
            elif l.text and l.text.strip():
                link = l.text.strip()
                break
        ti = clean(txt("title"), 200)
        if not ti:
            continue
        short = clean(txt("description", "summary", "content"))
        full = clean(txt("encoded", "content", "description"), 6000)
        rec = {"ti": ti, "u": link, "s": short,
               "d": when(txt("pubDate", "published", "date", "updated"))}
        if len(full) > len(short) + 200:      # feed shipped the body: already paid for
            rec["c"] = full
        out.append(rec)
    return out


def parse_loose(raw):
    """Last resort for feeds with invalid XML. Real feeds are often slightly broken."""
    txt = raw.decode("utf-8", "replace")
    out = []
    for m in re.finditer(r"<(item|entry)\b[^>]*>(.*?)</\1>", txt, re.S | re.I):
        blk = m.group(2)

        def g(*names):
            for n in names:
                mm = re.search(r"<%s\b[^>]*>(.*?)</%s>" % (n, n), blk, re.S | re.I)
                if mm and mm.group(1).strip():
                    return mm.group(1)
            return ""
        ti = clean(g("title"), 200)
        if not ti:
            continue
        link = g("link").strip()
        if not link:
            mm = re.search(r'<link[^>]*href=["\']([^"\']+)', blk, re.I)
            link = mm.group(1) if mm else ""
        out.append({"ti": ti, "u": link,
                    "s": clean(g("description", "summary")),
                    "d": when(g("pubDate", "published", "date", "updated"))})
        if len(out) > 200:
            break
    return out


def parse_hn(raw):
    j = json.loads(raw)
    out = []
    for h in j.get("hits", []):
        pts, nc = h.get("points") or 0, h.get("num_comments") or 0
        out.append({
            "ti": clean(h.get("title") or h.get("story_title") or "", 200),
            "u": h.get("url") or ("https://news.ycombinator.com/item?id=%s"
                                  % h.get("objectID", "")),
            "s": "%d points, %d comments" % (pts, nc),
            "d": int(h.get("created_at_i") or 0)})
    return out


def load(src, fresh, bag):
    """Fetch or reuse one source. Never raises - records the failure instead."""
    cf = "%s/%s.json" % (CD, src["id"])
    ttl = src.get("ttl") or TTL
    if not fresh and os.path.exists(cf):
        try:
            c = json.load(open(cf, encoding="utf-8"))
            if time.time() - c.get("t", 0) < ttl:
                bag[src["id"]] = (c["items"], 0, 0, 0)
                return
        except Exception:
            pass
    import urllib.error
    c = None
    try:
        c = json.load(open(cf, encoding="utf-8"))
    except Exception:
        pass
    val = {}
    if c:                                  # conditional GET: 304 costs ~0 bytes
        if c.get("et"):
            val["If-None-Match"] = c["et"]
        if c.get("lm"):
            val["If-Modified-Since"] = c["lm"]
        elif c.get("t"):                   # no server validator: ask with our own
            import email.utils
            val["If-Modified-Since"] = email.utils.formatdate(c["t"], usegmt=True)
    t_start = time.time()
    try:
        try:
            try:
                raw, rh, wire = get(src["url"], extra=val)
            except urllib.error.HTTPError:
                raise                      # a real HTTP answer: do not retry
            except Exception:
                time.sleep(0.4)            # transient drop on a weak signal
                raw, rh, wire = get(src["url"], extra=val)
        except urllib.error.HTTPError as he:
            if he.code == 304 and c:
                c["t"] = int(time.time())
                jwrite(cf, c)
                bag[src["id"]] = (c["items"], 0, 0, 1)
                bag.setdefault("_net", []).append(
                    (True, (time.time() - t_start) * 1000, 0))
                return
            raise
        items = parse_hn(raw) if src["kind"] == "hn" else parse_feed(raw)
        items = [i for i in items if i["ti"]]
        items = sorted(items, key=lambda z: -(z.get("d") or 0))[:STORECAP]
        if not items:
            raise ValueError("no items parsed")
        rec = {"t": int(time.time()), "items": items, "w": wire}
        if rh.get("ETag"):
            rec["et"] = rh["ETag"]
        if rh.get("Last-Modified"):
            rec["lm"] = rh["Last-Modified"]
        jwrite(cf, rec)
        bag[src["id"]] = (items, wire, 0, 0)
        bag.setdefault("_net", []).append((True, (time.time() - t_start) * 1000, wire))
    except Exception as e:
        if os.path.exists(cf):                      # offline: stale beats nothing
            try:
                c = json.load(open(cf, encoding="utf-8"))
                bag[src["id"]] = (c["items"], 0, int(time.time() - c.get("t", 0)), 0)
                return
            except Exception:
                pass
        bag[src["id"]] = ([], 0, -1, 0)
        bag.setdefault("_net", []).append((False, (time.time() - t_start) * 1000, 0))
        bag.setdefault("_err", {})[src["id"]] = str(e)[:60]


def net_log(entries):
    if not entries:
        return
    d = jread(NET, {})
    log = d.get("log") or []
    day = d.get("day") or {}
    today = dt.date.today().isoformat()
    for ok, ms, wire in entries:
        log.append([int(time.time()), 1 if ok else 0, int(ms), int(wire)])
        day[today] = day.get(today, 0) + int(wire)
    d["log"] = log[-NETCAP:]
    for k in list(day):                    # keep a fortnight of daily totals
        if k < (dt.date.today() - dt.timedelta(days=14)).isoformat():
            day.pop(k, None)
    d["day"] = day
    jwrite(NET, d)


def net_stats():
    d = jread(NET, {})
    log = d.get("log") or []
    recent = log[-30:]
    if not recent:
        return None
    ok = [r for r in recent if r[1]]
    rate = 100.0 * len(ok) / len(recent)
    lat = sorted(r[2] for r in ok) or [0]
    med = lat[len(lat) // 2]
    tp = sorted((r[3] * 1000.0 / r[2]) for r in ok if r[2] > 0 and r[3] > 0)
    return {"n": len(recent), "rate": rate, "ms": med,
            "bps": (tp[len(tp) // 2] if tp else 0), "day": d.get("day") or {}}


def hostport(url):
    """(host, port) from a feed URL. Probing a hardcoded 443 reports a plain-http
    or non-standard-port feed as unreachable, which is worse than not probing."""
    rest = url.split("//", 1)[-1].split("/", 1)[0]
    default = 443 if url.lower().startswith("https") else 80
    if rest.startswith("["):                      # IPv6 literal
        h, _, tail = rest.partition("]")
        return h[1:], int(tail[1:]) if tail.startswith(":") and tail[1:].isdigit() else default
    if ":" in rest:
        h, _, p = rest.rpartition(":")
        if p.isdigit():
            return h, int(p)
    return rest, default


def probe(targets, n=3):
    """DNS + TCP connect to the hosts we actually fetch from. No ICMP: carriers
    drop it independently of TCP, and it skips DNS, which is the usual killer
    on a lossy link. Costs a SYN/ACK per attempt, no TLS, no payload."""
    import socket
    res = []
    for h, port in targets:
        dns, tcp, fails, cold = [], [], 0, None
        for i in range(n):
            t0 = time.time()
            try:
                socket.getaddrinfo(h, port, 0, socket.SOCK_STREAM)
                t1 = time.time()
                if cold is None:
                    cold = (t1 - t0) * 1000     # first lookup only: rest are cached
                dns.append((t1 - t0) * 1000)
                c = socket.create_connection((h, port), timeout=6)
                tcp.append((time.time() - t1) * 1000)
                c.close()
            except Exception:
                fails += 1
        med = lambda v: sorted(v)[len(v) // 2] if v else None
        res.append({"host": h, "port": port, "dns_cold": cold, "dns": med(dns),
                    "tcp": med(tcp), "loss": 100.0 * fails / n})
    return res


def icmp(host, n=3):
    """Supplementary only, and absent on most Termux installs."""
    import shutil, subprocess
    if not shutil.which("ping"):
        return None
    try:
        r = subprocess.run(["ping", "-c", str(n), "-W", "2", host],
                           capture_output=True, timeout=12, text=True)
    except Exception:
        return None
    m = re.search(r"(\d+(?:\.\d+)?)% packet loss", r.stdout)
    t = re.search(r"=\s*[\d.]+/([\d.]+)/", r.stdout)
    if not m:
        return None
    return {"loss": float(m.group(1)), "avg": float(t.group(1)) if t else None}


def radio():
    """Best-effort. termux-api is optional and these calls are slow-ish, so this
    is only invoked by `news signal`, never on a normal run."""
    import shutil, subprocess
    out = []
    for cmd, want in (("termux-wifi-connectioninfo", "wifi"),
                      ("termux-telephony-cellinfo", "cell")):
        if not shutil.which(cmd):
            continue
        try:
            r = subprocess.run([cmd], capture_output=True, timeout=6, text=True)
            j = json.loads(r.stdout or "null")
        except Exception:
            continue
        if want == "wifi" and isinstance(j, dict) and j.get("rssi") is not None:
            if j.get("supplicant_state") in (None, "COMPLETED"):
                out.append(("wifi", j.get("rssi"), "%s Mbps" % j.get("link_speed_mbps", "?")))
        elif want == "cell" and isinstance(j, list):
            for c in j:
                dbm = c.get("dbm")
                if dbm is not None:
                    out.append((c.get("type", "cell"), dbm, c.get("level", "")))
    return out


def wx_locate(a):
    if getattr(a, "coords", None):
        try:
            la, lo = [float(x) for x in a.coords.replace(" ", "").split(",")]
        except Exception:
            sys.exit("news: coords look like 40.900,-73.412")
        d = {"lat": round(la, 3), "lon": round(lo, 3),
             "label": getattr(a, "label", None)}
        jwrite(WXLOC, d)
        return d
    d = jread(WXLOC, {})
    if d.get("lat") is not None:
        return d
    try:                                   # Termux GPS if the API app is present
        import shutil, subprocess
        if shutil.which("termux-location"):
            o = subprocess.run(["termux-location", "-p", "network"],
                               capture_output=True, timeout=25, text=True)
            j = json.loads(o.stdout or "null")
            if j and j.get("latitude") is not None:
                d = {"lat": round(float(j["latitude"]), 3),
                     "lon": round(float(j["longitude"]), 3), "label": None}
                jwrite(WXLOC, d)
                return d
    except Exception:
        pass
    sys.exit("news: no location. Pin it once:\n"
             "  lowpingnews weather -c 40.900,-73.412 --label 'Fleets Cove'")


def wx_fetch(loc, unit, fresh):
    """One gzipped Open-Meteo call, cached like any feed."""
    c = jread(WXC, {})
    fresh_enough = (not fresh and c.get("t")
                    and time.time() - c["t"] < WXTTL
                    and c.get("u") == unit
                    and abs((c.get("lat") or 999) - loc["lat"]) < .05
                    and abs((c.get("lon") or 999) - loc["lon"]) < .05)
    if fresh_enough:
        return c["d"], 0, int(time.time() - c["t"]), False
    q = ("latitude=%s&longitude=%s&current=temperature_2m,apparent_temperature,"
         "weather_code,wind_speed_10m,wind_direction_10m,relative_humidity_2m,is_day"
         "&hourly=temperature_2m,precipitation_probability,weather_code"
         "&daily=weather_code,temperature_2m_max,temperature_2m_min,"
         "precipitation_probability_max&forecast_hours=24&forecast_days=7"
         "&timeformat=unixtime&timezone=auto&temperature_unit=%s&wind_speed_unit=%s"
         "&cell_selection=land"
         % (loc["lat"], loc["lon"], unit,
            "mph" if unit == "fahrenheit" else "kmh"))
    try:
        raw, _, wire = get("https://api.open-meteo.com/v1/forecast?" + q, 15)
        d = json.loads(raw)
        if d.get("error"):
            raise ValueError(d.get("reason", "api error"))
        jwrite(WXC, {"t": int(time.time()), "u": unit, "lat": loc["lat"],
                     "lon": loc["lon"], "d": d})
        net_log([(True, 0, wire)])
        return d, wire, 0, False
    except Exception as e:
        if c.get("d"):                     # offline: stale beats nothing
            return c["d"], 0, int(time.time() - c["t"]), True
        sys.exit("news: no forecast and no cache (%s)" % str(e)[:60])


def spark(v, asc):
    ch = ABLK if asc else BLK
    lo, hi = min(v), max(v)
    sp = (hi - lo) or 1.0
    return "".join(ch[min(7, int((x - lo) / sp * 7.999))] for x in v)


def rainbar(p, asc):
    ch = ABLK if asc else BLK
    dry = "." if asc else "\u00b7"     # parenthesised: the unbracketed form made
    return "".join(dry if (x or 0) < 10  # ascii mode draw a flat line of dots
                   else ch[min(7, int((x or 0) / 100 * 7.999))] for x in p)


def wx_show(a, P, loc, d, wire, age_s, stale):
    D, B = P["d"], P["b"]
    cols = cols_()
    cu, h, dy = d["current"], d["hourly"], d["daily"]
    off = d.get("utc_offset_seconds", 0)
    L = lambda t: dt.datetime.fromtimestamp(t + off, dt.timezone.utc)
    U = "\u00b0F" if a.unit == "fahrenheit" else "\u00b0C"
    t0 = L(cu["time"])
    name, mark = WMO.get(int(cu.get("weather_code") or 0), ("Unknown", "??"))
    if not cu.get("is_day", 1) and mark in ("CL", "MC"):
        mark = "cl"
    print(P["hdr"](loc.get("label") or "%.2f,%.2f" % (loc["lat"], loc["lon"])) +
          D("  %s %d %s %s" % (t0.strftime("%a"), t0.day, t0.strftime("%b"),
                               t0.strftime("%H:%M"))))
    temp = round(cu["temperature_2m"])
    tc = (P["cyn"] if temp <= 32 else P["grn"] if temp <= 80 else P["yel"])
    print("  " + B(tc("%d%s" % (temp, U))) +
          D(" feels %d\u00b0" % round(cu["apparent_temperature"])) +
          "  %s %s" % (mark, name))
    wd = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"][
        int((cu.get("wind_direction_10m", 0) + 22.5) % 360 // 45)]
    print(D("  %s %d%s   RH %d%%" % (wd, round(cu.get("wind_speed_10m") or 0),
          "mph" if a.unit == "fahrenheit" else "km/h",
          round(cu.get("relative_humidity_2m") or 0))))
    n = min(24, len(h["time"]), max(1, cols - 4))
    tp = h["temperature_2m"][:n]
    pr = [x or 0 for x in h["precipitation_probability"][:n]]
    print("\n" + D("  NEXT %dH" % n) +
          D("   %d\u2013%d%s" % (round(min(tp)), round(max(tp)), U)))
    print("  " + P["yel"](spark(tp, a.ascii)))
    k = max(range(n), key=lambda i: pr[i])
    print("  " + P["cyn"](rainbar(pr, a.ascii)) +
          (D("  wet %d%% @%sh" % (pr[k], L(h["time"][k]).strftime("%H")))
           if pr[k] >= 10 else D("  dry")))
    print("\n" + D("  7 DAY"))
    lo_a = min(dy["temperature_2m_min"])
    hi_a = max(dy["temperature_2m_max"])
    sp, W = (hi_a - lo_a) or 1.0, max(6, min(12, cols - 26))
    fl, gp = ("#", ".") if a.ascii else ("\u2588", "\u00b7")
    # today's daily max spans midnight-to-midnight, so at 19:00 it reports rain
    # that already fell. Use only the hours still ahead of us.
    rest = None
    today = L(cu["time"]).date()
    vals = [p or 0 for t, p in zip(h["time"], h["precipitation_probability"])
            if t >= cu["time"] and L(t).date() == today]
    if vals:
        rest = max(vals)
    for i, ts in enumerate(dy["time"]):
        lo, hi = dy["temperature_2m_min"][i], dy["temperature_2m_max"][i]
        b0 = int((lo - lo_a) / sp * W)
        b1 = max(b0 + 1, int(round((hi - lo_a) / sp * W)))
        pp = dy["precipitation_probability_max"][i] or 0
        mark_ = ""
        if i == 0 and rest is not None and rest != pp:
            pp, mark_ = rest, "*"          # remaining hours, not the whole day
        _, g = WMO.get(int(dy["weather_code"][i] or 0), ("", "??"))
        print("  %s %s %3d\u00b0 %s %3d\u00b0 %s%s" % (
            L(ts).strftime("%a"), g, round(lo),
            P["yel"]((gp * b0 + fl * (b1 - b0)).ljust(W, gp)), round(hi),
            (P["cyn"] if pp >= 10 else D)("%3d%%" % pp), D(mark_)))
    if rest is not None and rest != (dy["precipitation_probability_max"][0] or 0):
        print(D("  * today = hours remaining"))
    foot = ("offline, cached %s ago" % age(age_s) if stale
            else kbs(wire) if wire
            else "0B, cached" if age_s < 60 else "0B, cached %s ago" % age(age_s))
    print(D("\n  " + foot))


def gather(srcs, fresh):
    import threading
    os.makedirs(CD, exist_ok=True)
    bag = {}
    end = time.time() + DEADLINE
    for i in range(0, len(srcs), MAXPAR):       # batches: 40 feeds != 40 sockets
        if time.time() >= end:
            break
        ths = []
        for s in srcs[i:i + MAXPAR]:
            t = threading.Thread(target=load, args=(s, fresh, bag), daemon=True)
            t.start()
            ths.append(t)
        for t in ths:                  # join() is the real ceiling: socket timeouts
            t.join(max(0.1, end - time.time()))   # don't bound getaddrinfo on a lossy link
    net_log(bag.pop("_net", []))
    return bag


def age(sec):
    if sec < 60:
        return "now"
    if sec < 3600:
        return "%dm" % (sec // 60)
    if sec < 86400:
        return "%dh" % (sec // 3600)
    return "%dd" % (sec // 86400)


def shutil_copy(a, b):
    import shutil
    shutil.copy2(a, b)


SRCC = ("36", "35", "32", "33", "34", "95")     # stable per-source hues


def pal(on):
    w = (lambda c: (lambda t: "\033[%sm%s\033[0m" % (c, t))) if on else (lambda c: (lambda t: t))
    return {"d": w("2"), "b": w("1"), "red": w("31"), "grn": w("32"), "yel": w("33"),
            "cyn": w("36"), "hdr": w("1;36"), "n": (lambda t: t)}


def srcpaint(name, on):
    if not on:
        return lambda t: t
    return lambda t: "\033[%sm%s\033[0m" % (SRCC[sum(map(ord, name)) % len(SRCC)], t)


def agepaint(sec, P):
    if sec < 3600:
        return P["grn"]
    if sec < 86400:
        return P["n"]
    return P["d"]


def kbs(n):
    """Compact, fixed-width-ish: a phone terminal is 40 columns."""
    if n < 1024:
        return "%dB" % n
    if n < 1024 * 1024:
        return "%.1fK" % (n / 1024.0)
    return "%.1fM" % (n / 1048576.0)


def wrapout(text, P, cols, indent="  "):
    """Footers carry variable-length source lists; wrap instead of overflowing."""
    import textwrap
    for ln in textwrap.wrap(text, max(20, cols - 2), initial_indent=indent,
                            subsequent_indent=indent + "  ") or [indent]:
        print(P["d"](ln))


def cols_():
    try:                               # COLUMNS wins: os.get_terminal_size ignores it
        return max(20, min(int(os.environ["COLUMNS"]), 200))
    except Exception:
        pass
    try:
        return min(os.get_terminal_size().columns, 100)
    except Exception:
        return 46


def jwrite(path, obj):
    """Never let a full disk or a read-only home take the whole command down."""
    tmp = "%s.tmp%d" % (path, os.getpid())
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(obj, f, separators=(",", ":"))
        os.replace(tmp, path)          # atomic: a second terminal sees old or new
        return True
    except Exception:
        try:
            os.remove(tmp)
        except Exception:
            pass
        return False


def jread(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            v = json.load(f)
        return v if isinstance(v, type(default)) else default
    except Exception:
        return default


def kb(n):
    return "%dB" % n if n < 1024 else "%.1fKB" % (n / 1024.0)


def bul_(a):
    return "-" if a.ascii else "\u00b7"


def key(t):
    k = re.sub(r"[^a-z0-9]", "", (t or "").lower())[:60]
    if len(k) < 6:          # CJK, Cyrillic, Greek etc. reduce to nothing
        import hashlib
        k = "h" + hashlib.sha1((t or "").encode("utf-8")).hexdigest()[:16]
    return k


def sources(a):
    os.makedirs(CFD, exist_ok=True)
    if not os.path.exists(CFG):
        jwrite(CFG, DEFAULTS)
    try:
        s = json.load(open(CFG, encoding="utf-8"))
    except Exception:
        s = DEFAULTS
    if not isinstance(s, list):
        s = DEFAULTS
    ok, seen = [], set()
    for x in s:
        if not isinstance(x, dict) or not x.get("url"):
            continue
        u_ = str(x["url"]).strip().lower()
        if not (u_.startswith("http://") or u_.startswith("https://")):
            continue                      # no file://, no ftp:// from a config file
        i = re.sub(r"[^A-Za-z0-9_-]", "", str(x.get("id") or ""))[:24]
        if not i or i in seen:            # ids index cache files: no dupes, no ../
            continue
        seen.add(i)
        x["id"] = i
        x["name"] = str(x.get("name") or i)[:32]
        x.setdefault("kind", "rss")
        try:
            x["ttl"] = max(0, min(int(x.get("ttl") or TTL), 604800))
        except Exception:
            x["ttl"] = TTL
        c = x.get("cats")
        x["cats"] = [str(z) for z in c] if isinstance(c, list) and c else ["top"]
        ok.append(x)
    s = ok or DEFAULTS
    if a.only:
        want = {y.strip().lower() for y in a.only.split(",")}
        s = [x for x in s if x["id"].lower() in want]
        if not s:
            sys.exit("news: no source id matches %r (try: news -l)" % a.only)
        return s
    c = (a.cat or "top").lower()
    if c == "all":
        return s
    sel = [x for x in s if c in [z.lower() for z in x["cats"]]]
    if not sel:
        cats = sorted({z for x in s for z in x["cats"]})
        sys.exit("news: no category %r. try: %s, all" % (c, ", ".join(cats)))
    return sel


BOOLF = {"-f": "fresh", "--fresh": "fresh", "--offline": "offline",
         "-C": "celsius", "--celsius": "celsius",
         "--light": "light", "--cost": "cost", "-t": "titles", "--titles": "titles",
         "-u": "unread", "--unread": "unread", "--ascii": "ascii",
         "--check": "check", "-l": "list", "--list": "list",
         "--mark-all": "mark_all"}
VALF = {"-c": ("coords", str), "--coords": ("coords", str),
        "--label": ("label", str), "-n": ("n", int), "-s": ("only", str), "--only": ("only", str),
        "-o": ("open", int), "--open": ("open", int), "-r": ("read", int),
        "--read": ("read", int), "-S": ("star", int), "--star": ("star", int),
        "-q": ("query", str), "--query": ("query", str),
        "-d": ("download", str), "--download": ("download", str),
        "--budget": ("budget", int)}
DEFAULTS_NS = {"coords": None, "label": None, "celsius": False,
               "offline": False, "light": False, "cost": False,
               "cat": None, "check": False, "fresh": False, "n": 5, "only": None,
               "titles": False, "open": None, "read": None, "star": None,
               "unread": False, "query": None, "download": None, "budget": None,
               "mark_all": False, "update": None, "list": False, "ascii": False,
               "color": True}


def fastparse(argv):
    """argparse costs ~7.6ms of a ~34ms run. Handle the common shapes without it
    and defer to argparse for anything unfamiliar, so behaviour cannot diverge."""
    ns = dict(DEFAULTS_NS)
    i, n = 0, len(argv)
    while i < n:
        t = argv[i]
        if t in BOOLF:
            ns[BOOLF[t]] = True
        elif t == "--no-color":
            ns["color"] = False
        elif t in VALF:
            if i + 1 >= n:
                return None
            key, cast = VALF[t]
            try:
                ns[key] = cast(argv[i + 1])
            except ValueError:
                return None
            i += 1
        elif t in ("--version", "-V"):
            sys.stdout.write("lowpingnews %s\n" % VERSION)
            raise SystemExit(0)
        elif t.startswith("-") and t != "-":
            return None                   # --help, --update, typos
        elif ns["cat"] is None:
            ns["cat"] = t
        else:
            return None                   # two positionals: let argparse complain
        i += 1
    return argparse_ns(ns)


class argparse_ns(object):
    def __init__(self, d):
        self.__dict__.update(d)

    def __getattr__(self, k):             # tolerate keys the caller did not set
        if k in DEFAULTS_NS:
            return DEFAULTS_NS[k]
        raise AttributeError(k)


def main():
    try:
        import signal
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except Exception:
        pass
    a = fastparse(sys.argv[1:])
    if a is not None:
        return run(a)
    import argparse
    p = argparse.ArgumentParser(prog="lowpingnews",
                                description="ultra-light headlines and weather")
    p.add_argument("cat", nargs="?", metavar="CATEGORY",
                   help="top, world, science, tech, bio, all, signal, weather")
    p.add_argument("--check", action="store_true", help="test every feed URL")
    p.add_argument("-c", "--coords", metavar="LAT,LON", help="pin weather location")
    p.add_argument("--label", help="name for the pinned location")
    p.add_argument("-C", "--celsius", action="store_true", help="weather in celsius")
    p.add_argument("--offline", action="store_true", help="cache only, open no sockets")
    p.add_argument("--light", action="store_true",
                   help="skip feeds that last cost over 30KB")
    p.add_argument("--cost", action="store_true",
                   help="estimate a refresh from known sizes, fetch nothing")
    p.add_argument("-f", "--fresh", action="store_true", help="bypass 15m cache")
    p.add_argument("-n", type=int, default=5, metavar="N", help="items per source")
    p.add_argument("-s", "--only", metavar="IDS", help="only these source ids")
    p.add_argument("-t", "--titles", action="store_true", help="no summaries")
    p.add_argument("-o", "--open", type=int, metavar="N", help="open item N in browser")
    p.add_argument("-r", "--read", type=int, metavar="N", help="read item N as text")
    p.add_argument("-d", "--download", metavar="LIST",
                   help="save article bodies offline: 1,3,5 or all")
    p.add_argument("--budget", type=int, metavar="KB",
                   help="ceiling for one -d run (default %d)" % (DLBUDGET // 1024))
    p.add_argument("-S", "--star", type=int, metavar="N", help="save/unsave item N")
    p.add_argument("-u", "--unread", action="store_true", help="hide items already read")
    p.add_argument("-q", "--query", metavar="TERM", help="search cached headlines")
    p.add_argument("--mark-all", action="store_true", help="mark everything read")
    p.add_argument("--update", nargs="?", const="", metavar="URL",
                   help="replace this script with the latest from URL")
    p.add_argument("--version", action="version",
                   version="lowpingnews " + VERSION)
    p.add_argument("-l", "--list", action="store_true", help="list sources")
    p.add_argument("--ascii", action="store_true")
    p.add_argument("--no-color", dest="color", action="store_false")
    a = p.parse_args()
    return run(a)


def run(a):
    a.unit = "celsius" if getattr(a, "celsius", False) else "fahrenheit"
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        a.color = False
    enc = (getattr(sys.stdout, "encoding", None) or "ascii").lower()
    if "utf" not in enc:
        a.ascii = True                    # LANG=C: box glyphs would raise mid-line
    try:
        sys.stdout.reconfigure(errors="replace")
    except Exception:
        pass
    a.n = max(1, min(50, a.n))
    acts = [x for x in (a.open, a.read, a.star) if x is not None]
    if len(acts) > 1:
        sys.exit("news: pick one of -o / -r / -S at a time")
    P = pal(a.color)
    D, B, C = P["d"], P["b"], P["cyn"]

    if a.update is not None:
        url = a.update or os.environ.get("NEWS_UPDATE_URL", "")
        uf = CFD + "/update.url"
        if not url and os.path.exists(uf):
            url = open(uf, encoding="utf-8").read().strip()
        if not url:
            sys.exit("news: no update URL. Set one once:\n"
                     "  news --update https://.../news")
        me = os.path.realpath(sys.argv[0])
        if not os.access(me, os.W_OK):
            sys.exit("news: %s is not writable" % me)
        try:
            raw, _, wire = get(url, 30, cap=PAGECAP)
        except Exception as e:
            sys.exit("news: download failed - %s" % str(e)[:70])
        txt = raw.decode("utf-8", "replace")
        # verify before overwriting ourselves: truncated downloads are the
        # normal failure mode on a lossy link, and a half-file still "installs"
        if len(raw) < 8000 or "ultra-light headlines" not in txt:
            sys.exit("news: that does not look like news (%s) - not installing" % kb(len(raw)))
        try:
            import ast
            ast.parse(txt)
        except SyntaxError as e:
            sys.exit("news: downloaded file does not parse (line %s) - not installing"
                     % e.lineno)
        new = "?"
        for ln in txt.splitlines()[:40]:
            if ln.startswith("VERSION = "):
                new = ln.split("=", 1)[1].strip().strip('"\'')
        lines = txt.splitlines(True)
        if lines and lines[0].startswith("#!"):
            lines[0] = "#!%s\n" % (sys.executable or "/usr/bin/env python3")
        tmp = me + ".new"
        open(tmp, "w", encoding="utf-8").write("".join(lines))
        os.chmod(tmp, 0o755)
        try:
            shutil_copy(me, me + ".bak")
        except Exception:
            pass
        os.replace(tmp, me)                      # atomic: never a half-written news
        print(D("  updated %s -> %s %s %s %s backup at %s.bak"
                % (VERSION, new, bul_(a), kb(wire), bul_(a),
                   os.path.basename(me))))
        if not os.path.exists(uf) or open(uf, encoding="utf-8").read().strip() != url:
            os.makedirs(CFD, exist_ok=True)
            open(uf, "w", encoding="utf-8").write(url + "\n")
        return

    if a.list:
        allsrc = sources(argparse_ns({"only": None, "cat": "all"}))
        print(D("  categories: " +
                ", ".join(sorted({z for x in allsrc for z in x["cats"]})) + ", all"))
        w = cols_()
        for x in allsrc:
            cats = ",".join(x["cats"])
            if w >= 72:
                print("  %-7s %-14s %-20s %s" % (x["id"], x["name"][:14], cats[:20],
                                                 D(x["url"][:w - 46])))
            else:
                print("  %s %s %s" % (C("%-7s" % x["id"]), x["name"][:w - 22],
                                      D(cats[:12])))
                print(D("          " + x["url"][:max(10, w - 11)]))
        print(D("\n  edit: %s" % CFG))
        return

    pick = a.open or a.read or a.star
    if pick is not None:
        try:
            last = json.load(open(LAST, encoding="utf-8"))
        except Exception:
            sys.exit("news: nothing listed yet - run `news` first")
        if not 1 <= pick <= len(last):
            sys.exit("news: pick 1-%d" % len(last))
        it = last[pick - 1]
        st = state()
        if a.star:
            k = key(it["ti"])
            keep = [x for x in st["star"] if key(x["ti"]) != k]
            on = len(keep) == len(st["star"])
            st["star"] = (keep + ([it] if on else []))[-STARCAP:]
            state(st)
            print(D("  %s %s" % ("saved" if on else "unsaved", it["ti"][:50])))
            return
        if key(it["ti"]) not in st["read"]:
            st["read"].append(key(it["ti"]))
            state(st)
        if a.open:
            import shutil, subprocess
            if shutil.which("termux-open-url"):
                subprocess.run(["termux-open-url", it["u"]])
            else:
                print(it["u"])
            return
        # -r: feed body first (already paid for), network only as fallback
        try:
            cols = min(os.get_terminal_size().columns, 100)
        except Exception:
            cols = 46
        try:
            body, nb, how = fetch_article(it)
        except Exception as e:
            sys.exit("news: fetch failed - %s" % str(e)[:60])
        if how == "nolink":
            sys.exit("news: no link and no text in feed")
        import textwrap
        Pr = pal(a.color)
        for ln in textwrap.wrap(it["ti"], max(20, cols - 2)) or [""]:
            print(Pr["b"](ln))
        print(Pr["d"]("  %s %s %s" % (
            it.get("src", "?"), bul_(a), age(int(time.time()) - it["d"])
            if it.get("d") else "?")) + "\n")
        for para in (body or "").split("\n\n"):
            print(textwrap.fill(para, max(20, cols - 2), initial_indent="  ",
                                subsequent_indent="  ") + "\n")
        if not body:
            print(D("  no readable paragraphs - likely paywalled or JS-rendered"))
        print(D("  %s" % ({"feed": "from feed, 0B over the wire",
                           "offline": "from offline store, 0B over the wire"}
                          .get(how, "fetched %s, stored offline" % kb(nb)))))
        return

    if a.download:
        try:
            last = json.load(open(LAST, encoding="utf-8"))
        except Exception:
            sys.exit("news: nothing listed yet - run `news` first")
        if a.download.strip().lower() == "all":
            want = list(range(1, len(last) + 1))
        else:
            try:
                want = [int(x) for x in a.download.replace(" ", "").split(",") if x]
            except ValueError:
                sys.exit("news: -d takes 1,3,5 or all")
        cap_ = (a.budget * 1024) if a.budget else DLBUDGET
        tot, got, free = 0, 0, 0
        for i in want:
            if not 1 <= i <= len(last):
                print(D("  %2d skipped - out of range" % i))
                continue
            it = last[i - 1]
            if tot >= cap_ and not (it.get("c") or have(key(it["ti"]))):
                print(D("  stopped before %d - budget %s spent (--budget KB to raise)"
                        % (i, kbs(tot))))
                break                       # check before spending, so counts stay true
            try:
                txt, nb, how = fetch_article(it)
            except Exception as e:
                print(D("  %2d failed   %s" % (i, str(e)[:40])))
                continue
            tot += nb
            if how in ("feed", "offline"):
                free += 1
            if txt:
                got += 1
            Pd = pal(a.color)
            tag_ = (Pd["grn"]("%-6s" % "free") if not nb
                    else (Pd["yel"] if nb < 102400 else Pd["red"])("%-6s" % kbs(nb)))
            print("  %s %s %s %s" % (Pd["d"]("%2d" % i), tag_,
                                     Pd["d"]("%-7s" % how),
                                     it["ti"][:max(10, cols_() - 21)]))
        print()
        wrapout("%d/%d stored %s %s over the wire%s"
                % (got, len(want), bul_(a), kbs(tot),
                   "" if not free else " %s %d already had text" % (bul_(a), free)),
                pal(a.color), cols_())
        return

    if a.mark_all:
        st = state()
        try:
            last = json.load(open(LAST, encoding="utf-8"))
        except Exception:
            last = []
        for it in last:
            if key(it["ti"]) not in st["read"]:
                st["read"].append(key(it["ti"]))
        state(st)
        print(D("  marked %d read" % len(last)))
        return

    st = state()
    rd = set(st["read"])

    if a.query or (a.cat or "").lower() == "saved":
        rows = []
        if a.query:
            q = a.query.lower()
            for x in sources(argparse_ns({"only": None, "cat": "all"})):
                try:
                    c = json.load(open("%s/%s.json" % (CD, x["id"]), encoding="utf-8"))
                except Exception:
                    continue
                for it in c.get("items", []):
                    if q in it["ti"].lower() or q in (it.get("s") or "").lower():
                        rows.append((x["name"], it))
        else:
            rows = [(it.get("src", "saved"), it) for it in reversed(st["star"])]
        show(a, rows, rd, "search: %s" % a.query if a.query else "saved",
             "%s no network" % bul_(a))
        return

    if (a.cat or "").lower() == "weather":
        loc = wx_locate(a)
        d, wire, age_s, stale = wx_fetch(loc, a.unit, a.fresh)
        wx_show(a, P, loc, d, wire, age_s, stale)
        return

    if (a.cat or "").lower() == "signal":
        st_ = net_stats()
        print(P["hdr"]("SIGNAL"))
        for kind, dbm, extra in radio():
            c = (P["grn"] if (isinstance(dbm, int) and dbm > -75)
                 else P["yel"] if (isinstance(dbm, int) and dbm > -95) else P["red"])
            print("  %-8s %s %s" % (kind, c("%s dBm" % dbm), D(str(extra))))
        # the probe needs no history: on a fresh install it is all we have
        hosts = []
        for x in sources(argparse_ns({"only": None, "cat": "all"})):
            hp = hostport(x["url"])
            if hp[0] and hp not in hosts:
                hosts.append(hp)
        for r_ in probe(hosts[:2]):
            lc = (P["grn"] if r_["loss"] == 0 else
                  P["yel"] if r_["loss"] < 50 else P["red"])
            if r_["tcp"] is None:
                print("  %-8s %s %s" % ("probe", lc("unreachable"), D(r_["host"][:22])))
                continue
            tc = (P["grn"] if r_["tcp"] < 150 else
                  P["yel"] if r_["tcp"] < 500 else P["red"])
            note = ""
            if r_["tcp"] < 2 and not r_["host"].startswith(("127.", "10.", "192.168.")):
                note = " proxied?"   # a remote SYN/ACK cannot return in under 2ms
            print("  %-8s %s %s %s%s" % (
                "probe", tc("%4dms tcp" % r_["tcp"]),
                D("%4dms dns" % (r_["dns_cold"] or 0)),
                lc("%.0f%% loss" % r_["loss"]) if r_["loss"] else D(r_["host"][:16]),
                P["yel"](note)))
        ic = icmp(hosts[0][0]) if hosts else None
        if ic:
            print("  %-8s %s" % ("icmp", D("%.0f%% loss, %sms avg"
                  % (ic["loss"], ic["avg"] if ic["avg"] else "?"))))
        if not st_:
            print(D("  measured no history - a cached run makes no requests;"
                    " try `news -f`"))
            return
        v = (P["grn"] if st_["rate"] >= 90 and st_["bps"] > 20000 else
             P["yel"] if st_["rate"] >= 60 else P["red"])
        verdict = ("good" if st_["rate"] >= 90 and st_["bps"] > 20000 else
                   "usable" if st_["rate"] >= 60 else "poor")
        print("  %-8s %s  %s" % ("measured", v(verdict),
              D("%d recent fetches" % st_["n"])))
        print("  %-8s %s ok  %s median  %s" % (
            "", v("%.0f%%" % st_["rate"]), D("%dms" % st_["ms"]),
            D("%s/s" % kbs(int(st_["bps"])) if st_["bps"] else "")))
        if st_["bps"] > 1000:
            for label, size in (("a light feed", 8 * 1024), ("Nature", 124 * 1024)):
                print(D("           %s ~ %.1fs" % (label, size / st_["bps"])))
        days = sorted(st_["day"].items())[-7:]
        if days:
            tot = sum(v_ for _, v_ in days)
            print("  %-8s %s %s" % ("data", kbs(tot),
                  D("over %d day%s" % (len(days), "" if len(days) == 1 else "s"))))
            print(D("           today %s" % kbs(st_["day"].get(
                dt.date.today().isoformat(), 0))))
        if verdict == "poor":
            print(D("  tip: news --light skips the heavy feeds"))
        return

    srcs = sources(a)
    if a.light:
        keep_ = []
        for x in srcs:
            w_ = jread("%s/%s.json" % (CD, x["id"]), {}).get("w")
            if w_ is None or w_ <= 30 * 1024:
                keep_.append(x)
        if keep_:
            skipped = len(srcs) - len(keep_)
            srcs = keep_
            if skipped:
                print(D("  --light: skipped %d heavy feed%s"
                        % (skipped, "" if skipped == 1 else "s")))
    if a.cost:
        print(P["hdr"]("COST") + D("  estimate from last known sizes, nothing fetched"))
        tot, unknown = 0, 0
        for x in srcs:
            c_ = jread("%s/%s.json" % (CD, x["id"]), {})
            w_, age_ = c_.get("w"), time.time() - (c_.get("t") or 0)
            fresh_ = age_ < (x.get("ttl") or TTL)
            if w_ is None:
                unknown += 1
                print("  %-7s %s" % (x["id"],
                      D("unknown - not fetched since v2.4")))
                continue
            due = 0 if fresh_ else w_
            tot += due
            print("  %-7s %s %s" % (x["id"],
                  (P["grn"] if not due else P["yel"] if due < 40960 else P["red"])(
                      "%7s" % (kbs(due) if due else "cached")),
                  D("last %s%s" % (kbs(w_), "" if due else ", within ttl"))))
        print(D("  ~%s if refreshed now%s"
                % (kbs(tot), ", %d unknown" % unknown if unknown else "")))
        return
    if a.check:
        for x in srcs:
            t0 = time.time()
            try:
                raw, rh_, wire = get(x["url"], 12)
                n = len(parse_hn(raw) if x["kind"] == "hn" else parse_feed(raw))
                val = "v" if (rh_.get("ETag") or rh_.get("Last-Modified")) else "-"
                cost = P["grn"] if wire < 20480 else P["yel"] if wire < 81920 else P["red"]
                print("  %-6s %s %3di %s %s %s %4.1fs" % (
                    x["id"][:6], P["grn"]("ok ") if n else P["yel"]("nil"), n,
                    cost("%6s" % kbs(wire)), P["d"]("%6s" % kbs(len(raw))),
                    (P["grn"] if val == "v" else P["yel"])(val),
                    time.time() - t0))
            except Exception as e:
                print("  %-6s %s %s" % (x["id"][:6], P["red"]("err"),
                                        P["d"](str(e)[:max(10, cols_() - 14)])))
        return
    if a.offline:
        bag = {}
        for x in srcs:
            c_ = jread("%s/%s.json" % (CD, x["id"]), {})
            if c_.get("items"):
                bag[x["id"]] = (c_["items"], 0, int(time.time() - (c_.get("t") or 0)), 0)
            else:
                bag[x["id"]] = ([], 0, -1, 0)
    else:
        bag = gather(srcs, a.fresh)
    try:
        cols = os.get_terminal_size().columns
    except Exception:
        cols = 46
    if cols < 24:
        cols = 46
    cols = min(cols, 100)

    rows, seen, down, stale, bytes_, nm = [], set(), [], 0, 0, 0
    for x in srcs:
        items, nb, sta, unch = bag.get(x["id"], ([], 0, -1, 0))
        bytes_ += nb
        nm += unch
        if sta == -1:
            down.append(x["name"])
            continue
        stale = max(stale, sta)
        for it in sorted(items, key=lambda z: -(z.get("d") or 0))[:a.n]:
            k = key(it["ti"])
            if k in seen:
                continue
            seen.add(k)
            rows.append((x["name"], it))
    rows.sort(key=lambda r: -(r[1].get("d") or 0))
    foot = "%s %s" % (bul_(a), kb(bytes_) if bytes_ else "0B, cached")
    if nm:
        foot += " %s %d unchanged (304)" % (bul_(a), nm)
    if stale:
        foot += " %s stale %s" % (bul_(a), age(stale))
    if down:
        foot += " %s down: %s" % (bul_(a), ", ".join(down))
    show(a, rows, rd, (a.cat or "top").lower() if not a.only else a.only, foot)


def show(a, rows, rd, tag, foot):
    import textwrap
    P = pal(a.color)
    D, B = P["d"], P["b"]
    bul = bul_(a)
    cols = cols_()
    if a.unread:
        rows = [r for r in rows if key(r[1]["ti"]) not in rd]
    now = dt.datetime.now()
    print(P["hdr"]("NEWS") + " " + P["cyn"](tag) +
          D("   %s %d %s %s" % (now.strftime("%a"), now.day,
                                now.strftime("%b"), now.strftime("%H:%M"))))
    if not rows:
        print(D("  nothing to show " + foot))
        return
    print()
    keep, wrap = [], textwrap.TextWrapper(
        width=max(20, cols - 5), initial_indent="    ", subsequent_indent="    ")
    for i, (src, it) in enumerate(rows, 1):
        r = dict(it)
        r["src"] = src
        keep.append(r)
        secs = int(time.time()) - it["d"] if it.get("d") else -1
        stamp = age(secs) if secs >= 0 else "?"
        k = key(it["ti"])
        unread = k not in rd
        offline = bool(it.get("c") or have(k))
        mark = ""
        if unread:
            mark += P["yel"]("*" if a.ascii else "\u25cf") + " "
        if offline:
            mark += P["grn"]("+" if a.ascii else "\u2193") + " "
        print(" %s %s %s %s" % (D("%2d" % i), srcpaint(src, a.color)(src), D(bul),
                                (agepaint(secs, P) if secs >= 0 else D)(stamp)))
        body_c = B if unread else D          # read items recede
        plain = ("%s%s" % ("*" if a.ascii else "\u25cf", " ") if unread else "")
        plain += ("%s%s" % ("+" if a.ascii else "\u2193", " ") if offline else "")
        lines = textwrap.wrap(plain + it["ti"], max(16, cols - 5)) or [plain]
        for j, ln in enumerate(lines):
            if j == 0 and plain:             # recolour the marker, keep the width
                print("    " + mark + body_c(ln[len(plain):]))
            else:
                print("    " + body_c(ln))
        if not a.titles and it.get("s"):
            body = wrap.wrap(it["s"])
            if len(body) > 2:
                body = body[:2]
                body[1] = body[1][:max(4, len(body[1]) - 1)].rstrip() + (
                    "..." if a.ascii else "\u2026")
            for ln in body:
                print(D(ln))
        print()
    jwrite(LAST, keep)
    n = len(keep)
    wrapout("%d item%s %s %s news -r N to read"
            % (n, "" if n == 1 else "s", foot, bul), P, cols)
    return


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.stderr.write("\n")
        sys.exit(130)
    except BrokenPipeError:
        try:
            os.close(1)
        except OSError:
            pass
        sys.exit(0)
