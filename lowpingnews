#!/usr/bin/env sh
# lowpingnews - dev loop and updater for LowPingNews.
# Picks builds by VERSION, never by filename.
set -u

REPO="${LPN_REPO:-$HOME/LowPingNews}"
# Termux's share handler writes to ~/downloads; the browser writes to
# ~/storage/downloads. Scan both or builds silently go missing.
DLS="${LPN_DOWNLOADS:-$HOME/downloads $HOME/storage/downloads}"
# where news is installed. Termux: $PREFIX/bin. Elsewhere install.sh picks the
# first writable of ~/.local/bin, /usr/local/bin, ~/bin - so look rather than
# assume: next to this script (never the repo clone), then wherever news is.
_here="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
_repo="$(cd "$REPO" 2>/dev/null && pwd)"
if [ -n "${PREFIX:-}" ]; then
  BIN="$PREFIX/bin"
elif [ -n "$_here" ] && [ "$_here" != "$_repo" ] && [ -f "$_here/news" ]; then
  BIN="$_here"
elif _n="$(command -v news 2>/dev/null)" && head -c 3000 "$_n" 2>/dev/null | grep -q "ultra-light headlines"; then
  BIN="$(dirname "$_n")"
else
  BIN="$HOME/.local/bin"
fi
RAW="${LPN_RAW:-https://raw.githubusercontent.com/ATinyGreenCell/LowPingNews/main/news}"
PY="$(command -v python3 || command -v python || true)"

die() { printf '%s\n' "lowpingnews: $*" >&2; exit 1; }
OWNED="news README.md install.sh lowpingnews LICENSE .gitignore test.py catalog.json"
owned() { for o in $OWNED; do [ "$1" = "$o" ] && return 0; done; return 1; }
say() { printf '  %s\n' "$*"; }
[ -n "$PY" ] || die "python3 not found (pkg install python)"

# version of a candidate file, empty if it does not parse as python
ver() {
  [ -f "$1" ] || return 1
  "$PY" - "$1" <<'EOF' 2>/dev/null
import ast, re, sys
src = open(sys.argv[1], encoding="utf-8", errors="replace").read()
ast.parse(src)                       # a truncated download stops here
m = re.search(r'^VERSION\s*=\s*["\']([^"\']+)', src, re.M)
print(m.group(1) if m else "")
EOF
}

installed_ver() { ver "$BIN/news" 2>/dev/null || true; }
repo_ver()      { ver "$REPO/news" 2>/dev/null || true; }

# newest *valid* build in Downloads, by mtime, ignoring the filename entirely
newest_download() {
  best=""; best_t=0
  for d in $DLS; do
   [ -d "$d" ] || continue
   for f in "$d"/news "$d"/news-* "$d"/news.* ; do
    [ -f "$f" ] || continue
    v="$(ver "$f")" || continue
    [ -n "$v" ] || continue
    t="$("$PY" -c "import os,sys;print(int(os.path.getmtime(sys.argv[1])))" "$f")"
    [ "$t" -gt "$best_t" ] && { best="$f"; best_t="$t"; }
   done
  done
  [ -n "$best" ] && printf '%s\n' "$best"
}

cmd_status() {
  iv="$(installed_ver)"; rv="$(repo_ver)"
  say "installed  ${iv:-none}   $BIN/news"
  say "repo       ${rv:-none}   $REPO/news"
  d="$(newest_download || true)"
  if [ -n "$d" ]; then say "download   $(ver "$d")   $d"; else say "download   none"; fi
  if [ -d "$REPO/.git" ]; then
    [ "${LPN_NOFETCH:-}" = "1" ] || git -C "$REPO" fetch -q origin 2>/dev/null || true
    local_h="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo ?)"
    remote_h="$(git -C "$REPO" rev-parse --short '@{u}' 2>/dev/null || echo ?)"
    dirty=""; [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ] && dirty=" (uncommitted changes)"
    say "git        $local_h local / $remote_h remote$dirty"
  fi
  [ -n "$iv" ] && [ -n "$rv" ] && [ "$iv" != "$rv" ] && \
    say "MISMATCH   installed $iv != repo $rv - run: lowpingnews install"
  return 0
}

cmd_sync() {
  # Extract FIRST: an archive alone is a complete delivery. Requiring a loose
  # build before extracting meant a tarball-only drop could never sync.
  newest_tar=""; nv=""; nt=0
  for d in $DLS; do
    for t in "$d"/*.tar.gz; do
      [ -f "$t" ] || continue
      bad=0
      for m in $(tar tzf "$t" 2>/dev/null); do
        case "$m" in
          news|test.py|catalog.json|README.md|install.sh|lowpingnews|LICENSE|.gitignore) ;;
          */) ;;
          *) bad=1; break ;;
        esac
      done
      [ "$bad" -eq 1 ] && continue        # unrelated archive: never touch the repo
      # pick by the version inside, not by mtime: a stale archive in another
      # download directory must never outrank a newer build
      tv="$(tar xzf "$t" -O news 2>/dev/null | sed -n 's/^VERSION = "\(.*\)"/\1/p' | head -1)"
      [ -n "$tv" ] || continue
      if [ -z "$newest_tar" ] \
         || [ "$(printf '%s\n%s\n' "$nv" "$tv" | sort -V | tail -1)" = "$tv" ]; then
        newest_tar="$t"; nv="$tv"
      fi
    done
  done
  if [ -n "$newest_tar" ]; then
    # check the version BEFORE overwriting the repo: a stale tarball in
    # Downloads once overwrote good source and was then released as newer
    peek="$(mktemp -d)"
    if tar xzf "$newest_tar" -C "$peek" news 2>/dev/null; then
      tv="$(ver "$peek/news" 2>/dev/null || true)"
      cur="$(installed_ver)"
      if [ -n "$tv" ] && [ -n "$cur" ] && [ "$tv" != "$cur" ] \
         && [ "$(printf '%s\n%s\n' "$cur" "$tv" | sort -V | tail -1)" = "$cur" ] \
         && [ "${LPN_FORCE:-}" != "1" ]; then
        rm -rf "$peek"
        die "refusing: $(basename "$newest_tar") is v$tv, older than installed v$cur.
  Download the current build first, or set LPN_FORCE=1 to override."
      fi
    fi
    rm -rf "$peek"
    tar xzf "$newest_tar" -C "$REPO" || die "extract failed: $newest_tar"
    say "extracted $(basename "$newest_tar") (v$(ver "$REPO/news" 2>/dev/null || echo '?'))"
  fi

  src="$(newest_download || true)"        # a loose build wins only if it is newer
  if [ -n "$src" ]; then
    st="$("$PY" -c "import os,sys;print(int(os.path.getmtime(sys.argv[1])))" "$src")"
    if [ "$st" -gt "$nt" ]; then
      say "using $src (v$(ver "$src"))"
      cp "$src" "$REPO/news" || die "copy into $REPO failed"
    else
      say "archive is newer than $src - keeping the archive build"
    fi
  fi
  [ -n "$newest_tar" ] || [ -n "$src" ] || die "no valid build or archive found in: $DLS"
  cmd_install
}

cmd_install() {
  v="$(repo_ver)"
  [ -n "$v" ] || die "$REPO/news is missing, does not parse, or has no VERSION"
  mkdir -p "$BIN"
  cp "$REPO/news" "$BIN/news.new" || die "cannot write $BIN"
  chmod +x "$BIN/news.new"
  set_shebang "$BIN/news.new"
  mv "$BIN/news.new" "$BIN/news"
  got="$(installed_ver)"
  [ "$got" = "$v" ] || die "installed $got but repo says $v"
  say "installed v$v"
  # Install the dev tool too. rename() is safe even while this very script is
  # executing: the kernel keeps the old inode open until we exit. Copying onto
  # the live path instead would corrupt the remaining lines mid-run.
  if [ -f "$REPO/lowpingnews" ] && ! cmp -s "$REPO/lowpingnews" "$BIN/lowpingnews"; then
    sh -n "$REPO/lowpingnews" || die "repo lowpingnews has a syntax error - not installing"
    cp "$REPO/lowpingnews" "$BIN/lowpingnews.new" || die "cannot write $BIN"
    chmod +x "$BIN/lowpingnews.new"
    mv "$BIN/lowpingnews.new" "$BIN/lowpingnews"
    ln -sf "$BIN/lowpingnews" "$BIN/lpn"
    say "installed lowpingnews (takes effect next invocation)"
  fi
  install_launchers
  check_shadows
}

LAUNCH_MARK="# lowpingnews launcher - written by lpn install, safe to delete"

install_launchers() {
  # `weather` runs the LowPingNews forecast. Created if absent, refreshed if it
  # is ours (it carries LAUNCH_MARK), and never written over if it is anyone
  # else's - an older weather script is the user's to keep or move.
  w="$BIN/weather"
  sh_="$(command -v sh || echo /bin/sh)"
  want="$(printf '#!%s\n%s\nexec "%s" weather "$@"\n' "$sh_" "$LAUNCH_MARK" "$BIN/news")"
  if [ -e "$w" ] || [ -L "$w" ]; then
    if [ -L "$w" ] || ! grep -qF "$LAUNCH_MARK" "$w" 2>/dev/null; then
      say "kept your own $w - it is not ours, so \`weather\` still runs it"
      say "  move it aside to use the LowPingNews forecast:  mkdir -p ~/old-applets && mv $w ~/old-applets/"
      return 0
    fi
    [ "$(cat "$w")" = "$want" ] && return 0
  fi
  printf '%s\n' "$want" > "$w.new" && chmod +x "$w.new" && mv "$w.new" "$w" \
    && say "installed launcher: weather -> lowpingnews weather" \
    || { rm -f "$w.new"; say "WARN: could not write $w"; }
}

check_shadows() {
  # Read-only. A script earlier in PATH, or an alias or function in a shell
  # startup file, wins over what was just installed - and says nothing.
  for c in news weather; do
    first="$(command -v "$c" 2>/dev/null || true)"
    case "$first" in
      ""|"$BIN/$c") ;;
      *) say "note: \`$c\` runs $first, which comes before $BIN in your PATH"
         say "  move it aside to get LowPingNews:  mkdir -p ~/old-applets && mv $first ~/old-applets/" ;;
    esac
    for rc in "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile" "$HOME/.zshrc"; do
      [ -f "$rc" ] || continue
      grep -nE "^[[:space:]]*(alias[[:space:]]+$c=|(function[[:space:]]+)?$c[[:space:]]*\(\))" "$rc" 2>/dev/null \
        | grep -v -e lowpingnews -e 'lpn' | head -2 | while IFS=: read -r ln _rest; do
          say "note: $rc line $ln redefines \`$c\` in your shell, hiding LowPingNews"
          say "  delete that line, then run: unalias $c 2>/dev/null; hash -r"
        done
    done
  done
}

ensure_catalog() {
  # The published feed index. If the repo has none yet - the first release that
  # carries one, or a tarball from a sync too old to accept the file - write it
  # from the copy built into news. An existing catalog.json is never replaced:
  # it may hold check results (`catalog check all --write catalog.json`).
  [ -f "$REPO/catalog.json" ] && return 0
  [ -f "$REPO/news" ] || return 0
  "$PY" "$REPO/news" catalog export > "$REPO/catalog.json.new" \
    && [ -s "$REPO/catalog.json.new" ] \
    && mv "$REPO/catalog.json.new" "$REPO/catalog.json" \
    && say "wrote catalog.json from the built-in index" \
    || { rm -f "$REPO/catalog.json.new"; die "could not write catalog.json"; }
}

cmd_test() {
  ensure_catalog                  # tests check exactly what release publishes
  # the suite exercises the source tree, so it runs before any install check
  if [ -f "$REPO/test.py" ]; then
    python3 "$REPO/test.py" ${1:+"$1"} || die "test suite failed"
  fi
  v="$(installed_ver)"; [ -n "$v" ] || { say "not installed; suite only"; return 0; }
  say "v$v"
  news --version >/dev/null || die "--version failed"
  news -t -n 2 >/dev/null 2>&1 || say "WARN: listing failed (offline is fine)"
  news -l >/dev/null || die "-l failed"
  news -q zzzznomatch >/dev/null || die "-q failed"
  news --ascii -t -n 1 >/dev/null || die "--ascii failed"
  LANG=C LC_ALL=C PYTHONIOENCODING=ascii news -t -n 1 >/dev/null 2>&1 \
    || die "non-UTF8 terminal path failed"
  say "smoke test passed"
}

cmd_ship() {
  [ -d "$REPO/.git" ] || die "$REPO is not a git repo"
  [ $# -ge 1 ] || die "usage: lowpingnews ship \"commit message\""
  cmd_install
  stray=""
  for f in $(git -C "$REPO" status --porcelain | awk '{print $NF}'); do
    owned "${f%%/*}" || stray="$stray $f"
  done
  [ -n "$stray" ] && die "refusing to commit files this project does not own:$stray
  remove them, or add to OWNED if they belong here"
  git -C "$REPO" add -A
  git -C "$REPO" diff --cached --quiet && { say "nothing to commit"; return 0; }
  git -C "$REPO" commit -q -m "$*" || die "commit failed"
  git -C "$REPO" push -q 2>/dev/null || die "push failed"
  say "pushed $(git -C "$REPO" rev-parse --short HEAD)"
}

release_has_changes() {
  # the failure this prevents: a stale build synced, version bumped, released.
  # Compare against the last tag ignoring the VERSION line itself.
  last="$(git -C "$REPO" describe --tags --abbrev=0 2>/dev/null || true)"
  [ -n "$last" ] || return 0
  git -C "$REPO" show "$last:news" 2>/dev/null \
    | grep -v '^VERSION = ' > "$REPO/.rel_old" || return 0
  grep -v '^VERSION = ' "$REPO/news" > "$REPO/.rel_new"
  if cmp -s "$REPO/.rel_old" "$REPO/.rel_new"; then
    rm -f "$REPO/.rel_old" "$REPO/.rel_new"
    # news is unchanged, but any other file the project owns may not be:
    # check results in catalog.json, a fix to this tool, the tests, the docs.
    # Each of those is a real release; only a bare VERSION bump is not.
    for f in $OWNED; do
      [ "$f" = news ] && continue
      [ -f "$REPO/$f" ] || continue
      git -C "$REPO" show "$last:$f" 2>/dev/null | cmp -s - "$REPO/$f" || return 0
    done
    return 1
  fi
  rm -f "$REPO/.rel_old" "$REPO/.rel_new"
  return 0
}

cmd_release() {
  [ $# -ge 1 ] || die "usage: lowpingnews release <version>"
  v="$1"
  if ! release_has_changes; then
    die "refusing: news is identical to the last release apart from VERSION.
  A stale tarball was probably synced. Download the current build and re-sync."
  fi
  case "$v" in
    *[!0-9.]*|""|.*|*.) die "version must be digits and dots, e.g. 2.1" ;;
  esac
  cur="$(repo_ver)"
  [ "$cur" = "$v" ] || {
    set_version "$REPO/news" "$v" || die "version bump failed"
    say "bumped $cur -> $v"
  }
  cmd_install
  cmd_test
  stray=""
  for f in $(git -C "$REPO" status --porcelain | awk '{print $NF}'); do
    owned "${f%%/*}" || stray="$stray $f"
  done
  [ -n "$stray" ] && die "refusing to release with untracked foreign files:$stray"
  git -C "$REPO" add -A
  git -C "$REPO" diff --cached --quiet || git -C "$REPO" commit -q -m "v$v" || die "commit failed"
  git -C "$REPO" push -q 2>/dev/null || die "push failed"
  # Idempotent: a half-finished release must not wedge the next attempt.
  if git -C "$REPO" rev-parse -q --verify "refs/tags/v$v" >/dev/null; then
    at="$(git -C "$REPO" rev-list -n1 "v$v")"
    head="$(git -C "$REPO" rev-parse HEAD)"
    if [ "$at" = "$head" ]; then
      say "tag v$v already points at HEAD"
    else
      say "tag v$v points at an older commit - moving it to HEAD"
      git -C "$REPO" tag -d "v$v" >/dev/null
      git -C "$REPO" tag -a "v$v" -m "LowPingNews v$v" || die "retag failed"
      git -C "$REPO" push -q --force origin "v$v" 2>/dev/null || die "tag push failed"
    fi
  else
    git -C "$REPO" tag -a "v$v" -m "LowPingNews v$v" || die "tag failed"
    git -C "$REPO" push -q origin "v$v" 2>/dev/null || die "tag push failed"
  fi
  if command -v gh >/dev/null 2>&1; then
    gh_repo="$(git -C "$REPO" remote get-url origin | sed 's|.*github.com[:/]||;s|\.git$||')"
    gh_note="Terminal news reader and weather for bad connections. Single file, stdlib only."
    if gh release create "v$v" --title "LowPingNews v$v" --notes "$gh_note" \
         --repo "$gh_repo" >/dev/null 2>&1; then
      say "release v$v created"
    elif gh release edit "v$v" --title "LowPingNews v$v" --notes "$gh_note" \
         --repo "$gh_repo" >/dev/null 2>&1; then
      say "release v$v updated"          # 422 on create just means it existed
    else
      say "WARN: gh release failed (tag is pushed; create it on the web)"
    fi
  else
    say "gh not installed - tag pushed, create the release on the web"
  fi
  say "released v$v"
}

set_shebang() {   # portable: sed -i takes different arguments on GNU and BSD (macOS)
  "$PY" - "$1" "$PY" <<'EOF'
import sys
p, py = sys.argv[1:3]
b = open(p, "rb").read()
if b.startswith(b"#!"):
    open(p, "wb").write(("#!" + py).encode() + b[b.find(b"\n"):])
EOF
}

set_version() {
  "$PY" - "$1" "$2" <<'EOF'
import re, sys
p, v = sys.argv[1:3]
s = open(p, encoding="utf-8").read()
n = re.sub(r'^VERSION = .*$', 'VERSION = "%s"' % v, s, count=1, flags=re.M)
if n == s and ('VERSION = "%s"' % v) not in s:
    raise SystemExit(1)
open(p, "w", encoding="utf-8", newline="\n").write(n)
EOF
}

fetch_to() {   # fetch_to URL FILE: portable, and refuses a cut-short download
  "$PY" - "$1" "$2" <<'EOF'
import sys, urllib.request
r = urllib.request.Request(sys.argv[1], headers={"User-Agent": "lowpingnews"})
f = urllib.request.urlopen(r, timeout=60)
data = f.read()
if f.length not in (None, 0):
    raise SystemExit("cut short")
n = f.headers.get("Content-Length")
if n and n.isdigit() and int(n) != len(data):
    raise SystemExit("cut short")
open(sys.argv[2], "wb").write(data)
EOF
}

cmd_update() {
  if [ -x "$BIN/news" ] && "$BIN/news" --help 2>&1 | grep -q -- --update; then
    "$BIN/news" --update "$RAW" || return 1
  else                                  # bootstrap: no news yet, or too old to self-update
    tmp="$(mktemp)"
    fetch_to "$RAW" "$tmp" || { rm -f "$tmp"; die "download failed - nothing changed"; }
    v="$(ver "$tmp")" || { rm -f "$tmp"; die "downloaded file does not parse - nothing changed"; }
    mkdir -p "$BIN"
    # the interpreter line in python: sed -i differs between GNU and BSD (macOS)
    "$PY" - "$tmp" "$BIN/news.new" "$PY" <<'EOF' || { rm -f "$tmp"; die "could not write $BIN"; }
import sys
src, dst, py = sys.argv[1:4]
b = open(src, "rb").read()
if b.startswith(b"#!"):
    b = ("#!" + py).encode() + b[b.find(b"\n"):]
open(dst, "wb").write(b)
EOF
    chmod +x "$BIN/news.new" && mv "$BIN/news.new" "$BIN/news"; rm -f "$tmp"
    say "installed v$v from $RAW"
  fi
  update_self
}

update_self() {
  # news updates itself; this command did not, so an early install kept an
  # early lowpingnews forever. Swap by rename: safe while this script runs.
  [ -f "$BIN/lowpingnews" ] || return 0
  tmp="$(mktemp)"
  if ! fetch_to "${RAW%/news}/lowpingnews" "$tmp" 2>/dev/null; then
    rm -f "$tmp"; say "(lowpingnews itself not checked: download failed)"; return 0
  fi
  if ! grep -q "lowpingnews - dev loop" "$tmp" || ! sh -n "$tmp" 2>/dev/null; then
    rm -f "$tmp"; say "(lowpingnews itself not updated: the download did not check out)"; return 0
  fi
  if cmp -s "$tmp" "$BIN/lowpingnews"; then rm -f "$tmp"; return 0; fi
  cp "$tmp" "$BIN/lowpingnews.new" && chmod +x "$BIN/lowpingnews.new" \
    && mv "$BIN/lowpingnews.new" "$BIN/lowpingnews" && say "updated the lowpingnews command"
  rm -f "$tmp"
}

cmd_pull() {
  [ -d "$REPO/.git" ] || die "$REPO is not a git repo"
  git -C "$REPO" pull --ff-only || die "pull failed"
  cmd_install
}

cmd_clean() {
  n=0
  for d in $DLS; do
    for f in "$d"/news "$d"/news-* "$d"/news.* "$d"/lowpingnews-*.tar.gz; do
      [ -f "$f" ] && { rm -f "$f"; n=$((n + 1)); }
    done
  done
  say "removed $n stale download(s)"
}

usage() {
  cat <<'EOF'
lowpingnews - the reader, plus its dev loop

  lowpingnews              headlines (top)
  lowpingnews science      a category: top world science tech bio all
  lowpingnews weather      ultra-light forecast
  lowpingnews signal       connection quality
  lowpingnews --help       all reader flags

dev:
  update          install the latest release from GitHub
  status          installed / repo / newest download / git, and flag mismatches
  sync            newest VALID download -> repo -> install  (never picks by filename)
  install         repo -> PATH, verifying the version actually landed
  test            smoke test the installed build
  pull            git pull, then install
  ship "msg"      install, commit, push
  release <ver>   bump VERSION, install, test, commit, tag, gh release
  clean           delete stale downloads

env: LPN_REPO LPN_DOWNLOADS (space-separated dirs) LPN_RAW LPN_NOFETCH=1
EOF
}

# Dev subcommands are handled here; anything else is the reader. The two name
# spaces do not overlap (categories: top world science tech bio all signal
# weather), so dispatch is unambiguous.
c="${1:-}"
case "$c" in
  update|status|sync|install|test|pull|ship|release|clean|-h|--help|help) shift ;;
  *) exec "$BIN/news" "$@" ;;
esac
case "$c" in
  update)  cmd_update ;;
  status)  cmd_status ;;
  sync)    cmd_sync ;;
  install) cmd_install ;;
  test)    cmd_test ${1:+"$1"} ;;
  pull)    cmd_pull ;;
  ship)    cmd_ship "$@" ;;
  release) cmd_release "$@" ;;
  clean)   cmd_clean ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
